<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoBike</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col justify-between overflow-x-hidden">
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
        var currentUserName = User.Identity?.Name ?? "Người dùng";
        var currentUserEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        var currentAvatarUrl = User.FindFirst("AvatarUrl")?.Value ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100";
        var currentLicenseStatus = User.FindFirst("DriverLicenseStatus")?.Value ?? "Unverified";
    }
    <!-- Top Navbar (Thay đổi chức năng theo đúng Vai trò: Khách thuê / Chủ xe / Admin) -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-4">
                <!-- Logo Chính Thức EcoBike (Khách Hàng Chọn) -->
                <div class="flex items-center gap-3 shrink-0">
                    <a href="@(currentRole == "Admin" ? "/Admin" : (currentRole == "Host" ? "/Host" : "/"))" class="flex items-center gap-2 group">
                        <!-- Official EB Electric Bike Vector Logo -->
                        <div class="h-10 flex items-center justify-center transition-transform duration-200 group-hover:scale-105">
                            <svg class="h-9 w-auto" viewBox="0 0 520 320" fill="none" style="min-width: 58px;">
                                <!-- 1. Leaf stem & body -->
                                <path d="M 124 205 C 132 185, 126 165, 115 152" stroke="#10B981" stroke-width="12" stroke-linecap="round" fill="none" />
                                <path d="M 115 152 C 142 128, 142 75, 68 58 C 58 100, 72 136, 115 152 Z" fill="#10B981" />
                                <path d="M 110 145 C 96 118, 86 92, 74 65" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.95" />
                                <!-- 2. Rear Wheel -->
                                <circle cx="102" cy="216" r="38" fill="none" stroke="#0E1726" stroke-width="22" />
                                <path d="M 102 216 L 145 216" stroke="#0E1726" stroke-width="20" stroke-linecap="round" />
                                <!-- 3. Letter E -->
                                <path d="M 148 72 L 255 72 L 243 114 L 180 114 L 148 72 Z" fill="#0E1726" />
                                <path d="M 148 72 L 180 114 L 152 216 L 105 216 Z" fill="#0E1726" />
                                <path d="M 166 142 L 230 142 L 220 180 L 158 180 Z" fill="#0E1726" />
                                <path d="M 105 216 L 226 216 L 214 256 L 135 256 Z" fill="#0E1726" />
                                <!-- 4. Green Lightning Bolt -->
                                <polygon points="305,68 238,162 292,162 242,262 322,148 266,148" fill="#10B981" />
                                <!-- 5. Handlebar -->
                                <path d="M 365 175 L 308 45 L 268 45" stroke="#0E1726" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                                <!-- 6. Letter B -->
                                <path d="M 325 72 L 405 72 C 445 72, 465 92, 452 132 C 445 152, 428 162, 408 166 C 432 172, 442 190, 432 218 C 418 252, 388 256, 345 256 L 282 256 L 325 72 Z" fill="#0E1726" />
                                <path d="M 338 106 L 388 106 C 402 106, 410 116, 405 128 C 400 140, 390 144, 375 144 L 328 144 Z" fill="#FFFFFF" />
                                <path d="M 318 178 L 370 178 C 386 178, 395 188, 390 204 C 384 218, 370 224, 352 224 L 305 224 Z" fill="#FFFFFF" />
                            </svg>
                        </div>
                        <span class="text-xl font-black text-gray-900 tracking-tight">Eco<span class="text-emerald-600">Bike</span></span>
                    </a>

                    @if (currentRole == "Admin")
                    {
                        <span class="hidden sm:inline-block px-2.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-300 text-xs font-semibold">
                            Quản trị hệ thống
                        </span>
                    }
                    else if (currentRole == "Host")
                    {
                        <span class="hidden sm:inline-block px-2.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 text-xs font-semibold">
                            Kênh Chủ Xe
                        </span>
                    }
                </div>

                <!-- Main Menu theo từng Vai trò -->
                <nav class="hidden lg:flex items-center gap-5 text-sm font-medium text-gray-600">
                    @if (currentRole == "Admin")
                    {
                        <a href="/Admin" class="text-gray-900 hover:text-emerald-600 font-semibold transition whitespace-nowrap">
                            <i class="bi bi-speedometer2 mr-1 text-emerald-600"></i> Tổng quan sàn
                        </a>
                        <a href="/Admin#kyc" class="hover:text-emerald-600 transition whitespace-nowrap">
                            <i class="bi bi-person-vcard mr-1"></i> Duyệt GPLX
                        </a>
                        <a href="/Admin#vehicles" class="hover:text-emerald-600 transition whitespace-nowrap">
                            <i class="bi bi-bicycle mr-1"></i> Kiểm duyệt xe
                        </a>
                        <a href="/Admin#bookings" class="hover:text-emerald-600 transition whitespace-nowrap">
                            <i class="bi bi-receipt mr-1"></i> Quản lý đơn thuê
                        </a>
                        <a href="/Admin#users" class="hover:text-emerald-600 transition whitespace-nowrap">
                            <i class="bi bi-people mr-1"></i> Phân quyền User
                        </a>
                        <a href="/Vehicles" class="text-gray-500 hover:text-emerald-600 transition whitespace-nowrap border-l border-gray-200 pl-4">
                            Xem trang thuê xe
                        </a>
                    }
                    else if (currentRole == "Host")
                    {
                        <a href="/Host" class="text-gray-900 hover:text-blue-600 font-semibold transition whitespace-nowrap">
                            <i class="bi bi-grid mr-1 text-blue-600"></i> Bảng điều khiển
                        </a>
                        <a href="/Host#my-vehicles" class="hover:text-blue-600 transition whitespace-nowrap">
                            <i class="bi bi-bicycle mr-1"></i> Đội xe của tôi
                        </a>
                        <a href="/Host#incoming-bookings" class="hover:text-blue-600 transition whitespace-nowrap">
                            <i class="bi bi-inbox mr-1"></i> Đơn khách đặt
                        </a>
                        <a href="/Host/Create" class="hover:text-blue-600 transition whitespace-nowrap">
                            <i class="bi bi-plus-circle mr-1"></i> Đăng xe mới
                        </a>
                        <a href="/Vehicles" class="text-gray-500 hover:text-emerald-600 transition whitespace-nowrap border-l border-gray-200 pl-4">
                            Thuê xe (Khách)
                        </a>
                    }
                    else
                    {
                        <a href="/" class="hover:text-emerald-600 transition whitespace-nowrap">Trang chủ</a>
                        <a href="/Vehicles" class="hover:text-emerald-600 transition whitespace-nowrap">Thuê xe điện</a>
                        <a href="/Home/Stations" class="hover:text-emerald-600 transition whitespace-nowrap">Trạm sạc & Đổi pin</a>
                        @if (isAuthenticated)
                        {
                            <a href="/Bookings/MyBookings" class="hover:text-emerald-600 transition whitespace-nowrap">Chuyến của tôi</a>
                        }
                    }
                </nav>

                <!-- User Area -->
                <div class="flex items-center gap-2.5 shrink-0">
                    @if (isAuthenticated)
                    {
                        @if (currentRole == "Admin")
                        {
                            <a href="/Host/Create" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition whitespace-nowrap shadow-sm">
                                <i class="bi bi-plus-lg"></i> Thêm xe mới
                            </a>
                        }
                        else if (currentRole == "Host")
                        {
                            <a href="/Host/Create" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition whitespace-nowrap shadow-sm">
                                <i class="bi bi-plus-lg"></i> Đăng xe mới
                            </a>
                        }
                        else
                        {
                            <a href="/Host/BecomeHost" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-100 border border-gray-200 transition whitespace-nowrap">
                                <i class="bi bi-rocket-takeoff text-emerald-600"></i> Trở thành chủ xe
                            </a>
                        }

                        <!-- Modern User Avatar Dropdown Popover -->
                        <div class="relative" id="userMenuContainer">
                            <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" class="flex items-center gap-2 p-1 sm:px-2.5 sm:py-1.5 rounded-xl hover:bg-gray-100 border border-transparent hover:border-gray-200 transition focus:outline-none" aria-expanded="false" aria-haspopup="true">
                                <img src="@currentAvatarUrl" alt="@currentUserName" class="w-8 h-8 rounded-full object-cover border @(currentRole == "Admin" ? "border-slate-800 ring-2 ring-slate-200" : (currentRole == "Host" ? "border-blue-600 ring-2 ring-blue-100" : "border-emerald-600 ring-2 ring-emerald-100"))" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100';" />
                                <div class="hidden sm:flex flex-col text-left leading-tight">
                                    <span class="font-bold text-gray-800 text-xs max-w-[120px] truncate">@currentUserName</span>
                                    <span class="text-[10px] font-semibold text-gray-400">@(currentRole == "Admin" ? "Quản trị viên" : (currentRole == "Host" ? "Chủ xe" : "Khách thuê"))</span>
                                </div>
                                <i class="bi bi-chevron-down text-gray-400 text-xs ml-0.5 transition-transform duration-200" id="userMenuChevron"></i>
                            </button>

                            <!-- Popover Menu -->
                            <div id="userMenuDropdown" class="hidden absolute right-0 top-full mt-2 w-72 bg-white rounded-2xl shadow-2xl border border-gray-200 divide-y divide-gray-100 z-50 overflow-hidden transform opacity-0 scale-95 transition-all duration-150 origin-top-right">
                                <!-- User Info Header -->
                                <div class="p-3.5 bg-gradient-to-br from-gray-50 to-white">
                                    <div class="flex items-center gap-3">
                                        <img src="@currentAvatarUrl" alt="@currentUserName" class="w-10 h-10 rounded-full object-cover border border-gray-200 shadow-sm" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100';" />
                                        <div class="flex-1 min-w-0">
                                            <p class="text-xs font-bold text-gray-900 truncate">@currentUserName</p>
                                            <p class="text-[11px] text-gray-500 truncate">@currentUserEmail</p>
                                        </div>
                                    </div>
                                    
                                    <!-- Badges: Role & License Status -->
                                    <div class="flex flex-wrap items-center gap-1.5 mt-2.5">
                                        @if (currentRole == "Admin")
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-slate-900 text-white text-[10px] font-bold tracking-wide uppercase">
                                                <i class="bi bi-shield-shaded mr-0.5"></i> Admin
                                            </span>
                                        }
                                        else if (currentRole == "Host")
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-blue-600 text-white text-[10px] font-bold tracking-wide uppercase">
                                                <i class="bi bi-person-badge mr-0.5"></i> Đối tác Host
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-bold tracking-wide uppercase">
                                                <i class="bi bi-person mr-0.5"></i> Khách thuê
                                            </span>
                                        }

                                        @if (currentLicenseStatus == "Verified")
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-semibold flex items-center gap-1">
                                                <i class="bi bi-patch-check-fill text-emerald-600"></i> GPLX Đã duyệt
                                            </span>
                                        }
                                        else if (currentLicenseStatus == "Pending")
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-semibold flex items-center gap-1">
                                                <i class="bi bi-hourglass-split text-amber-600"></i> GPLX Chờ duyệt
                                            </span>
                                        }
                                        else if (currentLicenseStatus == "Rejected")
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-semibold flex items-center gap-1">
                                                <i class="bi bi-x-circle-fill text-rose-600"></i> GPLX Bị từ chối
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-600 border border-gray-200 text-[10px] font-medium flex items-center gap-1">
                                                <i class="bi bi-shield-slash text-gray-400"></i> Chưa xác thực GPLX
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Navigation Links -->
                                <div class="py-1">
                                    <a href="/Account/Profile" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
                                        <i class="bi bi-person-vcard text-emerald-600 text-sm w-4 text-center"></i>
                                        <span>Hồ sơ & Giấy phép lái xe</span>
                                    </a>
                                    <a href="/Bookings/MyBookings" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
                                        <i class="bi bi-calendar-check text-emerald-600 text-sm w-4 text-center"></i>
                                        <span>Chuyến đi của tôi</span>
                                    </a>

                                    @if (currentRole == "Admin")
                                    {
                                        <a href="/Admin" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-slate-100 hover:text-slate-900 transition">
                                            <i class="bi bi-speedometer2 text-slate-800 text-sm w-4 text-center"></i>
                                            <span>Bảng điều khiển Quản trị</span>
                                        </a>
                                        <a href="/Admin#kyc" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-slate-100 hover:text-slate-900 transition">
                                            <i class="bi bi-person-check text-slate-800 text-sm w-4 text-center"></i>
                                            <span>Kiểm duyệt GPLX A1</span>
                                        </a>
                                    }
                                    else if (currentRole == "Host")
                                    {
                                        <a href="/Host" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                                            <i class="bi bi-grid-fill text-blue-600 text-sm w-4 text-center"></i>
                                            <span>Bảng điều khiển Chủ xe</span>
                                        </a>
                                        <a href="/Host/Create" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                                            <i class="bi bi-plus-circle-fill text-blue-600 text-sm w-4 text-center"></i>
                                            <span>Đăng thêm xe mới</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Host/BecomeHost" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 transition">
                                            <i class="bi bi-stars text-emerald-600 text-sm w-4 text-center"></i>
                                            <span>Đăng ký trở thành Chủ xe</span>
                                        </a>
                                    }
                                </div>

                                <!-- Logout Action -->
                                <div class="p-1">
                                    <form action="/Account/Logout" method="post" class="m-0">
                                        <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition text-left">
                                            <i class="bi bi-box-arrow-right text-rose-600 text-sm w-4 text-center"></i>
                                            <span>Đăng xuất an toàn</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-gray-700 hover:text-emerald-600 font-medium text-sm px-3 py-2 rounded-lg hover:bg-gray-50 transition">
                            Đăng nhập
                        </a>
                        <a href="/Account/Register" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm px-4 py-2 rounded-lg transition">
                            Đăng ký
                        </a>
                    }

                    <button type="button" onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100">
                        <i class="bi bi-list text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden lg:hidden border-t border-gray-100 py-3 space-y-1 text-sm">
                @if (currentRole == "Admin")
                {
                    <a href="/Admin" class="block px-3 py-2 rounded-lg text-gray-900 font-semibold hover:bg-gray-50">Tổng quan quản trị</a>
                    <a href="/Admin#kyc" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Duyệt GPLX A1</a>
                    <a href="/Admin#vehicles" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Quản lý đội xe</a>
                    <a href="/Admin#bookings" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Quản lý đơn thuê</a>
                    <a href="/Admin#users" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Phân quyền người dùng</a>
                    <a href="/Vehicles" class="block px-3 py-2 rounded-lg text-emerald-600 hover:bg-gray-50">Xem trang thuê xe</a>
                    <a href="/Account/Profile" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Hồ sơ cá nhân & GPLX</a>
                }
                else if (currentRole == "Host")
                {
                    <a href="/Host" class="block px-3 py-2 rounded-lg text-gray-900 font-semibold hover:bg-gray-50">Bảng điều khiển Chủ xe</a>
                    <a href="/Host#my-vehicles" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Đội xe của tôi</a>
                    <a href="/Host#incoming-bookings" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Đơn khách đặt</a>
                    <a href="/Host/Create" class="block px-3 py-2 rounded-lg text-blue-600 font-medium hover:bg-gray-50">Đăng xe mới</a>
                    <a href="/Vehicles" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Thuê xe (Khách)</a>
                    <a href="/Account/Profile" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Hồ sơ cá nhân & GPLX</a>
                }
                else
                {
                    <a href="/" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Trang chủ</a>
                    <a href="/Vehicles" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Thuê xe điện</a>
                    <a href="/Home/Stations" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Trạm sạc & Đổi pin</a>
                    @if (isAuthenticated)
                    {
                        <a href="/Bookings/MyBookings" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Chuyến của tôi</a>
                        <a href="/Account/Profile" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Hồ sơ cá nhân & GPLX</a>
                    }
                }
            </div>
        </div>
    </header>

    <!-- Floating Toast Notifications (Top Right) -->
    <div id="toastContainer" class="fixed top-20 right-4 sm:right-6 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="pointer-events-auto bg-white border-l-4 border-emerald-500 rounded-xl p-4 shadow-xl flex items-start gap-3 transition-all duration-300 transform translate-x-0">
                <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <i class="bi bi-check-circle-fill text-lg"></i>
                </div>
                <div class="flex-1 pt-0.5">
                    <h5 class="text-xs font-bold text-gray-900">Thành công</h5>
                    <p class="text-xs text-gray-600 mt-0.5">@TempData["SuccessMessage"]</p>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="bi bi-x text-lg"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="pointer-events-auto bg-white border-l-4 border-rose-500 rounded-xl p-4 shadow-xl flex items-start gap-3 transition-all duration-300 transform translate-x-0">
                <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                    <i class="bi bi-exclamation-triangle-fill text-lg"></i>
                </div>
                <div class="flex-1 pt-0.5">
                    <h5 class="text-xs font-bold text-gray-900">Thông báo</h5>
                    <p class="text-xs text-gray-600 mt-0.5">@TempData["ErrorMessage"]</p>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="bi bi-x text-lg"></i>
                </button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 text-gray-600 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-sm">
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-gray-900 font-bold text-lg">
                        <svg class="h-7 w-auto" viewBox="0 0 520 320" fill="none" style="min-width: 44px;">
                            <path d="M 124 205 C 132 185, 126 165, 115 152" stroke="#10B981" stroke-width="12" stroke-linecap="round" fill="none" />
                            <path d="M 115 152 C 142 128, 142 75, 68 58 C 58 100, 72 136, 115 152 Z" fill="#10B981" />
                            <path d="M 110 145 C 96 118, 86 92, 74 65" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.95" />
                            <circle cx="102" cy="216" r="38" fill="none" stroke="#0E1726" stroke-width="22" />
                            <path d="M 102 216 L 145 216" stroke="#0E1726" stroke-width="20" stroke-linecap="round" />
