<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoBike</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col justify-between">
    <!-- Top Navbar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-4">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2.5 shrink-0">
                    <div class="w-9 h-9 rounded-lg bg-emerald-600 text-white flex items-center justify-center">
                        <i class="bi bi-bicycle text-xl"></i>
                    </div>
                    <span class="text-xl font-bold text-gray-900 tracking-tight">Eco<span class="text-emerald-600">Bike</span></span>
                </a>

                <!-- Main Menu -->
                <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-gray-600">
                    <a href="/" class="hover:text-emerald-600 transition whitespace-nowrap">Trang chủ</a>
                    <a href="/Vehicles" class="hover:text-emerald-600 transition whitespace-nowrap">Thuê xe điện</a>
                    <a href="/Home/Stations" class="hover:text-emerald-600 transition whitespace-nowrap">Trạm sạc & Đổi pin</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Bookings/MyBookings" class="hover:text-emerald-600 transition whitespace-nowrap">Chuyến của tôi</a>
                    }
                </nav>

                <!-- User Area -->
                <div class="flex items-center gap-3 shrink-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Renter";

                        @if (userRole == "Admin")
                        {
                            <a href="/Admin" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition whitespace-nowrap">
                                <i class="bi bi-gear"></i> Quản trị
                            </a>
                        }
                        else if (userRole == "Host")
                        {
                            <a href="/Host" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition whitespace-nowrap">
                                <i class="bi bi-shop"></i> Kênh chủ xe
                            </a>
                        }
                        else
                        {
                            <a href="/Host/BecomeHost" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-100 border border-gray-200 transition whitespace-nowrap">
                                Trở thành chủ xe
                            </a>
                        }

                        <a href="/Account/Profile" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-gray-100 transition text-sm">
                            <i class="bi bi-person-circle text-lg text-emerald-600"></i>
                            <span class="hidden sm:inline font-medium text-gray-800 max-w-[140px] truncate">@User.Identity.Name</span>
                        </a>

                        <form action="/Account/Logout" method="post" class="inline m-0">
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-gray-500 hover:text-red-600 hover:bg-red-50 transition" title="Đăng xuất">
                                Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-gray-700 hover:text-emerald-600 font-medium text-sm px-3 py-2 rounded-lg hover:bg-gray-50 transition">
                            Đăng nhập
                        </a>
                        <a href="/Account/Register" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm px-4 py-2 rounded-lg transition">
                            Đăng ký
                        </a>
                    }

                    <button type="button" onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100">
                        <i class="bi bi-list text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden lg:hidden border-t border-gray-100 py-3 space-y-1 text-sm">
                <a href="/" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Trang chủ</a>
                <a href="/Vehicles" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Thuê xe điện</a>
                <a href="/Home/Stations" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Trạm sạc & Đổi pin</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Bookings/MyBookings" class="block px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50">Chuyến của tôi</a>
                    @if (User.IsInRole("Host") || User.IsInRole("Admin"))
                    {
                        <a href="/Host" class="block px-3 py-2 rounded-lg text-emerald-700 font-medium">Kênh chủ xe</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin" class="block px-3 py-2 rounded-lg text-gray-800 font-medium">Quản trị hệ thống</a>
                    }
                }
            </div>
        </div>
    </header>

    <!-- Notifications -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-emerald-50 border border-emerald-200 p-3.5 rounded-lg mb-4 flex items-center text-sm text-emerald-800">
                <i class="bi bi-check-circle-fill text-emerald-600 mr-2.5"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 p-3.5 rounded-lg mb-4 flex items-center text-sm text-red-800">
                <i class="bi bi-exclamation-circle-fill text-red-600 mr-2.5"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 text-gray-600 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-sm">
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-gray-900 font-bold text-lg">
                        <div class="w-7 h-7 rounded bg-emerald-600 text-white flex items-center justify-center text-sm">
                            <i class="bi bi-bicycle"></i>
                        </div>
                        <span>EcoBike</span>
                    </div>
                    <p class="text-gray-500 text-xs leading-relaxed">
                        Dịch vụ cho thuê xe máy điện tự lái tại TP. Hồ Chí Minh, Hà Nội và Đà Nẵng. Thủ tục nhanh gọn, giao nhận xe linh hoạt.
                    </p>
                </div>
                <div>
                    <h4 class="text-gray-900 font-semibold mb-3">Danh mục xe</h4>
                    <ul class="space-y-2 text-xs text-gray-500">
                        <li><a href="/Vehicles?Category=Economy" class="hover:text-emerald-600">Xe học sinh, sinh viên (Miễn bằng A1)</a></li>
                        <li><a href="/Vehicles?Category=MidRange" class="hover:text-emerald-600">Xe đi phố (VinFast Feliz S, Evo200)</a></li>
                        <li><a href="/Vehicles?Category=Touring" class="hover:text-emerald-600">Xe đi phượt (Dat Bike Quantum)</a></li>
                        <li><a href="/Vehicles?Category=SportPremium" class="hover:text-emerald-600">Xe thể thao (VinFast Theon S)</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-gray-900 font-semibold mb-3">Hỗ trợ khách hàng</h4>
                    <ul class="space-y-2 text-xs text-gray-500">
                        <li><a href="/Home/Stations" class="hover:text-emerald-600">Tra cứu trạm sạc & đổi pin</a></li>
                        <li><a href="/Host/BecomeHost" class="hover:text-emerald-600">Đăng ký cho thuê xe</a></li>
                        <li><a href="/Account/Login" class="hover:text-emerald-600">Tài khoản khách thuê</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-gray-900 font-semibold mb-3">Liên hệ</h4>
                    <ul class="space-y-2 text-xs text-gray-500">
                        <li><i class="bi bi-telephone mr-1.5 text-emerald-600"></i> Tổng đài: 1900 6868 (8:00 - 21:00)</li>
                        <li><i class="bi bi-envelope mr-1.5 text-emerald-600"></i> Email: hotro@ecobike.vn</li>
                        <li><i class="bi bi-geo-alt mr-1.5 text-emerald-600"></i> Quận 1, TP. Hồ Chí Minh</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-100 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400">
                <span>&copy; 2026 EcoBike. Hệ thống cho thuê xe máy điện.</span>
                <div class="flex gap-4 mt-2 sm:mt-0">
                    <a href="/react" class="hover:text-gray-600">Giao diện React</a>
                    <a href="/swagger" class="hover:text-gray-600">API Docs</a>
                </div>
            </div>
        </div>
    </footer>
    <script>
        function toggleMobileMenu() {
            var menu = document.getElementById('mobileMenu');
            if (menu) {
                menu.classList.toggle('hidden');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
