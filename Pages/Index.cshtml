@page "/"
@model MiotoCarRental.ViewModels.HomeIndexPageModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Trang chủ - Thuê xe máy điện tự lái";
    var featuredCars = Model.FeaturedCars;
}

<!-- Hero Banner & Search Bar -->
<section class="bg-emerald-800 py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-white leading-snug">
                Thuê xe máy điện tự lái theo ngày
            </h1>
            <p class="mt-3 text-sm sm:text-base text-emerald-100">
                Đặt xe nhanh tại TP. Hồ Chí Minh, Hà Nội và Đà Nẵng. Có dòng xe dưới 50km/h không yêu cầu bằng lái A1 cho học sinh, sinh viên.
            </p>
        </div>

        <!-- Search Form -->
        <div class="bg-white p-5 sm:p-6 rounded-xl shadow-md border border-gray-200 max-w-4xl mx-auto">
            <form action="/Vehicles" method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Khu vực nhận xe</label>
                    <select name="City" class="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600">
                        <option value="">Tất cả thành phố</option>
                        <option value="TP. Hồ Chí Minh" selected>TP. Hồ Chí Minh</option>
                        <option value="Hà Nội">Hà Nội</option>
                        <option value="Đà Nẵng">Đà Nẵng</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Ngày nhận xe</label>
                    <input type="date" name="StartDate" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                           class="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Ngày trả xe</label>
                    <input type="date" name="EndDate" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")"
                           class="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600" />
                </div>

                <div class="flex items-end">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-5 rounded-lg transition text-sm flex items-center justify-center gap-2">
                        <i class="bi bi-search"></i> Tìm xe
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- 4 Categories -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Chọn xe theo nhu cầu</h2>
            <p class="text-sm text-gray-500 mt-0.5">Phân loại theo vận tốc, quãng đường pin và quy định bằng lái</p>
        </div>
        <a href="/Vehicles" class="text-sm font-medium text-emerald-600 hover:underline hidden sm:inline">Xem tất cả &rarr;</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/Vehicles?Category=@VehicleCategory.Economy"
           class="bg-white p-5 rounded-xl border border-gray-200 hover:border-emerald-600 hover:shadow-sm transition flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                        <i class="bi bi-mortarboard"></i>
                    </span>
                    <span class="text-xs font-medium bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded">Miễn bằng A1</span>
                </div>
                <h3 class="text-base font-bold text-gray-900">Phổ thông & Học sinh</h3>
                <p class="text-xs text-gray-500 mt-1">Giới hạn dưới 50km/h, nhỏ gọn dễ lái (Evo200 Lite, Yadea, Pega)</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-500">Giá từ <strong class="text-gray-900">70.000đ/ngày</strong></span>
                <span class="text-emerald-600 font-medium">Xem xe &rarr;</span>
            </div>
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.MidRange"
           class="bg-white p-5 rounded-xl border border-gray-200 hover:border-emerald-600 hover:shadow-sm transition flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
                        <i class="bi bi-briefcase"></i>
                    </span>
                    <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2.5 py-1 rounded">Cốp rộng 25L</span>
                </div>
                <h3 class="text-base font-bold text-gray-900">Đô thị & Đi làm</h3>
                <p class="text-xs text-gray-500 mt-1">Quãng đường 150-200km/sạc, vận hành êm ái (Feliz S, Evo200)</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-500">Giá từ <strong class="text-gray-900">100.000đ/ngày</strong></span>
                <span class="text-emerald-600 font-medium">Xem xe &rarr;</span>
            </div>
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.Touring"
           class="bg-white p-5 rounded-xl border border-gray-200 hover:border-emerald-600 hover:shadow-sm transition flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
                        <i class="bi bi-compass"></i>
                    </span>
                    <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2.5 py-1 rounded">Pin 200-270km</span>
                </div>
                <h3 class="text-base font-bold text-gray-900">Đường dài & Đi phượt</h3>
                <p class="text-xs text-gray-500 mt-1">Pin dung lượng lớn, khung gầm chắc chắn (Dat Bike Quantum, Klara S)</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-500">Giá từ <strong class="text-gray-900">130.000đ/ngày</strong></span>
                <span class="text-emerald-600 font-medium">Xem xe &rarr;</span>
            </div>
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.SportPremium"
           class="bg-white p-5 rounded-xl border border-gray-200 hover:border-emerald-600 hover:shadow-sm transition flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="w-10 h-10 rounded-lg bg-gray-100 text-gray-800 flex items-center justify-center text-lg">
                        <i class="bi bi-speedometer2"></i>
                    </span>
                    <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2.5 py-1 rounded">Phanh ABS</span>
                </div>
                <h3 class="text-base font-bold text-gray-900">Thể thao & Cao cấp</h3>
                <p class="text-xs text-gray-500 mt-1">Công suất lớn, tốc độ tới 100km/h (VinFast Theon S, Vento S)</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-500">Giá từ <strong class="text-gray-900">180.000đ/ngày</strong></span>
                <span class="text-emerald-600 font-medium">Xem xe &rarr;</span>
            </div>
        </a>
    </div>
</section>

<!-- Featured Vehicles -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Xe máy điện nổi bật</h2>
            <p class="text-sm text-gray-500 mt-0.5">Các mẫu xe đang có sẵn và được thuê nhiều nhất</p>
        </div>
        <a href="/Vehicles" class="text-sm font-medium text-emerald-600 hover:underline">Xem toàn bộ danh sách &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var car in featuredCars)
        {
            <div class="bg-white rounded-xl overflow-hidden border border-gray-200 hover:shadow-md transition flex flex-col justify-between">
                <div class="relative h-48 bg-gray-100">
                    <img src="@car.ThumbnailUrl" alt="@car.Brand @car.Model" class="w-full h-full object-cover" />
                    @if (!car.RequiresLicenseA1)
                    {
                        <span class="absolute top-3 left-3 bg-emerald-600 text-white text-xs font-medium px-2.5 py-1 rounded">
                            Miễn bằng A1
                        </span>
                    }
                    <span class="absolute bottom-3 left-3 bg-black/65 text-white text-xs px-2.5 py-1 rounded">
                        <i class="bi bi-geo-alt"></i> @car.District, @car.City
                    </span>
                </div>

                <div class="p-5 flex flex-col flex-grow justify-between">
                    <div>
                        <div class="text-xs text-gray-500 mb-1">@car.Brand • Năm @car.YearManufacture</div>
                        <h3 class="text-lg font-bold text-gray-900">@car.Brand @car.Model</h3>

                        <div class="grid grid-cols-3 gap-2 py-2.5 px-3 my-3 bg-gray-50 rounded-lg border border-gray-100 text-xs">
                            <div>
                                <div class="text-gray-400">Quãng đường</div>
                                <div class="font-semibold text-gray-800">@car.BatteryRangeKm km</div>
                            </div>
                            <div>
                                <div class="text-gray-400">Vận tốc</div>
                                <div class="font-semibold text-gray-800">@car.MaxSpeedKmH km/h</div>
                            </div>
                            <div>
                                <div class="text-gray-400">Bằng lái</div>
                                <div class="font-semibold @(!car.RequiresLicenseA1 ? "text-emerald-600" : "text-gray-800")">
                                    @(!car.RequiresLicenseA1 ? "Miễn A1" : "Bằng A1")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                        <div>
                            <span class="text-lg font-bold text-emerald-600">@car.PricePerDay.ToString("N0")đ</span>
                            <span class="text-xs text-gray-400"> / ngày</span>
                        </div>
                        <a href="/Vehicles/Details/@car.Id"
                           class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs px-4 py-2 rounded-lg transition">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Simple Rental Steps -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-6">Hướng dẫn thuê xe tại EcoBike</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
            <div>
                <div class="text-xs font-bold text-emerald-600 uppercase mb-1">Bước 1</div>
                <h3 class="font-semibold text-gray-900 mb-1">Tìm và chọn xe</h3>
                <p class="text-xs text-gray-500 leading-relaxed">Chọn khu vực, ngày thuê và dòng xe phù hợp với nhu cầu di chuyển.</p>
            </div>
            <div>
                <div class="text-xs font-bold text-emerald-600 uppercase mb-1">Bước 2</div>
                <h3 class="font-semibold text-gray-900 mb-1">Đặt xe trực tuyến</h3>
                <p class="text-xs text-gray-500 leading-relaxed">Kiểm tra chi phí thuê, áp dụng mã giảm giá (nếu có) và gửi yêu cầu đặt xe.</p>
            </div>
            <div>
                <div class="text-xs font-bold text-emerald-600 uppercase mb-1">Bước 3</div>
                <h3 class="font-semibold text-gray-900 mb-1">Nhận bàn giao xe</h3>
                <p class="text-xs text-gray-500 leading-relaxed">Đối chiếu hợp đồng, kiểm tra mức pin, công-tơ-mét (ODO) và nhận 2 mũ bảo hiểm.</p>
            </div>
            <div>
                <div class="text-xs font-bold text-emerald-600 uppercase mb-1">Bước 4</div>
                <h3 class="font-semibold text-gray-900 mb-1">Trả xe & Thanh toán</h3>
                <p class="text-xs text-gray-500 leading-relaxed">Trả xe đúng hẹn tại điểm hẹn và đánh giá chất lượng phương tiện sau chuyến đi.</p>
            </div>
        </div>
    </div>
</section>
