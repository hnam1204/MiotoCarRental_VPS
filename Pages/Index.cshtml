@page "/"
@model MiotoCarRental.ViewModels.HomeIndexPageModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Trang chủ - Thuê xe máy điện xanh EcoBike";
    var featuredCars = Model.FeaturedCars;
}

<!-- Hero Section with Search Box -->
<section class="relative bg-gradient-to-br from-emerald-900 via-gray-900 to-gray-900 py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 mb-4 shadow-sm">
                <i class="bi bi-battery-charging text-sm"></i> 100% Xe Pin LFP Sạc Đầy • Đi Tới 200km - 270km
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
                Thuê xe máy điện <span class="text-emerald-400">thông minh</span> & bảo vệ môi trường
            </h1>
            <p class="mt-4 text-base sm:text-lg text-gray-300 font-medium max-w-2xl mx-auto">
                Trải nghiệm các dòng xe máy điện hiện đại VinFast Evo200, Dat Bike Quantum, Feliz S tại TP.HCM, Hà Nội & Đà Nẵng. Giá chỉ từ 70.000 đ/ngày.
            </p>
        </div>

        <!-- Quick Search Card -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-2xl border border-gray-100 max-w-5xl mx-auto">
            <form action="/Vehicles" method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Location -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2 text-center sm:text-left">
                        <i class="bi bi-geo-alt-fill text-emerald-600 mr-1"></i> Khu vực nhận xe
                    </label>
                    <select name="City" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition text-center sm:text-left">
                        <option value="">Tất cả thành phố</option>
                        <option value="TP. Hồ Chí Minh" selected>TP. Hồ Chí Minh</option>
                        <option value="Hà Nội">Hà Nội</option>
                        <option value="Đà Nẵng">Đà Nẵng</option>
                    </select>
                </div>

                <!-- Start Date -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2 text-center sm:text-left">
                        <i class="bi bi-calendar-event text-emerald-600 mr-1"></i> Ngày nhận xe
                    </label>
                    <input type="date" name="StartDate" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition text-center sm:text-left" />
                </div>

                <!-- End Date -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2 text-center sm:text-left">
                        <i class="bi bi-calendar2-check text-emerald-600 mr-1"></i> Ngày trả xe
                    </label>
                    <input type="date" name="EndDate" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition text-center sm:text-left" />
                </div>

                <!-- Submit Button -->
                <div class="flex items-end">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3.5 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2 text-sm">
                        <i class="bi bi-search"></i> TÌM XE MÁY ĐIỆN
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- 3 Core Features Banner (Ô đều, Chữ chính giữa) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block mb-3">
            <i class="bi bi-shield-check"></i> Tiêu Chuẩn EcoBike
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
            Ưu Điểm Thuê Xe Máy Điện Xanh
        </h2>
        <p class="mt-2 text-sm text-gray-500">
            Dịch vụ tối ưu chi phí, thân thiện môi trường và an toàn tối đa cho mọi chuyến đi
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center justify-between h-full group">
            <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform shadow-sm">
                <i class="bi bi-battery-charging"></i>
            </div>
            <div>
                <h3 class="font-extrabold text-gray-900 text-lg mb-2">Pin LFP Sạc Đầy 100%</h3>
                <p class="text-sm text-gray-500 leading-relaxed">
                    Công nghệ pin LFP chống cháy nổ tuyệt đối, tầm hoạt động 200 - 270km/lần sạc, kèm sạc di động chính hãng theo xe.
                </p>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50 w-full text-xs font-bold text-emerald-600">
                <i class="bi bi-check-circle-fill mr-1"></i> Kiểm tra dung lượng khi giao xe
            </div>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center justify-between h-full group">
            <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform shadow-sm">
                <i class="bi bi-person-vcard-fill"></i>
            </div>
            <div>
                <h3 class="font-extrabold text-gray-900 text-lg mb-2">Thủ Tục Đơn Giản 5 Phút</h3>
                <p class="text-sm text-gray-500 leading-relaxed">
                    Chỉ cần CCCD gắn chip và tiền cọc linh hoạt từ 2 triệu đồng. Đặc biệt có dòng xe học sinh không yêu cầu bằng lái A1.
                </p>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50 w-full text-xs font-bold text-blue-600">
                <i class="bi bi-check-circle-fill mr-1"></i> Duyệt hồ sơ tự động siêu tốc
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center justify-between h-full group">
            <div class="w-16 h-16 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform shadow-sm">
                <i class="bi bi-gift-fill"></i>
            </div>
            <div>
                <h3 class="font-extrabold text-gray-900 text-lg mb-2">Trang Bị Chu Đáo Toàn Diện</h3>
                <p class="text-sm text-gray-500 leading-relaxed">
                    Tặng kèm 02 nón bảo hiểm đạt chuẩn, áo mưa cao cấp, giá đỡ điện thoại thông minh và dây khóa phanh an toàn.
                </p>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50 w-full text-xs font-bold text-purple-600">
                <i class="bi bi-check-circle-fill mr-1"></i> Miễn phí toàn bộ phụ kiện kèm xe
            </div>
        </div>
    </div>
</section>

<!-- 4 Categories Quick Browse (Ô đều, Chữ chính giữa) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block mb-3">
            <i class="bi bi-grid-fill"></i> Phân Loại Thông Minh
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
            Khám Phá Theo Nhóm Nhu Cầu
        </h2>
        <p class="mt-2 text-sm text-gray-500">
            Lựa chọn đúng mẫu xe điện phù hợp bằng lái, ngân sách và cự ly di chuyển của bạn
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 1. Economy -->
        <a href="/Vehicles?Category=@VehicleCategory.Economy" 
           class="bg-gradient-to-br from-emerald-500 to-teal-700 text-white p-7 rounded-3xl shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center justify-between text-center min-h-[240px] relative overflow-hidden group">
            <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-black uppercase tracking-wider">
                Miễn bằng lái A1
            </span>
            <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl mx-auto my-2 group-hover:scale-110 transition-transform">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <h3 class="text-lg font-black leading-tight">Phổ Thông & Học Sinh</h3>
                <p class="text-xs text-emerald-100 mt-1">Từ 70k/ngày • Evo Lite, Yadea, Pega</p>
            </div>
            <div class="mt-3 inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-full bg-white/20 group-hover:bg-white/30 backdrop-blur-md text-xs font-bold transition">
                <span>Khám phá ngay</span>
                <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- 2. MidRange -->
        <a href="/Vehicles?Category=@VehicleCategory.MidRange" 
           class="bg-gradient-to-br from-blue-500 to-indigo-700 text-white p-7 rounded-3xl shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center justify-between text-center min-h-[240px] relative overflow-hidden group">
            <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-black uppercase tracking-wider">
                Cốp rộng 25L • 80km/h
            </span>
            <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl mx-auto my-2 group-hover:scale-110 transition-transform">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <div>
                <h3 class="text-lg font-black leading-tight">Đô Thị & Đi Làm</h3>
                <p class="text-xs text-blue-100 mt-1">Từ 100k/ngày • Feliz S, Weaver 200</p>
            </div>
            <div class="mt-3 inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-full bg-white/20 group-hover:bg-white/30 backdrop-blur-md text-xs font-bold transition">
                <span>Khám phá ngay</span>
                <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- 3. Touring -->
        <a href="/Vehicles?Category=@VehicleCategory.Touring" 
           class="bg-gradient-to-br from-purple-500 to-violet-800 text-white p-7 rounded-3xl shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center justify-between text-center min-h-[240px] relative overflow-hidden group">
            <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-black uppercase tracking-wider">
                Pin khủng 200-270km
            </span>
            <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl mx-auto my-2 group-hover:scale-110 transition-transform">
                <i class="bi bi-compass-fill"></i>
            </div>
            <div>
                <h3 class="text-lg font-black leading-tight">Đường Dài & Phượt</h3>
                <p class="text-xs text-purple-100 mt-1">Từ 130k/ngày • Klara S, Vento S</p>
            </div>
            <div class="mt-3 inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-full bg-white/20 group-hover:bg-white/30 backdrop-blur-md text-xs font-bold transition">
                <span>Khám phá ngay</span>
                <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- 4. SportPremium -->
        <a href="/Vehicles?Category=@VehicleCategory.SportPremium" 
           class="bg-gradient-to-br from-rose-500 to-red-700 text-white p-7 rounded-3xl shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center justify-between text-center min-h-[240px] relative overflow-hidden group">
            <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-black uppercase tracking-wider">
                Phanh ABS • Tốc độ 100km/h
            </span>
            <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl mx-auto my-2 group-hover:scale-110 transition-transform">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <h3 class="text-lg font-black leading-tight">Thể Thao & Cao Cấp</h3>
                <p class="text-xs text-rose-100 mt-1">Từ 180k/ngày • Theon S, Quantum</p>
            </div>
            <div class="mt-3 inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-full bg-white/20 group-hover:bg-white/30 backdrop-blur-md text-xs font-bold transition">
                <span>Khám phá ngay</span>
                <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    </div>
</section>

<!-- Featured Electric Bikes Section (Ô đều, Chữ chính giữa) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block mb-3">
            <i class="bi bi-lightning-charge-fill"></i> Xe Có Sẵn Giao Ngay
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
            Các Dòng Xe Máy Điện Nổi Bật
        </h2>
        <p class="mt-2 text-sm text-gray-500">
            Đa dạng lựa chọn từ xe học sinh tiết kiệm đến các dòng xe phượt đường dài pin khủng
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var car in featuredCars)
        {
            <div class="bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full group">
                <!-- Bike Thumbnail -->
                <div class="relative h-56 overflow-hidden bg-gray-100">
                    <img src="@car.ThumbnailUrl" alt="@car.Brand @car.Model" 
                         class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                    
                    @if (!car.RequiresLicenseA1)
                    {
                        <span class="absolute top-4 left-4 bg-blue-600 text-white text-[11px] font-extrabold uppercase px-3 py-1 rounded-full shadow-md flex items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i> Miễn bằng lái A1
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-4 left-4 bg-emerald-600 text-white text-[11px] font-extrabold uppercase px-3 py-1 rounded-full shadow-md flex items-center gap-1">
                            <i class="bi bi-lightning-fill"></i> Đặt nhanh
                        </span>
                    }

                    <span class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-md text-white text-xs font-semibold px-2.5 py-1 rounded-xl">
                        <i class="bi bi-geo-alt"></i> @car.City
                    </span>
                </div>

                <!-- Bike Info (Căn giữa cân đối) -->
                <div class="p-6 flex flex-col flex-grow justify-between text-center">
                    <div>
                        <div class="flex items-center justify-center gap-2 mb-2 text-xs font-bold text-gray-400 uppercase tracking-wider">
                            <span>@car.Brand • @car.YearManufacture</span>
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">
                                @car.BatteryType
                            </span>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 group-hover:text-emerald-600 transition text-center">
                            @car.Brand @car.Model
                        </h3>
                        <p class="text-xs text-gray-500 mt-2 line-clamp-2 text-center leading-relaxed">
                            @car.Description
                        </p>
                    </div>

                    <!-- Tech Specs Icons (3 ô đều, chữ chính giữa) -->
                    <div class="grid grid-cols-3 gap-2 py-3 px-2 border-y border-gray-100 my-4 bg-gray-50/70 rounded-2xl text-center">
                        <div class="flex flex-col items-center justify-center">
                            <i class="bi bi-battery-full text-emerald-600 text-lg mb-0.5"></i>
                            <span class="text-[10px] text-gray-400 font-bold uppercase">Cự ly pin</span>
                            <span class="font-extrabold text-xs text-gray-800">@car.BatteryRangeKm km</span>
                        </div>
                        <div class="flex flex-col items-center justify-center border-x border-gray-200">
                            <i class="bi bi-speedometer2 text-blue-600 text-lg mb-0.5"></i>
                            <span class="text-[10px] text-gray-400 font-bold uppercase">Tốc độ</span>
                            <span class="font-extrabold text-xs text-gray-800">@car.MaxSpeedKmH km/h</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <i class="bi bi-shield-check text-purple-600 text-lg mb-0.5"></i>
                            <span class="text-[10px] text-gray-400 font-bold uppercase">Bằng lái</span>
                            <span class="font-extrabold text-xs @(!car.RequiresLicenseA1 ? "text-emerald-700" : "text-gray-800")">
                                @(!car.RequiresLicenseA1 ? "Miễn A1" : "Cần A1")
                            </span>
                        </div>
                    </div>

                    <!-- Price & CTA -->
                    <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                        <div class="text-left">
                            <span class="text-xl font-black text-emerald-600">@car.PricePerDay.ToString("N0") đ</span>
                            <span class="block text-[10px] text-gray-400 font-semibold -mt-1">/ngày</span>
                        </div>
                        <a href="/Vehicles/Details/@car.Id" 
                           class="bg-gray-900 hover:bg-emerald-600 text-white font-bold text-xs px-5 py-3 rounded-2xl transition shadow-sm flex items-center gap-1.5">
                            <span>Xem & Đặt xe</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-10">
        <a href="/Vehicles" 
           class="inline-flex items-center justify-center gap-2 bg-white hover:bg-emerald-50 text-emerald-700 border-2 border-emerald-600 font-black text-sm px-8 py-3.5 rounded-2xl transition shadow-sm">
            <span>Xem Tất Cả Các Dòng Xe Máy Điện</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>

<!-- 4 Steps Rental Process (4 ô đều, chữ chính giữa) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block mb-3">
            <i class="bi bi-clock-history"></i> Thao Tác Đơn Giản
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
            Quy Trình Thuê Xe 4 Bước Nhanh Chóng
        </h2>
        <p class="mt-2 text-sm text-gray-500">
            Chỉ mất 5 phút để hoàn tất thủ tục và bắt đầu hành trình xanh cùng EcoBike
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm flex flex-col items-center text-center justify-between h-full hover:shadow-lg transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 font-black text-lg flex items-center justify-center mb-4">01</div>
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform"><i class="bi bi-search"></i></div>
            <div>
                <h3 class="font-extrabold text-gray-900 text-base mb-1.5">Tìm & Chọn Xe</h3>
                <p class="text-xs text-gray-500 leading-relaxed">Lọc theo nhóm nhu cầu, cự ly pin, mức giá và trạm giao nhận thuận tiện nhất.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-50 w-full text-[11px] font-bold text-gray-400">Bước 1 • Trực tuyến</div>
        </div>
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm flex flex-col items-center text-center justify-between h-full hover:shadow-lg transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 font-black text-lg flex items-center justify-center mb-4">02</div>
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform"><i class="bi bi-person-vcard"></i></div>
            <div>
