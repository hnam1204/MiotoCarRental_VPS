<script>
    function copyVoucher(code) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(code);
        }
        const toast = document.getElementById('copyToast');
        if (toast) {
            toast.textContent = 'Đã sao chép mã: ' + code;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }
    }

    function updateSavingsCalc() {
        const days = parseInt(document.getElementById('calcDaysInput').value || '5', 10);
        const kmPerDay = parseInt(document.getElementById('calcKmInput').value || '50', 10);
        const totalKm = days * kmPerDay;

        document.getElementById('calcDaysLabel').textContent = days + ' ngày';
        document.getElementById('calcKmLabel').textContent = kmPerDay + ' km/ngày (Tổng ' + totalKm + ' km)';

        // Gas scooter: ~550 VND / km; EV: ~75 VND / km
        const gasCost = Math.round((totalKm * 550) / 1000) * 1000;
        const evCost = Math.round((totalKm * 75) / 1000) * 1000;
        const saved = Math.max(0, gasCost - evCost);
        const co2Kg = (totalKm * 0.058).toFixed(1);

        document.getElementById('gasCostOutput').textContent = gasCost.toLocaleString('vi-VN') + 'đ';
        document.getElementById('evCostOutput').textContent = evCost.toLocaleString('vi-VN') + 'đ';
        document.getElementById('totalSavedOutput').textContent =
            'Tiết kiệm ' + saved.toLocaleString('vi-VN') + 'đ • Giảm ' + co2Kg + ' kg khí thải CO₂';
    }
</script>
