@page "/Vehicles"
@model MiotoCarRental.ViewModels.VehicleSearchViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Danh sách xe máy điện cho thuê";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center max-w-3xl mx-auto mb-6">
        <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200 mb-2">
            <i class="bi bi-ev-station-fill"></i> 100% Xe Máy Điện Xanh
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
            Danh Sách Xe Máy Điện Cho Thuê
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 font-medium mt-1.5">
            Tìm thấy <span class="font-bold text-emerald-600">@Model.TotalCount</span> xe máy điện sẵn sàng phục vụ • Pin LFP sạc đầy • Tiết kiệm 70% chi phí xăng
        </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-8">
        <a href="/Vehicles?City=@Model.City&Brand=@Model.Brand"
           class="px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-2 border shadow-sm
                  @(!Model.Category.HasValue ? "bg-gray-900 text-white border-gray-900 shadow-gray-900/20" : "bg-white text-gray-700 border-gray-200 hover:border-gray-400 hover:bg-gray-50")">
            <i class="bi bi-grid-fill"></i> Tất cả các dòng xe (@Model.TotalCount)
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.Economy&City=@Model.City&Brand=@Model.Brand"
           class="px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-2 border shadow-sm
                  @(Model.Category == VehicleCategory.Economy ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-emerald-800 border-emerald-200 hover:bg-emerald-50")">
            <i class="bi bi-mortarboard-fill"></i> Phổ Thông (Miễn bằng A1 - Học sinh/SV)
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.MidRange&City=@Model.City&Brand=@Model.Brand"
           class="px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-2 border shadow-sm
                  @(Model.Category == VehicleCategory.MidRange ? "bg-blue-600 text-white border-blue-600 shadow-blue-600/20" : "bg-white text-blue-800 border-blue-200 hover:bg-blue-50")">
            <i class="bi bi-briefcase-fill"></i> Đô Thị & Đi Làm (Tầm trung)
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.Touring&City=@Model.City&Brand=@Model.Brand"
           class="px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-2 border shadow-sm
                  @(Model.Category == VehicleCategory.Touring ? "bg-purple-600 text-white border-purple-600 shadow-purple-600/20" : "bg-white text-purple-800 border-purple-200 hover:bg-purple-50")">
            <i class="bi bi-compass-fill"></i> Đường Dài & Phượt (Pin 200 - 270km)
        </a>

        <a href="/Vehicles?Category=@VehicleCategory.SportPremium&City=@Model.City&Brand=@Model.Brand"
           class="px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-2 border shadow-sm
                  @(Model.Category == VehicleCategory.SportPremium ? "bg-rose-600 text-white border-rose-600 shadow-rose-600/20" : "bg-white text-rose-800 border-rose-200 hover:bg-rose-50")">
            <i class="bi bi-lightning-charge-fill"></i> Thể Thao & Cao Cấp (ABS, 7000W)
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-1">
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm sticky top-28 space-y-6">
                <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                    <h3 class="font-black text-gray-900 text-base flex items-center gap-2">
                        <i class="bi bi-funnel-fill text-emerald-600"></i> Bộ lọc chi tiết
                    </h3>
                    <a href="/Vehicles" class="text-[11px] font-bold text-gray-400 hover:text-emerald-600 transition">Xóa lọc</a>
                </div>

                <form action="/Vehicles" method="get" class="space-y-5">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Nhóm xe</label>
                        <select name="Category" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả các nhóm xe</option>
                            <option value="Economy" selected="@(Model.Category == VehicleCategory.Economy)">🟢 Phổ thông (Học sinh/SV - Miễn bằng A1)</option>
                            <option value="MidRange" selected="@(Model.Category == VehicleCategory.MidRange)">🔵 Đô thị & Đi làm (Tầm trung)</option>
                            <option value="Touring" selected="@(Model.Category == VehicleCategory.Touring)">🟣 Đường dài - Pin khủng (Phượt)</option>
                            <option value="SportPremium" selected="@(Model.Category == VehicleCategory.SportPremium)">🔴 Thể thao & Cao cấp (ABS)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Thành phố</label>
                        <select name="City" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả địa điểm</option>
                            <option value="TP. Hồ Chí Minh" selected="@(Model.City == "TP. Hồ Chí Minh")">TP. Hồ Chí Minh</option>
                            <option value="Hà Nội" selected="@(Model.City == "Hà Nội")">Hà Nội</option>
                            <option value="Đà Nẵng" selected="@(Model.City == "Đà Nẵng")">Đà Nẵng</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Hãng sản xuất</label>
                        <select name="Brand" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả các hãng</option>
                            <option value="VinFast" selected="@(Model.Brand == "VinFast")">VinFast</option>
                            <option value="Dat Bike" selected="@(Model.Brand == "Dat Bike")">Dat Bike</option>
                            <option value="Yadea" selected="@(Model.Brand == "Yadea")">Yadea</option>
                            <option value="Pega" selected="@(Model.Brand == "Pega")">Pega</option>
                            <option value="Selex" selected="@(Model.Brand == "Selex")">Selex Motors</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Quy định bằng lái</label>
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="" @(!Model.RequiresLicenseA1.HasValue ? "checked" : "") onchange="this.form.submit()" />
                                Tất cả
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="false" @(Model.RequiresLicenseA1 == false ? "checked" : "") onchange="this.form.submit()" />
                                <span class="text-emerald-700 font-bold"><i class="bi bi-patch-check"></i> Miễn bằng lái A1 (Học sinh/SV)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="true" @(Model.RequiresLicenseA1 == true ? "checked" : "") onchange="this.form.submit()" />
                                Cần GPLX A1 hợp lệ
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Quãng đường tối thiểu</label>
                        <select name="MinBatteryRangeKm" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả cự ly pin</option>
                            <option value="100" selected="@(Model.MinBatteryRangeKm == 100)">Từ 100 km trở lên</option>
                            <option value="150" selected="@(Model.MinBatteryRangeKm == 150)">Từ 150 km trở lên</option>
                            <option value="200" selected="@(Model.MinBatteryRangeKm == 200)">Từ 200 km trở lên (Pin LFP)</option>
                            <option value="250" selected="@(Model.MinBatteryRangeKm == 250)">Từ 250 km trở lên (Dat Bike)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Mức giá tối đa / ngày</label>
                        <select name="MaxPrice" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Không giới hạn giá</option>
                            <option value="80000" selected="@(Model.MaxPrice == 80000)">Dưới 80.000đ/ngày (Học sinh)</option>
                            <option value="130000" selected="@(Model.MaxPrice == 130000)">Dưới 130.000đ/ngày (Tiết kiệm)</option>
                            <option value="180000" selected="@(Model.MaxPrice == 180000)">Dưới 180.000đ/ngày (Tầm trung)</option>
                        </select>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-2xl shadow-md shadow-emerald-600/30 transition text-xs flex items-center justify-center gap-1.5">
                            <i class="bi bi-search"></i> ÁP DỤNG BỘ LỌC
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-3">
            @if (!Model.Results.Any())
            {
                <div class="bg-white rounded-3xl p-12 text-center border border-gray-100 shadow-sm flex flex-col items-center justify-center">
                    <div class="w-16 h-16 bg-gray-50 text-gray-300 rounded-3xl flex items-center justify-center text-3xl mb-4">
                        <i class="bi bi-bicycle"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-800">Không tìm thấy xe máy điện phù hợp với bộ lọc</h3>
                    <p class="text-xs text-gray-400 mt-1 max-w-sm mx-auto">Vui lòng điều chỉnh hoặc xóa bớt tiêu chí lọc để xem thêm các mẫu xe khác.</p>
                    <a href="/Vehicles" class="mt-5 inline-block bg-emerald-50 text-emerald-700 font-bold text-xs px-5 py-2.5 rounded-xl border border-emerald-200 hover:bg-emerald-100 transition shadow-sm">
                        Xem tất cả xe sẵn có
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var car in Model.Results)
                    {
                        <div class="bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full group">
                            <div class="relative h-52 bg-gray-100 overflow-hidden">
                                <img src="@car.ThumbnailUrl" alt="@car.Brand @car.Model" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                
                                <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                                    @switch (car.Category)
                                    {
                                        case VehicleCategory.Economy:
                                            <span class="bg-emerald-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-mortarboard-fill"></i> Phổ Thông (Học Sinh/SV)
                                            </span>
                                            break;
                                        case VehicleCategory.MidRange:
                                            <span class="bg-blue-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-briefcase-fill"></i> Đô Thị Đi Làm
                                            </span>
                                            break;
                                        case VehicleCategory.Touring:
                                            <span class="bg-purple-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-compass-fill"></i> Đường Dài Pin Khủng
                                            </span>
                                            break;
                                        case VehicleCategory.SportPremium:
                                            <span class="bg-rose-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-lightning-charge-fill"></i> Thể Thao Cao Cấp
                                            </span>
                                            break;
                                    }

                                    @if (!car.RequiresLicenseA1)
                                    {
                                        <span class="bg-cyan-500 text-white text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full shadow w-max">
                                            <i class="bi bi-check2-circle"></i> Miễn bằng lái A1
                                        </span>
                                    }
                                </div>

                                <span class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-xl">
                                    <i class="bi bi-geo-alt"></i> @car.District, @car.City
                                </span>
                            </div>

                            <div class="p-6 flex flex-col flex-grow justify-between text-center">
                                <div>
                                    <div class="flex items-center justify-center gap-2 text-xs text-gray-400 font-bold mb-1">
                                        <span class="uppercase">@car.Brand • @car.YearManufacture</span>
                                        <span class="text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md text-[11px]">@car.BatteryType</span>
                                    </div>
                                    <h3 class="text-lg font-black text-gray-900 group-hover:text-emerald-600 transition text-center">
                                        @car.Brand @car.Model
                                    </h3>
                                    <p class="text-xs text-gray-500 mt-1.5 line-clamp-2 leading-relaxed text-center px-1">
                                        @car.Description
                                    </p>
                                </div>

                                <div class="grid grid-cols-3 gap-2 text-center text-xs py-3 border-y border-gray-100 my-4 bg-gray-50/70 rounded-2xl px-2">
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="bi bi-battery-full text-emerald-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Cự ly pin</span>
                                        <span class="font-extrabold text-xs text-emerald-700">@car.BatteryRangeKm km</span>
                                    </div>
                                    <div class="flex flex-col items-center justify-center border-x border-gray-200">
                                        <i class="bi bi-speedometer2 text-blue-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Tốc độ max</span>
                                        <span class="font-extrabold text-xs text-blue-700">@car.MaxSpeedKmH km/h</span>
                                    </div>
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="bi bi-patch-check text-purple-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Bằng lái</span>
                                        <span class="font-extrabold text-xs @(!car.RequiresLicenseA1 ? "text-emerald-700" : "text-gray-700")">
                                            @(!car.RequiresLicenseA1 ? "Miễn A1" : "Cần A1")
                                        </span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                                    <div class="text-left">
                                        <span class="text-xl font-black text-emerald-600">@car.PricePerDay.ToString("N0")</span>
                                        <span class="text-xs font-semibold text-gray-400">đ/ngày</span>
                                    </div>
                                    <a href="/Vehicles/Details/@car.Id" 
                                       class="bg-gray-900 hover:bg-emerald-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-md shadow-gray-900/10 flex items-center justify-center gap-1.5">
                                        <span>Chi tiết</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
