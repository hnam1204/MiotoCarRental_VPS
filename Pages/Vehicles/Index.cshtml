@page "/Vehicles"
@model MiotoCarRental.ViewModels.VehicleSearchViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Danh sách xe máy điện cho thuê";
}

@functions {
    string BuildFilterUrl(VehicleCategory? category)
    {
        var queryParams = new List<string>();
        if (category.HasValue) queryParams.Add($"Category={category.Value}");
        if (!string.IsNullOrWhiteSpace(Model.Keyword)) queryParams.Add($"Keyword={Uri.EscapeDataString(Model.Keyword)}");
        if (!string.IsNullOrWhiteSpace(Model.City)) queryParams.Add($"City={Uri.EscapeDataString(Model.City)}");
        if (!string.IsNullOrWhiteSpace(Model.Brand)) queryParams.Add($"Brand={Uri.EscapeDataString(Model.Brand)}");
        if (Model.RequiresLicenseA1.HasValue) queryParams.Add($"RequiresLicenseA1={Model.RequiresLicenseA1.Value.ToString().ToLower()}");
        if (Model.MinBatteryRangeKm.HasValue) queryParams.Add($"MinBatteryRangeKm={Model.MinBatteryRangeKm.Value}");
        if (Model.MaxPrice.HasValue) queryParams.Add($"MaxPrice={Model.MaxPrice.Value}");
        if (Model.InstantBookingOnly == true) queryParams.Add("InstantBookingOnly=true");

        return queryParams.Count > 0 ? $"/Vehicles?{string.Join("&", queryParams)}" : "/Vehicles";
    }

    string BuildResetUrlWithoutKeyword()
    {
        var queryParams = new List<string>();
        if (Model.Category.HasValue) queryParams.Add($"Category={Model.Category.Value}");
        if (!string.IsNullOrWhiteSpace(Model.City)) queryParams.Add($"City={Uri.EscapeDataString(Model.City)}");
        if (!string.IsNullOrWhiteSpace(Model.Brand)) queryParams.Add($"Brand={Uri.EscapeDataString(Model.Brand)}");
        if (Model.RequiresLicenseA1.HasValue) queryParams.Add($"RequiresLicenseA1={Model.RequiresLicenseA1.Value.ToString().ToLower()}");
        if (Model.MinBatteryRangeKm.HasValue) queryParams.Add($"MinBatteryRangeKm={Model.MinBatteryRangeKm.Value}");
        if (Model.MaxPrice.HasValue) queryParams.Add($"MaxPrice={Model.MaxPrice.Value}");
        if (Model.InstantBookingOnly == true) queryParams.Add("InstantBookingOnly=true");

        return queryParams.Count > 0 ? $"/Vehicles?{string.Join("&", queryParams)}" : "/Vehicles";
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Danh sách xe máy điện cho thuê</h1>
            <p class="text-sm text-gray-500 mt-1">
                Hiện có <span class="font-bold text-emerald-600">@Model.TotalCount</span> xe đang sẵn sàng bàn giao cho hành trình của bạn
            </p>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-xs font-semibold text-gray-500">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                <i class="bi bi-shield-check text-emerald-600"></i> 100% Xe chính hãng
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                <i class="bi bi-battery-charging text-blue-600"></i> Kèm sạc & 2 nón BH
            </span>
        </div>
    </div>

    <!-- Thanh tìm kiếm từ khóa đa năng (Keyword Search Bar) -->
    <div class="bg-white rounded-3xl p-3 sm:p-4 border border-gray-200 shadow-sm mb-6">
        <form action="/Vehicles" method="get" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            @if (Model.Category.HasValue)
            {
                <input type="hidden" name="Category" value="@Model.Category.Value" />
            }
            @if (!string.IsNullOrWhiteSpace(Model.City))
            {
                <input type="hidden" name="City" value="@Model.City" />
            }
            @if (!string.IsNullOrWhiteSpace(Model.Brand))
            {
                <input type="hidden" name="Brand" value="@Model.Brand" />
            }
            @if (Model.RequiresLicenseA1.HasValue)
            {
                <input type="hidden" name="RequiresLicenseA1" value="@Model.RequiresLicenseA1.Value.ToString().ToLower()" />
            }
            @if (Model.MinBatteryRangeKm.HasValue)
            {
                <input type="hidden" name="MinBatteryRangeKm" value="@Model.MinBatteryRangeKm.Value" />
            }
            @if (Model.MaxPrice.HasValue)
            {
                <input type="hidden" name="MaxPrice" value="@Model.MaxPrice.Value" />
            }
            @if (Model.InstantBookingOnly == true)
            {
                <input type="hidden" name="InstantBookingOnly" value="true" />
            }

            <div class="relative flex-1">
                <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-base"></i>
                <input type="text" name="Keyword" id="keywordSearchInput" value="@Model.Keyword" 
                       placeholder="Tìm theo tên xe (Evo200, Quantum, Feliz...), hãng xe hoặc địa điểm (Quận 1, Hà Nội...)" 
                       class="w-full bg-gray-50 border border-gray-200 rounded-2xl pl-11 pr-10 py-3 text-xs sm:text-sm font-semibold text-gray-800 focus:outline-none focus:border-emerald-600 focus:bg-white transition" />
                @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                {
                    <a href="@BuildResetUrlWithoutKeyword()" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 rounded-full hover:bg-gray-200 transition" title="Xóa từ khóa tìm kiếm">
                        <i class="bi bi-x-circle-fill text-sm"></i>
                    </a>
                }
            </div>

            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs px-6 py-3.5 rounded-2xl shadow-md shadow-emerald-600/30 transition flex items-center justify-center gap-2 whitespace-nowrap">
                <i class="bi bi-search"></i>
                <span>TÌM KIẾM</span>
            </button>
        </form>

        <!-- Gợi ý từ khóa tìm kiếm nhanh (Search Chips) -->
        <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-gray-100 text-xs">
            <span class="text-[11px] font-bold text-gray-400 mr-1 flex items-center gap-1">
                <i class="bi bi-fire text-amber-500"></i> Gợi ý tìm nhanh:
            </span>
            <button type="button" onclick="quickSearch('VinFast')" class="px-2.5 py-1 rounded-xl bg-gray-100 hover:bg-emerald-50 hover:text-emerald-700 text-gray-600 text-[11px] font-semibold transition border border-transparent hover:border-emerald-200">
                VinFast
            </button>
            <button type="button" onclick="quickSearch('Dat Bike Quantum')" class="px-2.5 py-1 rounded-xl bg-gray-100 hover:bg-emerald-50 hover:text-emerald-700 text-gray-600 text-[11px] font-semibold transition border border-transparent hover:border-emerald-200">
                Dat Bike Quantum
            </button>
            <button type="button" onclick="quickSearch('Evo200')" class="px-2.5 py-1 rounded-xl bg-gray-100 hover:bg-emerald-50 hover:text-emerald-700 text-gray-600 text-[11px] font-semibold transition border border-transparent hover:border-emerald-200">
                Evo200
            </button>
            <button type="button" onclick="quickSearch('Yadea')" class="px-2.5 py-1 rounded-xl bg-gray-100 hover:bg-emerald-50 hover:text-emerald-700 text-gray-600 text-[11px] font-semibold transition border border-transparent hover:border-emerald-200">
                Yadea Ocean
            </button>
            <button type="button" onclick="quickSearch('Quận 1')" class="px-2.5 py-1 rounded-xl bg-gray-100 hover:bg-emerald-50 hover:text-emerald-700 text-gray-600 text-[11px] font-semibold transition border border-transparent hover:border-emerald-200">
                <i class="bi bi-geo-alt text-[10px]"></i> Quận 1
            </button>
        </div>
    </div>

    <!-- Tab phân khúc xe máy điện (Bảo toàn 100% Query Params khi chuyển tab) -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
        <a href="@BuildFilterUrl(null)"
           class="px-3.5 py-2 rounded-xl text-xs font-bold transition border shadow-xs
                  @(!Model.Category.HasValue ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            Tất cả (@Model.TotalCount)
        </a>

        <a href="@BuildFilterUrl(VehicleCategory.Economy)"
           class="px-3.5 py-2 rounded-xl text-xs font-bold transition border shadow-xs flex items-center gap-1.5
                  @(Model.Category == VehicleCategory.Economy ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            <i class="bi bi-mortarboard-fill text-[11px]"></i> Phổ thông (Miễn bằng A1)
        </a>

        <a href="@BuildFilterUrl(VehicleCategory.MidRange)"
           class="px-3.5 py-2 rounded-xl text-xs font-bold transition border shadow-xs flex items-center gap-1.5
                  @(Model.Category == VehicleCategory.MidRange ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            <i class="bi bi-briefcase-fill text-[11px]"></i> Đô thị & Đi làm
        </a>

        <a href="@BuildFilterUrl(VehicleCategory.Touring)"
           class="px-3.5 py-2 rounded-xl text-xs font-bold transition border shadow-xs flex items-center gap-1.5
                  @(Model.Category == VehicleCategory.Touring ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            <i class="bi bi-compass-fill text-[11px]"></i> Đường dài & Đi phượt
        </a>

        <a href="@BuildFilterUrl(VehicleCategory.SportPremium)"
           class="px-3.5 py-2 rounded-xl text-xs font-bold transition border shadow-xs flex items-center gap-1.5
                  @(Model.Category == VehicleCategory.SportPremium ? "bg-emerald-600 text-white border-emerald-600 shadow-emerald-600/20" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50")">
            <i class="bi bi-lightning-charge-fill text-[11px]"></i> Thể thao & Cao cấp
        </a>
    </div>

    <!-- Nút mở bộ lọc trên thiết bị di động (Mobile Filter Toggle) -->
    <div class="lg:hidden mb-4">
        <button type="button" onclick="toggleMobileFilters()" 
                class="w-full py-3 px-4 bg-white border border-gray-200 rounded-xl text-xs font-bold text-gray-700 flex items-center justify-between shadow-2xs hover:bg-gray-50 transition">
            <span class="flex items-center gap-2">
                <i class="bi bi-funnel-fill text-emerald-600"></i>
                <span>Bộ lọc & Phân khúc xe máy điện</span>
            </span>
            <i id="filterArrowIcon" class="bi bi-chevron-down text-gray-400"></i>
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div id="filterSidebar" class="hidden lg:block lg:col-span-1">
            <div class="bg-white p-5 rounded-2xl border border-gray-200 sticky top-20 space-y-4 shadow-xs">
                <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                    <h3 class="font-bold text-gray-900 text-sm">Bộ lọc tìm kiếm</h3>
                    <a href="/Vehicles" class="text-xs text-gray-500 hover:text-emerald-600">Đặt lại</a>
                </div>

                <form action="/Vehicles" method="get" class="space-y-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                    {
                        <input type="hidden" name="Keyword" value="@Model.Keyword" />
                    }
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1.5">Phân khúc xe</label>
                        <select name="Category" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-xs text-gray-800">
                            <option value="">Tất cả các nhóm xe</option>
                            <option value="Economy" selected="@(Model.Category == VehicleCategory.Economy)">Phổ thông (Miễn bằng A1)</option>
                            <option value="MidRange" selected="@(Model.Category == VehicleCategory.MidRange)">Đô thị & Đi làm</option>
                            <option value="Touring" selected="@(Model.Category == VehicleCategory.Touring)">Đường dài & Đi phượt</option>
                            <option value="SportPremium" selected="@(Model.Category == VehicleCategory.SportPremium)">Thể thao & Cao cấp</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Thành phố</label>
                        <select name="City" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả địa điểm</option>
                            <option value="TP. Hồ Chí Minh" selected="@(Model.City == "TP. Hồ Chí Minh")">TP. Hồ Chí Minh</option>
                            <option value="Hà Nội" selected="@(Model.City == "Hà Nội")">Hà Nội</option>
                            <option value="Đà Nẵng" selected="@(Model.City == "Đà Nẵng")">Đà Nẵng</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Hãng sản xuất</label>
                        <select name="Brand" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả các hãng</option>
                            <option value="VinFast" selected="@(Model.Brand == "VinFast")">VinFast</option>
                            <option value="Dat Bike" selected="@(Model.Brand == "Dat Bike")">Dat Bike</option>
                            <option value="Yadea" selected="@(Model.Brand == "Yadea")">Yadea</option>
                            <option value="Pega" selected="@(Model.Brand == "Pega")">Pega</option>
                            <option value="Selex" selected="@(Model.Brand == "Selex")">Selex Motors</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Quy định bằng lái</label>
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="" @(!Model.RequiresLicenseA1.HasValue ? "checked" : "") onchange="this.form.submit()" />
                                Tất cả
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="false" @(Model.RequiresLicenseA1 == false ? "checked" : "") onchange="this.form.submit()" />
                                <span class="text-emerald-700 font-bold"><i class="bi bi-patch-check"></i> Miễn bằng lái A1 (Học sinh/SV)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-gray-700">
                                <input type="radio" name="RequiresLicenseA1" value="true" @(Model.RequiresLicenseA1 == true ? "checked" : "") onchange="this.form.submit()" />
                                Cần GPLX A1 hợp lệ
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Quãng đường tối thiểu</label>
                        <select name="MinBatteryRangeKm" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Tất cả cự ly pin</option>
                            <option value="100" selected="@(Model.MinBatteryRangeKm == 100)">Từ 100 km trở lên</option>
                            <option value="150" selected="@(Model.MinBatteryRangeKm == 150)">Từ 150 km trở lên</option>
                            <option value="200" selected="@(Model.MinBatteryRangeKm == 200)">Từ 200 km trở lên (Pin LFP)</option>
                            <option value="250" selected="@(Model.MinBatteryRangeKm == 250)">Từ 250 km trở lên (Dat Bike)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Mức giá tối đa / ngày</label>
                        <select name="MaxPrice" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Không giới hạn giá</option>
                            <option value="80000" selected="@(Model.MaxPrice == 80000)">Dưới 80.000đ/ngày (Học sinh)</option>
                            <option value="130000" selected="@(Model.MaxPrice == 130000)">Dưới 130.000đ/ngày (Tiết kiệm)</option>
                            <option value="180000" selected="@(Model.MaxPrice == 180000)">Dưới 180.000đ/ngày (Tầm trung)</option>
                        </select>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-2xl shadow-md shadow-emerald-600/30 transition text-xs flex items-center justify-center gap-1.5">
                            <i class="bi bi-search"></i> ÁP DỤNG BỘ LỌC
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-3 space-y-4">
            @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.Category.HasValue || !string.IsNullOrWhiteSpace(Model.City) || !string.IsNullOrWhiteSpace(Model.Brand) || Model.RequiresLicenseA1.HasValue || Model.MinBatteryRangeKm.HasValue || Model.MaxPrice.HasValue)
            {
                <div class="bg-white border border-gray-200 rounded-2xl p-3 sm:px-4 sm:py-3 shadow-xs flex flex-wrap items-center justify-between gap-2.5 text-xs">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-gray-400 font-bold flex items-center gap-1">
                            <i class="bi bi-funnel-fill text-emerald-600"></i> Đang lọc:
                        </span>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-1 rounded-xl font-bold">
                                Từ khóa: "@Model.Keyword"
                                <a href="@BuildResetUrlWithoutKeyword()" class="text-emerald-600 hover:text-emerald-900 ml-0.5" title="Bỏ từ khóa"><i class="bi bi-x-circle-fill"></i></a>
                            </span>
                        }
                        @if (Model.Category.HasValue)
                        {
                            <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded-lg font-semibold">
                                Nhóm: @Model.Category.Value
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.City))
                        {
                            <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded-lg font-semibold">
                                <i class="bi bi-geo-alt text-gray-500"></i> @Model.City
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Brand))
                        {
                            <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded-lg font-semibold">
                                Hãng: @Model.Brand
                            </span>
                        }
                        @if (Model.RequiresLicenseA1.HasValue)
                        {
                            <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded-lg font-semibold">
                                @(Model.RequiresLicenseA1.Value ? "Cần bằng A1" : "Miễn bằng A1")
                            </span>
                        }
                        @if (Model.MaxPrice.HasValue)
                        {
                            <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 border border-gray-200 px-2 py-0.5 rounded-lg font-semibold">
                                Dưới @Model.MaxPrice.Value.ToString("N0")đ
                            </span>
                        }
                    </div>

                    <a href="/Vehicles" class="text-rose-600 hover:text-rose-700 font-bold flex items-center gap-1 hover:underline ml-auto shrink-0">
                        <i class="bi bi-arrow-counterclockwise"></i> Xóa tất cả bộ lọc
                    </a>
                </div>
            }
            @if (!Model.Results.Any())
            {
                <div class="bg-white rounded-3xl p-12 text-center border border-gray-100 shadow-sm flex flex-col items-center justify-center">
                    <div class="w-16 h-16 bg-gray-50 text-gray-300 rounded-3xl flex items-center justify-center text-3xl mb-4">
                        <i class="bi bi-bicycle"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-800">Không tìm thấy xe máy điện phù hợp với bộ lọc</h3>
                    <p class="text-xs text-gray-400 mt-1 max-w-sm mx-auto">Vui lòng điều chỉnh hoặc xóa bớt tiêu chí lọc để xem thêm các mẫu xe khác.</p>
                    <a href="/Vehicles" class="mt-5 inline-block bg-emerald-50 text-emerald-700 font-bold text-xs px-5 py-2.5 rounded-xl border border-emerald-200 hover:bg-emerald-100 transition shadow-sm">
                        Xem tất cả xe sẵn có
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var car in Model.Results)
                    {
                        <div class="bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full group">
                            <div class="relative h-52 bg-gray-100 overflow-hidden">
                                <img src="@car.ThumbnailUrl" alt="@car.Brand @car.Model" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                
                                <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                                    @switch (car.Category)
                                    {
                                        case VehicleCategory.Economy:
                                            <span class="bg-emerald-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-mortarboard-fill"></i> Phổ Thông (Học Sinh/SV)
                                            </span>
                                            break;
                                        case VehicleCategory.MidRange:
                                            <span class="bg-blue-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-briefcase-fill"></i> Đô Thị Đi Làm
                                            </span>
                                            break;
                                        case VehicleCategory.Touring:
                                            <span class="bg-purple-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-compass-fill"></i> Đường Dài Pin Khủng
                                            </span>
                                            break;
                                        case VehicleCategory.SportPremium:
                                            <span class="bg-rose-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-full shadow flex items-center gap-1">
                                                <i class="bi bi-lightning-charge-fill"></i> Thể Thao Cao Cấp
                                            </span>
                                            break;
                                    }

                                    @if (!car.RequiresLicenseA1)
                                    {
                                        <span class="bg-cyan-500 text-white text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full shadow w-max">
                                            <i class="bi bi-check2-circle"></i> Miễn bằng lái A1
                                        </span>
                                    }
                                </div>

                                <span class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-xl">
                                    <i class="bi bi-geo-alt"></i> @car.District, @car.City
                                </span>
                            </div>

                            <div class="p-6 flex flex-col flex-grow justify-between text-center">
                                <div>
                                    <div class="flex items-center justify-center gap-2 text-xs text-gray-400 font-bold mb-1">
                                        <span class="uppercase">@car.Brand • @car.YearManufacture</span>
                                        <span class="text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md text-[11px]">@car.BatteryType</span>
                                    </div>
                                    <h3 class="text-lg font-black text-gray-900 group-hover:text-emerald-600 transition text-center">
                                        @car.Brand @car.Model
                                    </h3>
                                    <p class="text-xs text-gray-500 mt-1.5 line-clamp-2 leading-relaxed text-center px-1">
                                        @car.Description
                                    </p>
                                </div>

                                <div class="grid grid-cols-3 gap-2 text-center text-xs py-3 border-y border-gray-100 my-4 bg-gray-50/70 rounded-2xl px-2">
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="bi bi-battery-full text-emerald-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Cự ly pin</span>
                                        <span class="font-extrabold text-xs text-emerald-700">@car.BatteryRangeKm km</span>
                                    </div>
                                    <div class="flex flex-col items-center justify-center border-x border-gray-200">
                                        <i class="bi bi-speedometer2 text-blue-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Tốc độ max</span>
                                        <span class="font-extrabold text-xs text-blue-700">@car.MaxSpeedKmH km/h</span>
                                    </div>
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="bi bi-patch-check text-purple-600 text-base mb-0.5"></i>
                                        <span class="block text-[10px] text-gray-400 uppercase font-bold">Bằng lái</span>
                                        <span class="font-extrabold text-xs @(!car.RequiresLicenseA1 ? "text-emerald-700" : "text-gray-700")">
                                            @(!car.RequiresLicenseA1 ? "Miễn A1" : "Cần A1")
                                        </span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                                    <div class="text-left">
                                        <span class="text-xl font-black text-emerald-600">@car.PricePerDay.ToString("N0")</span>
                                        <span class="text-xs font-semibold text-gray-400">đ/ngày</span>
                                    </div>
                                    <a href="/Vehicles/Details/@car.Id" 
                                       class="bg-gray-900 hover:bg-emerald-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-md shadow-gray-900/10 flex items-center justify-center gap-1.5">
                                        <span>Chi tiết</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleMobileFilters() {
            const sidebar = document.getElementById('filterSidebar');
            const icon = document.getElementById('filterArrowIcon');
            if (sidebar) {
                sidebar.classList.toggle('hidden');
                if (icon) {
                    icon.classList.toggle('bi-chevron-down');
                    icon.classList.toggle('bi-chevron-up');
                }
            }
        }

        function quickSearch(keyword) {
            const input = document.getElementById('keywordSearchInput');
            if (input) {
                input.value = keyword;
                input.form.submit();
            }
        }
    </script>
}
