@page "/Vehicles/Details/{id:int}"
@model MiotoCarRental.ViewModels.VehicleDetailViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = $"{Model.Vehicle.Brand} {Model.Vehicle.Model} - Chi tiết xe máy điện";
    var v = Model.Vehicle;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="text-xs font-bold text-gray-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-emerald-600">Trang chủ</a>
        <i class="bi bi-chevron-right text-[10px]"></i>
        <a href="/Vehicles" class="hover:text-emerald-600">Xe máy điện</a>
        <i class="bi bi-chevron-right text-[10px]"></i>
        <span class="text-gray-700">@v.Brand @v.Model</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
            <div class="rounded-3xl overflow-hidden bg-gray-100 shadow-md h-96 relative">
                <img src="@v.ThumbnailUrl" alt="@v.Brand @v.Model" class="w-full h-full object-cover" />
                @if (!v.RequiresLicenseA1)
                {
                    <span class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-extrabold uppercase px-3 py-1.5 rounded-full shadow flex items-center gap-1.5">
                        <i class="bi bi-check-circle-fill"></i> Miễn bằng lái A1
                    </span>
                }
                else
                {
                    <span class="absolute top-4 left-4 bg-emerald-600 text-white text-xs font-extrabold uppercase px-3 py-1.5 rounded-full shadow flex items-center gap-1.5">
                        <i class="bi bi-lightning-fill"></i> Đặt xe nhanh
                    </span>
                }
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">@v.Brand • Đời @v.YearManufacture</span>
                        <h1 class="text-3xl font-black text-gray-900 mt-1">@v.Brand @v.Model</h1>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-black text-emerald-600">@v.PricePerDay.ToString("N0") đ</span>
                        <span class="text-xs text-gray-400 block font-semibold">/ngày</span>
                    </div>
                </div>

                <div class="flex items-center gap-4 mt-4 text-xs font-bold text-gray-500">
                    <span class="flex items-center gap-1"><i class="bi bi-star-fill text-yellow-400"></i> @Model.AverageRating.ToString("0.0")</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><i class="bi bi-battery-charging text-emerald-600"></i> @v.BatteryType</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><i class="bi bi-geo-alt text-gray-400"></i> @v.Address, @v.City</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-8 border-t border-gray-100">
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-battery-full text-emerald-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Cự ly 1 lần sạc</span>
                        <span class="font-black text-emerald-700 text-sm">@v.BatteryRangeKm km</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-speedometer2 text-blue-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Tốc độ tối đa</span>
                        <span class="font-black text-blue-700 text-sm">@v.MaxSpeedKmH km/h</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-card-checklist text-purple-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Yêu cầu GPLX</span>
                        <span class="font-black text-gray-800 text-sm">@(v.RequiresLicenseA1 ? "Cần bằng A1" : "Miễn bằng lái")</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-geo text-amber-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Giới hạn km</span>
                        <span class="font-black text-gray-800 text-sm">@v.LimitKmPerDay km/ngày</span>
                    </div>
                </div>

                <div class="mt-8">
                    <h3 class="font-bold text-gray-900 text-base mb-2">Đặc điểm xe máy điện</h3>
                    <p class="text-sm text-gray-600 leading-relaxed">@v.Description</p>
                </div>

                <div class="mt-8 p-5 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs text-emerald-900 space-y-2">
                    <div class="font-bold flex items-center gap-1.5 text-sm mb-1 text-emerald-950">
                        <i class="bi bi-info-circle-fill text-emerald-600"></i> Chính sách & Phụ phí thuê xe máy điện:
                    </div>
                    <div>• Tặng kèm: <strong>02 nón bảo hiểm đạt chuẩn + 01 củ sạc di động chính hãng</strong>.</div>
                    <div>• Phí vượt quãng đường: <strong>@v.OverKmFee.ToString("N0") đ / km</strong> (khi chạy quá @v.LimitKmPerDay km/ngày).</div>
                    <div>• Trả xe trễ hạn: <strong>@v.LateReturnFeePerHour.ToString("N0") đ / giờ</strong>.</div>
                    <div>• Giấy tờ thế chấp: <strong>CCCD bản gốc hoặc tiền cọc 2.000.000 đ</strong> (hoàn lại 100% khi trả xe).</div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100" class="w-14 h-14 rounded-full object-cover ring-2 ring-emerald-500" />
                    <div>
                        <span class="text-xs text-gray-400 font-bold uppercase">Chủ xe đối tác</span>
                        <h4 class="font-bold text-gray-900 text-base">@(v.Host?.FullName ?? "Nguyễn Văn Chủ Xe")</h4>
                        <div class="text-xs text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                            <i class="bi bi-shield-fill-check"></i> Đã xác thực CCCD & Cà vẹt xe máy điện
                        </div>
                    </div>
                </div>
                <div class="text-right text-xs text-gray-500 font-semibold">
                    <div>Tỉ lệ phản hồi: <strong class="text-gray-900">100%</strong></div>
                    <div>Thời gian phản hồi: <strong class="text-gray-900">Nhanh chóng</strong></div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                <h3 class="font-black text-gray-900 text-lg mb-4 flex items-center gap-2">
                    <i class="bi bi-chat-quote-fill text-emerald-600"></i> Đánh giá từ khách thuê (@Model.Reviews.Count)
                </h3>
                @if (!Model.Reviews.Any())
                {
                    <p class="text-sm text-gray-400 italic">Chưa có đánh giá nào cho chiếc xe này.</p>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="p-4 bg-gray-50 rounded-2xl">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-bold text-sm text-gray-800">@r.Reviewer.FullName</span>
                                    <div class="text-yellow-400 text-xs">
                                        @for (int i = 0; i < r.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600">@r.Comment</p>
                                <span class="text-[10px] text-gray-400 mt-2 block">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-1">
            <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-xl sticky top-28">
                <h3 class="text-xl font-black text-gray-900 mb-6">Đặt thuê xe máy điện</h3>

                <form action="/Bookings/Create" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="VehicleId" value="@v.Id" />

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">
                            <i class="bi bi-calendar-event text-emerald-600"></i> Ngày & Giờ nhận xe
                        </label>
                        <input type="datetime-local" name="StartTime" 
                               value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddT08:00")" 
                               class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-2.5 text-xs font-semibold text-gray-800" required />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">
                            <i class="bi bi-calendar2-check text-emerald-600"></i> Ngày & Giờ trả xe
                        </label>
                        <input type="datetime-local" name="EndTime" 
                               value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-ddT20:00")" 
                               class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-2.5 text-xs font-semibold text-gray-800" required />
                    </div>

                    <div class="pt-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" name="NeedsDelivery" value="true" class="w-4 h-4 text-emerald-600 rounded" />
                            <span class="text-xs font-bold text-gray-700">Giao xe tận nơi (+30.000 đ)</span>
                        </label>
                    </div>

                    <div>
                        <textarea name="Note" rows="2" placeholder="Ghi chú (yêu cầu thêm nón bảo hiểm size nhỏ...)" 
                                  class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-semibold text-gray-800 focus:outline-none"></textarea>
                    </div>

                    <div class="pt-4 border-t border-gray-100 space-y-2 text-xs">
                        <div class="flex justify-between text-gray-600">
                            <span>Đơn giá ngày:</span>
                            <span class="font-bold text-gray-800">@v.PricePerDay.ToString("N0") đ/ngày</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Bảo hiểm xe máy điện:</span>
                            <span class="font-bold text-gray-800">15.000 đ/ngày</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Cọc giữ chỗ quy định:</span>
                            <span class="font-bold text-emerald-600">30% tổng tiền</span>
                        </div>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                            <i class="bi bi-lightning-charge-fill"></i>
                            ĐẶT THUÊ XE NGAY
                        </button>
                        <p class="text-[10px] text-gray-400 text-center mt-2 font-medium">
                            Chưa trừ tiền ngay. Bạn sẽ quét mã VietQR cọc 30% ở bước tiếp theo.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
