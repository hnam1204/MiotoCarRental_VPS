@page "/Vehicles/Details/{id:int}"
@model MiotoCarRental.ViewModels.VehicleDetailViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = $"{Model.Vehicle.Brand} {Model.Vehicle.Model} - Chi tiết xe máy điện";
    var v = Model.Vehicle;

    var mainImage = !string.IsNullOrWhiteSpace(v.ThumbnailUrl) 
        ? v.ThumbnailUrl 
        : "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1000";

    var gallery = new List<(string Url, string Label, string Icon)>();
    gallery.Add((mainImage, "Góc nghiêng 3/4 thân xe", "bi-bicycle"));

    if (v.Images != null && v.Images.Any())
    {
        foreach (var img in v.Images.Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl) && i.ImageUrl != mainImage))
        {
            gallery.Add((img.ImageUrl, "Ảnh chi tiết xe thực tế", "bi-camera"));
        }
    }

    if (gallery.Count < 4)
    {
        gallery.Add(("https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?w=1000", "Góc nghiêng trực diện & Đèn LED", "bi-eye"));
        gallery.Add(("https://images.unsplash.com/photo-1517524008697-84bbe3c3fd98?w=1000", "Đồng hồ LCD & Ghi đông tay lái", "bi-speedometer2"));
        gallery.Add(("https://images.unsplash.com/photo-1558981359-219d6364c9c8?w=1000", "Khung gầm & Cụm pin LFP an toàn", "bi-battery-charging"));
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24 lg:pb-8">
    <nav class="text-xs font-bold text-gray-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-emerald-600">Trang chủ</a>
        <i class="bi bi-chevron-right text-[10px]"></i>
        <a href="/Vehicles" class="hover:text-emerald-600">Xe máy điện</a>
        <i class="bi bi-chevron-right text-[10px]"></i>
        <span class="text-gray-700">@v.Brand @v.Model</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
            <!-- Modern Photo Gallery with Thumbnails -->
            <div class="space-y-3">
                <!-- Khung hiển thị ảnh chính -->
                <div class="relative rounded-3xl overflow-hidden bg-gray-950 shadow-xl h-80 sm:h-96 md:h-[420px] group select-none">
                    <img id="mainVehicleImage" 
                         src="@gallery[0].Url" 
                         alt="@v.Brand @v.Model" 
                         class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 cursor-pointer" 
                         onclick="openLightbox()" 
                         title="Bấm để xem ảnh phóng to toàn màn hình" />

                    <!-- Lớp phủ Gradient mờ ở chân ảnh -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

                    <!-- Huy hiệu phía trên bên trái -->
                    <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2 pointer-events-none">
                        @if (!v.RequiresLicenseA1)
                        {
                            <span class="bg-blue-600/90 backdrop-blur-md text-white text-xs font-black uppercase px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
                                <i class="bi bi-patch-check-fill text-yellow-300"></i> Miễn bằng lái A1
                            </span>
                        }
                        else
                        {
                            <span class="bg-emerald-600/90 backdrop-blur-md text-white text-xs font-black uppercase px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
                                <i class="bi bi-shield-check"></i> Cần bằng A1
                            </span>
                        }

                        @if (v.InstantBooking)
                        {
                            <span class="bg-amber-500/90 backdrop-blur-md text-white text-xs font-bold uppercase px-2.5 py-1.5 rounded-full shadow-lg flex items-center gap-1">
                                <i class="bi bi-lightning-fill"></i> Đặt xe nhanh
                            </span>
                        }
                    </div>

                    <!-- Nút xem toàn màn hình (Fullscreen) phía trên bên phải -->
                    <div class="absolute top-4 right-4 flex items-center gap-2">
                        <button type="button" onclick="openLightbox()" class="bg-black/40 hover:bg-black/70 backdrop-blur-md text-white text-xs font-semibold px-3 py-1.5 rounded-xl border border-white/20 shadow-md transition flex items-center gap-1.5">
                            <i class="bi bi-arrows-fullscreen"></i>
                            <span class="hidden sm:inline">Phóng to</span>
                        </button>
                    </div>

                    <!-- Mũi tên điều hướng Trước / Sau -->
                    <button type="button" onclick="prevGalleryImage(event)" aria-label="Ảnh trước" 
                            class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/85 hover:bg-white text-gray-800 shadow-xl flex items-center justify-center transition-all opacity-80 sm:opacity-0 group-hover:opacity-100 hover:scale-110 active:scale-95">
                        <i class="bi bi-chevron-left text-base font-bold"></i>
                    </button>
                    <button type="button" onclick="nextGalleryImage(event)" aria-label="Ảnh tiếp theo" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/85 hover:bg-white text-gray-800 shadow-xl flex items-center justify-center transition-all opacity-80 sm:opacity-0 group-hover:opacity-100 hover:scale-110 active:scale-95">
                        <i class="bi bi-chevron-right text-base font-bold"></i>
                    </button>

                    <!-- Chú thích góc chụp & Bộ đếm ảnh phía dưới -->
                    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white pointer-events-none text-xs">
                        <span id="currentImageLabel" class="bg-black/50 backdrop-blur-md px-3 py-1 rounded-xl font-bold flex items-center gap-1.5 border border-white/10">
                            <i class="bi bi-bicycle text-emerald-400"></i> @gallery[0].Label
                        </span>
                        <span id="galleryCounter" class="bg-black/50 backdrop-blur-md px-3 py-1 rounded-xl font-bold border border-white/10">
                            1 / @gallery.Count ảnh
                        </span>
                    </div>
                </div>

                <!-- Dải ảnh nhỏ Thumbnails -->
                <div class="grid grid-cols-4 gap-2 sm:gap-3" id="galleryThumbnailsContainer">
                    @for (int i = 0; i < gallery.Count; i++)
                    {
                        var item = gallery[i];
                        var isFirst = i == 0;
                        <button type="button" 
                                onclick="selectGalleryImage(this, '@item.Url', '@item.Label', @i)" 
                                class="gallery-thumb-btn relative rounded-2xl overflow-hidden aspect-[4/3] bg-gray-100 border-2 transition-all duration-200 group focus:outline-none @(isFirst ? "border-emerald-600 ring-2 ring-emerald-500/30 scale-[1.02] shadow-md" : "border-transparent opacity-70 hover:opacity-100 hover:border-gray-300")">
                            <img src="@item.Url" alt="@item.Label" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition"></div>
                            <span class="hidden sm:flex absolute bottom-1 left-1 right-1 bg-black/60 backdrop-blur-sm text-white text-[10px] font-semibold px-1.5 py-0.5 rounded truncate items-center gap-1">
                                <i class="bi @item.Icon text-[9px] text-emerald-300"></i>
                                <span class="truncate">@item.Label</span>
                            </span>
                        </button>
                    }
                </div>
            </div>

            <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">@v.Brand • Đời @v.YearManufacture</span>
                        <h1 class="text-3xl font-black text-gray-900 mt-1">@v.Brand @v.Model</h1>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-black text-emerald-600">@v.PricePerDay.ToString("N0") đ</span>
                        <span class="text-xs text-gray-400 block font-semibold">/ngày</span>
                    </div>
                </div>

                <div class="flex items-center gap-4 mt-4 text-xs font-bold text-gray-500">
                    <span class="flex items-center gap-1"><i class="bi bi-star-fill text-yellow-400"></i> @Model.AverageRating.ToString("0.0")</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><i class="bi bi-battery-charging text-emerald-600"></i> @v.BatteryType</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><i class="bi bi-geo-alt text-gray-400"></i> @v.Address, @v.City</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-8 border-t border-gray-100">
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-battery-full text-emerald-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Cự ly 1 lần sạc</span>
                        <span class="font-black text-emerald-700 text-sm">@v.BatteryRangeKm km</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-speedometer2 text-blue-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Tốc độ tối đa</span>
                        <span class="font-black text-blue-700 text-sm">@v.MaxSpeedKmH km/h</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-card-checklist text-purple-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Yêu cầu GPLX</span>
                        <span class="font-black text-gray-800 text-sm">@(v.RequiresLicenseA1 ? "Cần bằng A1" : "Miễn bằng lái")</span>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-2xl flex flex-col items-center justify-center text-center">
                        <i class="bi bi-geo text-amber-600 text-2xl mb-1"></i>
                        <span class="text-gray-400 text-[11px] font-bold uppercase block mb-1">Giới hạn km</span>
                        <span class="font-black text-gray-800 text-sm">@v.LimitKmPerDay km/ngày</span>
                    </div>
                </div>

                <div class="mt-8">
                    <h3 class="font-bold text-gray-900 text-base mb-2">Đặc điểm xe máy điện</h3>
                    <p class="text-sm text-gray-600 leading-relaxed">@v.Description</p>
                </div>

                <div class="mt-8 p-5 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs text-emerald-900 space-y-2">
                    <div class="font-bold flex items-center gap-1.5 text-sm mb-1 text-emerald-950">
                        <i class="bi bi-info-circle-fill text-emerald-600"></i> Chính sách & Phụ phí thuê xe máy điện:
                    </div>
                    <div>• Tặng kèm: <strong>02 nón bảo hiểm đạt chuẩn + 01 củ sạc di động chính hãng</strong>.</div>
                    <div>• Phí vượt quãng đường: <strong>@v.OverKmFee.ToString("N0") đ / km</strong> (khi chạy quá @v.LimitKmPerDay km/ngày).</div>
                    <div>• Trả xe trễ hạn: <strong>@v.LateReturnFeePerHour.ToString("N0") đ / giờ</strong>.</div>
                    <div>• Giấy tờ thế chấp: <strong>CCCD bản gốc hoặc tiền cọc 2.000.000 đ</strong> (hoàn lại 100% khi trả xe).</div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100" class="w-14 h-14 rounded-full object-cover ring-2 ring-emerald-500" />
                    <div>
                        <span class="text-xs text-gray-400 font-bold uppercase">Chủ xe đối tác</span>
                        <h4 class="font-bold text-gray-900 text-base">@(v.Host?.FullName ?? "Nguyễn Văn Chủ Xe")</h4>
                        <div class="text-xs text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                            <i class="bi bi-shield-fill-check"></i> Đã xác thực CCCD & Cà vẹt xe máy điện
                        </div>
                    </div>
                </div>
                <div class="text-right text-xs text-gray-500 font-semibold">
                    <div>Tỉ lệ phản hồi: <strong class="text-gray-900">100%</strong></div>
                    <div>Thời gian phản hồi: <strong class="text-gray-900">Nhanh chóng</strong></div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                <h3 class="font-black text-gray-900 text-lg mb-4 flex items-center gap-2">
                    <i class="bi bi-chat-quote-fill text-emerald-600"></i> Đánh giá từ khách thuê (@Model.Reviews.Count)
                </h3>
                @if (!Model.Reviews.Any())
                {
                    <p class="text-sm text-gray-400 italic">Chưa có đánh giá nào cho chiếc xe này.</p>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="p-4 bg-gray-50 rounded-2xl">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-bold text-sm text-gray-800">@r.Reviewer.FullName</span>
                                    <div class="text-yellow-400 text-xs">
                                        @for (int i = 0; i < r.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600">@r.Comment</p>
                                <span class="text-[10px] text-gray-400 mt-2 block">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-1">
            <div id="bookingFormCard" class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-xl sticky top-28 transition-all">
                <h3 class="text-xl font-black text-gray-900 mb-6">Đặt thuê xe máy điện</h3>

                <form action="/Bookings/Create" method="post" class="space-y-4">
                    <input type="hidden" name="VehicleId" value="@v.Id" />

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">
                            <i class="bi bi-calendar-event text-emerald-600"></i> Ngày &amp; Giờ nhận xe
                        </label>
                        <input type="datetime-local" id="bookingStartTime" name="StartTime" 
                               value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddT08:00")" 
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                               oninput="calculateLivePrice()" onchange="calculateLivePrice()"
                               class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-2.5 text-xs font-semibold text-gray-800" required />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">
                            <i class="bi bi-calendar2-check text-emerald-600"></i> Ngày &amp; Giờ trả xe
                        </label>
                        <input type="datetime-local" id="bookingEndTime" name="EndTime" 
                               value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-ddT20:00")" 
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                               oninput="calculateLivePrice()" onchange="calculateLivePrice()"
                               class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-2.5 text-xs font-semibold text-gray-800" required />
                    </div>

                    <div id="dateErrorMsg" class="hidden p-2.5 bg-red-50 text-red-700 text-xs rounded-xl font-semibold flex items-center gap-1.5">
                        <i class="bi bi-exclamation-circle-fill"></i> Thời gian trả xe phải sau thời gian nhận xe ít nhất 1 giờ.
                    </div>

                    <div class="pt-1">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="needsDeliveryCheckbox" name="NeedsDelivery" value="true" onchange="calculateLivePrice()" class="w-4 h-4 text-emerald-600 rounded" />
                            <span class="text-xs font-bold text-gray-700">Giao xe tận nơi (+30.000 đ)</span>
                        </label>
                    </div>

                    <div>
                        <textarea name="Note" rows="2" placeholder="Ghi chú (yêu cầu thêm nón bảo hiểm size nhỏ...)" 
                                  class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-semibold text-gray-800 focus:outline-none"></textarea>
                    </div>

                    <!-- Bảng tính toán tạm tính Real-time -->
                    <div class="pt-4 border-t border-gray-100 space-y-2 text-xs">
                        <div class="flex justify-between text-gray-500">
                            <span>Thời gian thuê tạm tính:</span>
                            <strong id="liveTotalDays" class="text-emerald-700 font-bold">2 ngày</strong>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Tiền thuê xe:</span>
                            <span id="liveRentalFee" class="font-bold text-gray-800">@((v.PricePerDay * 2).ToString("N0")) đ</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Bảo hiểm xe máy điện:</span>
                            <span id="liveInsuranceFee" class="font-bold text-gray-800">30.000 đ</span>
                        </div>
                        <div id="liveDeliveryRow" class="hidden flex justify-between text-gray-600">
                            <span>Phí giao xe tận nơi:</span>
                            <span id="liveDeliveryFee" class="font-bold text-gray-800">30.000 đ</span>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-gray-900 pt-1.5 border-t border-gray-100">
                            <span>Tổng chi phí dự kiến:</span>
                            <span id="liveTotalAmount" class="text-sm font-black text-gray-900">@(((v.PricePerDay * 2) + 30000).ToString("N0")) đ</span>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-emerald-800 bg-emerald-50 p-2.5 rounded-xl border border-emerald-200">
                            <span>Cọc 30% giữ xe (thanh toán online):</span>
                            <span id="liveDepositAmount" class="text-sm font-black text-emerald-700">@((Math.Round(((v.PricePerDay * 2) + 30000) * 0.3m)).ToString("N0")) đ</span>
                        </div>
                    </div>

                    <div class="pt-3">
                        <button type="submit" id="submitBookingBtn" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                            <i class="bi bi-lightning-charge-fill"></i>
                            ĐẶT THUÊ XE NGAY
                        </button>
                        <p class="text-[10px] text-gray-400 text-center mt-2 font-medium">
                            Chưa trừ tiền ngay. Bạn sẽ quét mã VietQR cọc 30% ở bước tiếp theo.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Sticky Mobile Booking Bar (Ghim cố định đáy màn hình trên điện thoại di động) -->
<div id="stickyMobileBookingBar" class="lg:hidden fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-gray-200 px-4 py-3 z-40 shadow-[0_-4px_25px_rgba(0,0,0,0.12)] flex items-center justify-between transition-transform duration-300">
    <div class="flex flex-col">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Đơn giá thuê</span>
        <div class="flex items-baseline gap-1">
            <span class="text-xl font-black text-emerald-600">@v.PricePerDay.ToString("N0") đ</span>
            <span class="text-xs text-gray-500 font-semibold">/ ngày</span>
        </div>
        <span class="text-[10px] text-gray-500 font-medium flex items-center gap-1">
            <i class="bi bi-shield-check text-emerald-600"></i> @(v.RequiresLicenseA1 ? "Cần bằng A1" : "Miễn bằng A1")
        </span>
    </div>
    <div class="flex items-center gap-2">
        <button type="button" onclick="scrollToBookingForm()" class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs px-5 py-3 rounded-2xl shadow-lg shadow-emerald-600/30 transition flex items-center gap-1.5 whitespace-nowrap">
            <i class="bi bi-lightning-charge-fill text-yellow-300"></i>
            <span>ĐẶT XE NGAY</span>
        </button>
    </div>
</div>

<!-- Lightbox Modal Phóng to ảnh xe máy điện -->
<div id="imageLightboxModal" class="hidden fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300 select-none" onclick="closeLightbox(event)">
    <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center" onclick="event.stopPropagation()">
        <!-- Thanh công cụ Lightbox -->
        <div class="w-full flex items-center justify-between text-white mb-3 px-2">
            <span id="lightboxTitle" class="text-sm font-bold text-gray-200">@v.Brand @v.Model</span>
            <div class="flex items-center gap-3">
                <span id="lightboxCounter" class="text-xs text-gray-400 font-semibold">1 / @gallery.Count ảnh</span>
                <button type="button" onclick="closeLightbox()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition focus:outline-none">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>
        </div>

        <!-- Ảnh phóng to trung tâm -->
        <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl bg-black">
            <img id="lightboxImage" src="@gallery[0].Url" alt="@v.Brand @v.Model" class="w-full max-h-[75vh] object-contain mx-auto transition-opacity duration-200" />
            
            <button type="button" onclick="prevGalleryImage(event)" class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/20 hover:bg-white/40 text-white flex items-center justify-center backdrop-blur-md transition focus:outline-none hover:scale-105 active:scale-95">
                <i class="bi bi-chevron-left text-lg"></i>
            </button>
            <button type="button" onclick="nextGalleryImage(event)" class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/20 hover:bg-white/40 text-white flex items-center justify-center backdrop-blur-md transition focus:outline-none hover:scale-105 active:scale-95">
                <i class="bi bi-chevron-right text-lg"></i>
            </button>
        </div>

        <p id="lightboxCaption" class="text-xs text-gray-300 mt-2.5 text-center font-medium">@gallery[0].Label</p>
    </div>
</div>

@section Scripts {
    <script>
        const unitPricePerDay = @((long)v.PricePerDay);
        const unitInsuranceFeePerDay = 15000;
        const fixedDeliveryFee = 30000;

        // Dữ liệu bộ sưu tập hình ảnh xe
        const galleryData = [
            @for (int i = 0; i < gallery.Count; i++)
            {
                <text>{ url: '@gallery[i].Url', label: '@gallery[i].Label' }@(i < gallery.Count - 1 ? "," : "")</text>
            }
        ];

        let currentGalleryIndex = 0;

        function selectGalleryImage(btn, url, label, index) {
            const mainImg = document.getElementById('mainVehicleImage');
            const labelEl = document.getElementById('currentImageLabel');
            const counterEl = document.getElementById('galleryCounter');
            const lightboxImg = document.getElementById('lightboxImage');
            const lightboxCaption = document.getElementById('lightboxCaption');
            const lightboxCounter = document.getElementById('lightboxCounter');

            if (!mainImg) return;

            // Hiệu ứng mờ dần và chuyển ảnh
            mainImg.style.opacity = '0.35';
            setTimeout(() => {
                mainImg.src = url;
                mainImg.style.opacity = '1';
            }, 120);

            if (labelEl) labelEl.innerHTML = `<i class="bi bi-camera text-emerald-400"></i> ${label}`;
            if (counterEl) counterEl.textContent = `${index + 1} / ${galleryData.length} ảnh`;
            if (lightboxImg) lightboxImg.src = url;
            if (lightboxCaption) lightboxCaption.textContent = label;
            if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${galleryData.length} ảnh`;

            currentGalleryIndex = index;

            // Cập nhật trạng thái viền thumbnail
            const buttons = document.querySelectorAll('.gallery-thumb-btn');
            buttons.forEach((b, i) => {
                if (i === index) {
                    b.classList.remove('border-transparent', 'opacity-70');
                    b.classList.add('border-emerald-600', 'ring-2', 'ring-emerald-500/30', 'scale-[1.02]', 'opacity-100', 'shadow-md');
                } else {
                    b.classList.remove('border-emerald-600', 'ring-2', 'ring-emerald-500/30', 'scale-[1.02]', 'opacity-100', 'shadow-md');
                    b.classList.add('border-transparent', 'opacity-70');
                }
            });
        }

        function nextGalleryImage(e) {
            if (e) e.stopPropagation();
            let nextIdx = (currentGalleryIndex + 1) % galleryData.length;
            const buttons = document.querySelectorAll('.gallery-thumb-btn');
            if (buttons[nextIdx]) buttons[nextIdx].click();
        }

        function prevGalleryImage(e) {
            if (e) e.stopPropagation();
            let prevIdx = (currentGalleryIndex - 1 + galleryData.length) % galleryData.length;
            const buttons = document.querySelectorAll('.gallery-thumb-btn');
            if (buttons[prevIdx]) buttons[prevIdx].click();
        }

        function openLightbox() {
            const modal = document.getElementById('imageLightboxModal');
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeLightbox(e) {
            if (e && e.target !== e.currentTarget && !e.target.closest('button')) return;
            const modal = document.getElementById('imageLightboxModal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        function scrollToBookingForm() {
            const formCard = document.getElementById('bookingFormCard');
            if (formCard) {
                formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                const startInput = document.getElementById('bookingStartTime');
                if (startInput) {
                    setTimeout(() => {
                        startInput.focus();
                        startInput.classList.add('ring-2', 'ring-emerald-500');
                        setTimeout(() => startInput.classList.remove('ring-2', 'ring-emerald-500'), 1500);
                    }, 500);
                }
            }
        }

        // Bấm phím Escape để đóng Lightbox và phím mũi tên để chuyển ảnh
        document.addEventListener('keydown', function (e) {
            const modal = document.getElementById('imageLightboxModal');
            const isModalOpen = modal && !modal.classList.contains('hidden');
            if (e.key === 'Escape' && isModalOpen) {
                closeLightbox();
            } else if (e.key === 'ArrowRight') {
                nextGalleryImage();
            } else if (e.key === 'ArrowLeft') {
                prevGalleryImage();
            }
        });

        function calculateLivePrice() {
            const startInput = document.getElementById('bookingStartTime');
            const endInput = document.getElementById('bookingEndTime');
            const deliveryCheckbox = document.getElementById('needsDeliveryCheckbox');
            const errorMsg = document.getElementById('dateErrorMsg');
            const submitBtn = document.getElementById('submitBookingBtn');

            if (!startInput || !endInput) return;

            const startDate = new Date(startInput.value);
            const endDate = new Date(endInput.value);

            if (isNaN(startDate.getTime()) || isNaN(endDate.getTime()) || endDate <= startDate) {
                if (errorMsg) errorMsg.classList.remove('hidden');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                }
                return;
            }

            if (errorMsg) errorMsg.classList.add('hidden');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }

            const diffMs = endDate.getTime() - startDate.getTime();
            const diffHours = diffMs / (1000 * 60 * 60);
            let totalDays = Math.ceil(diffHours / 24);
            if (totalDays < 1) totalDays = 1;

            const isDelivery = deliveryCheckbox ? deliveryCheckbox.checked : false;
            const rentalFee = unitPricePerDay * totalDays;
            const insuranceFee = unitInsuranceFeePerDay * totalDays;
            const deliveryFee = isDelivery ? fixedDeliveryFee : 0;
            const totalAmount = rentalFee + insuranceFee + deliveryFee;
            const depositAmount = Math.round(totalAmount * 0.3);

            const daysEl = document.getElementById('liveTotalDays');
            if (daysEl) daysEl.innerText = totalDays + ' ngày';

            const rentalEl = document.getElementById('liveRentalFee');
            if (rentalEl) rentalEl.innerText = rentalFee.toLocaleString('vi-VN') + ' đ';

            const insuranceEl = document.getElementById('liveInsuranceFee');
            if (insuranceEl) insuranceEl.innerText = insuranceFee.toLocaleString('vi-VN') + ' đ';

            const deliveryRow = document.getElementById('liveDeliveryRow');
            if (deliveryRow) {
                if (isDelivery) {
                    deliveryRow.classList.remove('hidden');
                } else {
                    deliveryRow.classList.add('hidden');
                }
            }

            const totalEl = document.getElementById('liveTotalAmount');
            if (totalEl) totalEl.innerText = totalAmount.toLocaleString('vi-VN') + ' đ';

            const depositEl = document.getElementById('liveDepositAmount');
            if (depositEl) depositEl.innerText = depositAmount.toLocaleString('vi-VN') + ' đ';
        }

        document.addEventListener('DOMContentLoaded', function () {
            calculateLivePrice();
        });
    </script>
}
