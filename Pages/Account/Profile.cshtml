@page "/Account/Profile"
@model MiotoCarRental.ViewModels.ProfileViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Hồ sơ cá nhân & GPLX";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900">Hồ sơ cá nhân & Xác thực GPLX</h1>
        <p class="text-xs text-gray-500 mt-1">Quản lý thông tin tài khoản và trạng thái giấy phép lái xe để đặt thuê xe máy điện</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm text-center space-y-4">
            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200" 
                 class="w-24 h-24 rounded-full mx-auto ring-4 ring-emerald-500 object-cover shadow-md" />
            <div>
                <h3 class="text-lg font-black text-gray-900">@Model.FullName</h3>
                <span class="inline-block bg-gray-100 text-gray-600 text-[10px] font-bold px-2.5 py-0.5 rounded-full mt-1">
                    Vai trò: @Model.Role
                </span>
            </div>

            <div class="text-left border-t border-gray-100 pt-4 space-y-2 text-xs">
                <div>
                    <span class="text-gray-400 block">Email:</span>
                    <strong class="text-gray-800">@Model.Email</strong>
                </div>
                <div>
                    <span class="text-gray-400 block">Số điện thoại:</span>
                    <strong class="text-gray-800">@Model.Phone</strong>
                </div>
            </div>

            <form action="/Account/Logout" method="post" class="pt-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-bold text-xs py-2.5 rounded-xl transition flex items-center justify-center gap-1.5">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất tài khoản
                </button>
            </form>
        </div>

        <div class="md:col-span-2 bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                <div>
                    <h3 class="text-xl font-black text-gray-900">Giấy phép lái xe (GPLX)</h3>
                    <p class="text-xs text-gray-400">Yêu cầu bắt buộc để trở thành tài xế hợp lệ</p>
                </div>
                <div>
                    @switch (Model.DriverLicenseStatus)
                    {
                        case DriverLicenseStatus.Approved:
                            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-300 flex items-center gap-1">
                                <i class="bi bi-patch-check-fill text-emerald-600"></i> Đã phê duyệt
                            </span>
                            break;
                        case DriverLicenseStatus.Pending:
                            <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-300">
                                <i class="bi bi-hourglass-split"></i> Đang chờ duyệt
                            </span>
                            break;
                        default:
                            <span class="bg-gray-100 text-gray-700 text-xs font-bold px-3 py-1.5 rounded-full">
                                Chưa xác thực
                            </span>
                            break;
                    }
                </div>
            </div>

            <form action="/Account/UpdateLicense" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-card-heading text-emerald-600 mr-1"></i> Số Giấy Phép Lái Xe
                    </label>
                    <input type="text" name="licenseNo" value="@Model.DriverLicenseNo" placeholder="vd: 790123456789" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800" required />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-image text-emerald-600 mr-1"></i> Link ảnh chụp mặt trước bằng lái
                    </label>
                    <input type="text" name="licenseImageUrl" value="@Model.DriverLicenseImage" placeholder="https://..." 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800" />
                </div>

                <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs text-emerald-800 flex items-start gap-3">
                    <i class="bi bi-info-circle-fill text-emerald-600 text-lg flex-shrink-0"></i>
                    <div>
                        <strong class="font-bold">Lưu ý đồ án:</strong> Khi bấm cập nhật, hệ thống sẽ tự động mô phỏng quy trình eKYC và chuyển trạng thái bằng lái sang <strong>Đã Phê Duyệt (Approved)</strong>.
                    </div>
                </div>

                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-3 px-6 rounded-2xl shadow-md transition">
                    <i class="bi bi-upload mr-1"></i> Cập nhật & Phê duyệt GPLX
                </button>
            </form>
        </div>
    </div>
</div>
