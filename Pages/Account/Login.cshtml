@page "/Account/Login"
@model MiotoCarRental.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="max-w-md mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white rounded-xl p-6 sm:p-8 border border-gray-200 shadow-sm space-y-5">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Đăng nhập tài khoản</h1>
            <p class="text-xs text-gray-500 mt-1">Đăng nhập để đặt thuê xe hoặc quản lý phương tiện của bạn</p>
        </div>

        <form action="/Account/Login" method="post" id="loginForm" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 text-red-700 text-xs rounded-lg"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-gray-700 mb-1">Email</label>
                <input asp-for="Email" id="inputEmail" placeholder="Nhập địa chỉ email"
                       class="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-gray-700 mb-1">Mật khẩu</label>
                <div class="relative">
                    <input asp-for="Password" id="inputPassword" type="password" placeholder="Nhập mật khẩu"
                           class="w-full bg-white border border-gray-300 rounded-lg pl-3.5 pr-10 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600" />
                    <button type="button" onclick="togglePasswordVisibility()"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-sm">
                        <i id="passwordToggleIcon" class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center text-xs text-gray-600 cursor-pointer">
                    <input asp-for="RememberMe" class="w-4 h-4 text-emerald-600 rounded border-gray-300" />
                    <span class="ml-2">Duy trì đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-lg transition text-sm">
                Đăng nhập
            </button>
        </form>

        <!-- Quick test accounts -->
        <div class="pt-4 border-t border-gray-100 space-y-2.5">
            <div class="text-xs font-semibold text-gray-500">Tài khoản có sẵn (Chọn nhanh):</div>
            <div class="grid grid-cols-3 gap-2">
                <form action="/Account/QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="khachthue@gmail.com" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="w-full py-2 px-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium transition">
                        Khách thuê
                    </button>
                </form>
                <form action="/Account/QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="chuxe@gmail.com" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="w-full py-2 px-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium transition">
                        Chủ xe
                    </button>
                </form>
                <form action="/Account/QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="admin@mioto.vn" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="w-full py-2 px-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium transition">
                        Quản trị
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-xs text-gray-500 pt-1">
            Chưa có tài khoản?
            <a href="/Account/Register" class="font-semibold text-emerald-600 hover:underline">Đăng ký</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("inputPassword");
            var icon = document.getElementById("passwordToggleIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
