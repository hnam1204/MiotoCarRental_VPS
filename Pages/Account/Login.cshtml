@page "/Account/Login"
@model MiotoCarRental.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="max-w-md mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-md space-y-5">
        <div>
            <h1 class="text-xl font-black text-gray-900">Đăng nhập tài khoản</h1>
            <p class="text-xs text-gray-500 mt-1">Vui lòng nhập Email và Mật khẩu để tiếp tục</p>
        </div>

        <form action="/Account/Login" method="post" id="loginForm" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 text-red-700 text-xs rounded-xl border border-red-200"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-bold text-gray-700 mb-1">Địa chỉ Email</label>
                <div class="relative">
                    <input asp-for="Email" id="inputEmail" placeholder="vd: admin@mioto.vn hoặc email của bạn" required
                           class="w-full bg-gray-50 border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600 focus:bg-white transition" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-bold text-gray-700 mb-1">Mật khẩu</label>
                <div class="relative">
                    <input asp-for="Password" id="inputPassword" type="password" placeholder="Nhập mật khẩu của bạn" required
                           class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-emerald-600 focus:bg-white transition" />
                    <button type="button" onclick="togglePasswordVisibility()"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-sm">
                        <i id="passwordToggleIcon" class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center text-xs text-gray-600 cursor-pointer">
                    <input type="checkbox" id="RememberMe" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "") class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500" />
                    <span class="ml-2 font-medium">Duy trì đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3 px-4 rounded-xl shadow-lg shadow-emerald-600/30 transition text-sm flex items-center justify-center gap-1.5">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>ĐĂNG NHẬP</span>
            </button>
        </form>

        <div class="pt-4 border-t border-gray-100 space-y-2">
            <div class="p-3 bg-emerald-50/70 border border-emerald-200/80 rounded-xl text-xs text-emerald-900 space-y-1">
                <div class="font-bold flex items-center gap-1.5 text-emerald-800">
                    <i class="bi bi-shield-check text-emerald-600"></i> Xác thực bảo mật:
                </div>
                <p class="text-[11px] text-emerald-700">
                    Hệ thống yêu cầu nhập đầy đủ Email và Mật khẩu. Tất cả mật khẩu được mã hóa an toàn theo tiêu chuẩn ASP.NET Core Identity.
                </p>
            </div>
        </div>

        <p class="text-center text-xs text-gray-500 pt-1">
            Chưa có tài khoản?
            <a href="/Account/Register" class="font-bold text-emerald-600 hover:underline">Đăng ký ngay</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("inputPassword");
            var icon = document.getElementById("passwordToggleIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
