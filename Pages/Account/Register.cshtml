@page "/Account/Register"
@model MiotoCarRental.ViewModels.RegisterViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="max-w-lg mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-xl space-y-6">
        <div class="text-center space-y-2">
            <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto text-2xl shadow-sm">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900">Đăng ký thành viên</h1>
            <p class="text-xs text-gray-500">Tạo tài khoản EcoBike để bắt đầu hành trình thuê hoặc cho thuê xe máy điện</p>
        </div>

        <form action="/Account/Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 text-red-700 text-xs rounded-xl font-semibold"></div>

            <div>
                <label asp-for="FullName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    <i class="bi bi-person text-emerald-600 mr-1"></i> Họ và tên
                </label>
                <input asp-for="FullName" placeholder="vd: Nguyễn Văn An" 
                       class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Phone" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-telephone text-emerald-600 mr-1"></i> Số điện thoại
                    </label>
                    <input asp-for="Phone" placeholder="vd: 0912345678" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                    <span asp-validation-for="Phone" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-envelope text-emerald-600 mr-1"></i> Email
                    </label>
                    <input asp-for="Email" placeholder="vd: an.nguyen@gmail.com" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                    <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-3 text-xs text-emerald-900">
                <i class="bi bi-shield-check text-emerald-600 mr-1"></i>
                Tài khoản mới bắt đầu ở vai trò Khách thuê. Bạn có thể gửi yêu cầu nâng cấp Host sau khi đăng nhập.
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-lock text-emerald-600 mr-1"></i> Mật khẩu
                    </label>
                    <input asp-for="Password" type="password" placeholder="Tối thiểu 6 ký tự" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                    <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        <i class="bi bi-lock-fill text-emerald-600 mr-1"></i> Nhập lại mật khẩu
                    </label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu..." 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                <i class="bi bi-check-circle-fill"></i> TẠO TÀI KHOẢN NGAY
            </button>
        </form>

        <p class="text-center text-xs text-gray-500 font-semibold pt-2">
            Đã có tài khoản? 
            <a href="/Account/Login" class="font-bold text-emerald-600 hover:underline">Đăng nhập tại đây</a>
        </p>
    </div>
</div>
