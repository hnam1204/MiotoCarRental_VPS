@page "/Bookings/Details/{id:int}"
@model MiotoCarRental.ViewModels.BookingDetailsPageModel
@using MiotoCarRental.Models.Entities
@inject MiotoCarRental.Services.ISepayService Sepay
@{
    var Model = this.Model.Booking;
    ViewData["Title"] = $"Đơn đặt xe #{Model.BookingCode}";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Chi tiết đơn đặt xe</span>
            <h1 class="text-3xl font-black text-gray-900 mt-1">#@Model.BookingCode</h1>
            <p class="text-xs text-gray-400 mt-1">Tạo lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Bookings/Contract/@Model.Id" target="_blank" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs px-3.5 py-2 rounded-xl border border-indigo-200 transition flex items-center gap-1.5 shadow-sm">
                <i class="bi bi-file-earmark-text-fill text-indigo-600"></i> Xem Hợp đồng điện tử
            </a>
            @switch (Model.Status)
            {
                case BookingStatus.AwaitingPayment:
                case BookingStatus.Pending:
                    <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-300">
                        <i class="bi bi-clock-history"></i> Chờ thanh toán cọc
                    </span>
                    break;
                case BookingStatus.Confirmed:
                    <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-300">
                        <i class="bi bi-check-circle-fill"></i> Đã cọc giữ chỗ (Chờ nhận xe)
                    </span>
                    break;
                case BookingStatus.InProgress:
                    <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-300">
                        <i class="bi bi-car-front-fill"></i> Đang trong hành trình
                    </span>
                    break;
                case BookingStatus.Completed:
                    <span class="bg-gray-100 text-gray-800 text-xs font-bold px-3 py-1.5 rounded-full border border-gray-300">
                        <i class="bi bi-flag-fill"></i> Chuyến đi đã hoàn tất
                    </span>
                    break;
                default:
                    <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1.5 rounded-full">@Model.Status</span>
                    break;
            }
        </div>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
        <div class="flex items-center gap-5 p-4 bg-gray-50 rounded-2xl">
            <img src="@Model.Vehicle.ThumbnailUrl" class="w-24 h-20 object-cover rounded-xl" />
            <div>
                <span class="text-xs font-bold text-gray-400 uppercase">@Model.Vehicle.Brand</span>
                <h3 class="text-lg font-black text-gray-900">@Model.Vehicle.Brand @Model.Vehicle.Model</h3>
                <span class="text-xs text-gray-500 block">Biển số: <strong class="text-gray-800">@Model.Vehicle.LicensePlate</strong></span>
                <span class="text-xs text-gray-500 block">Địa chỉ nhận xe: @Model.Vehicle.Address, @Model.Vehicle.City</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-y border-gray-100 py-4 text-xs">
            <div>
                <span class="text-gray-400 block mb-1">Thời gian nhận xe</span>
                <span class="font-bold text-gray-900 text-sm flex items-center gap-1.5">
                    <i class="bi bi-calendar-check text-emerald-600"></i> @Model.StartTime.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
            <div>
                <span class="text-gray-400 block mb-1">Thời gian trả xe</span>
                <span class="font-bold text-gray-900 text-sm flex items-center gap-1.5">
                    <i class="bi bi-calendar-x text-emerald-600"></i> @Model.EndTime.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
        </div>

        <div class="space-y-2 text-xs">
            <h4 class="font-bold text-gray-900 text-sm mb-3">Chi tiết thanh toán</h4>
            <div class="flex justify-between text-gray-600">
                <span>Tiền thuê xe (@Model.TotalDays ngày):</span>
                <span class="font-bold text-gray-800">@Model.RentalFee.ToString("N0") đ</span>
            </div>
            <div class="flex justify-between text-gray-600">
                <span>Phí bảo hiểm chuyến đi (MIC):</span>
                <span class="font-bold text-gray-800">@Model.InsuranceFee.ToString("N0") đ</span>
            </div>
            @if (Model.DeliveryFee > 0)
            {
                <div class="flex justify-between text-gray-600">
                    <span>Phí giao xe tận nơi:</span>
                    <span class="font-bold text-gray-800">@Model.DeliveryFee.ToString("N0") đ</span>
                </div>
            }
            @if (Model.ExtraKmFee > 0)
            {
                <div class="flex justify-between text-red-600 font-bold">
                    <span>Phụ phí vượt số km:</span>
                    <span>+ @Model.ExtraKmFee.ToString("N0") đ</span>
                </div>
            }
            <div class="flex justify-between text-sm font-black text-gray-900 pt-2 border-t border-gray-100">
                <span>Tổng giá trị đơn:</span>
                <span class="text-emerald-600 text-base">@((Model.TotalAmount + Model.ExtraKmFee).ToString("N0")) đ</span>
            </div>
            <div class="flex justify-between text-xs font-bold text-emerald-700 bg-emerald-50 p-3 rounded-xl mt-2">
                <span>Tiền cọc giữ chỗ (30%):</span>
                <span>@Model.DepositAmount.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    @if (Model.Status == BookingStatus.AwaitingPayment || Model.Status == BookingStatus.Pending)
    {
        var channels = Sepay.GetAvailableChannels(Model.DepositAmount, Model.BookingCode);
        var defaultChannel = channels.FirstOrDefault() ?? new MiotoCarRental.Services.PaymentChannelInfo();

        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border border-emerald-100 shadow-xl text-center">
            <div class="max-w-md mx-auto space-y-5">
                <span class="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">
                    <i class="bi bi-shield-check text-emerald-600"></i> Cổng Chuyển Khoản Ngân Hàng & Ví Điện Tử (Auto 24/7)
                </span>
                <h3 class="text-xl font-black text-gray-900">Thanh toán cọc 30% giữ xe</h3>
                <p class="text-xs text-gray-500">
                    Số tiền cần thanh toán: <strong class="text-emerald-700 text-base">@Model.DepositAmount.ToString("N0") đ</strong> (Mã đơn: <span class="font-mono text-gray-800">#@Model.BookingCode</span>)
                </p>

                <!-- Thanh chọn kênh thanh toán: MBBank, VPBank, MoMo -->
                <div class="flex items-center justify-center gap-2 p-1.5 bg-gray-100 rounded-2xl">
                    @for (int i = 0; i < channels.Count; i++)
                    {
                        var ch = channels[i];
                        <button type="button" onclick="selectChannel(@i)" id="tab-btn-@i" 
                                class="channel-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 @(i == 0 ? "bg-white text-emerald-700 shadow-sm" : "text-gray-600 hover:text-gray-900")">
                            <i class="@ch.IconClass"></i>
                            <span class="truncate">@ch.Name.Split('(')[0].Trim()</span>
                        </button>
                    }
                </div>

                <!-- Khung hiển thị mã VietQR chuyển khoản theo kênh đã chọn -->
                <div class="p-5 bg-gradient-to-b from-gray-50 to-white rounded-3xl border-2 border-emerald-500/30 shadow-md">
                    <!-- Trạng thái Auto-Detection Real-time -->
                    <div class="mb-3 inline-flex items-center gap-2 px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-[11px] font-bold">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                        </span>
                        <span id="listeningChannelText">Đang tự động lắng nghe biến động số dư @defaultChannel.Name...</span>
                    </div>

                    <div class="relative inline-block bg-white p-3 rounded-2xl border border-gray-200 shadow-sm">
                        <img id="channelQrImg" src="@defaultChannel.QrUrl" 
                             alt="VietQR" class="w-48 h-48 mx-auto rounded-xl object-contain transition-all duration-300" />
                    </div>

                    <div class="mt-4 bg-gray-50 p-3.5 rounded-2xl border border-gray-200 text-left space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Ngân hàng / Ví:</span>
                            <strong id="channelBankName" class="text-gray-900 font-bold">@defaultChannel.Name</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Số tài khoản / SĐT:</span>
                            <div class="flex items-center gap-1.5 font-mono font-bold text-gray-900">
                                <span id="channelAccNumber">@defaultChannel.AccountNumber</span>
                                <button type="button" id="copyStkBtn" onclick="copyCurrentStk()" class="text-[10px] text-blue-600 hover:text-blue-800 bg-blue-50 px-1.5 py-0.5 rounded">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Người thụ hưởng:</span>
                            <strong id="channelAccName" class="text-gray-900 font-bold uppercase">@defaultChannel.AccountName</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Số tiền cọc:</span>
                            <strong class="text-emerald-700 font-black text-sm">@Model.DepositAmount.ToString("N0") đ</strong>
                        </div>
                        <div class="flex items-center justify-between pt-1 border-t border-gray-200">
                            <span class="text-gray-500">Nội dung CK:</span>
                            <div class="flex items-center gap-1.5 font-mono font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">
                                <span>@Model.BookingCode</span>
                                <button type="button" id="copyContentBtn" onclick="copyText('@Model.BookingCode', 'copyContentBtn')" class="text-[10px] text-emerald-700 hover:text-emerald-900">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút Xác nhận đã chuyển khoản -->
                <div class="pt-1">
                    <button type="button" onclick="confirmInstantPayment(@Model.Id)" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition flex items-center justify-center gap-2">
                        <i class="bi bi-check2-circle text-lg"></i>
                        <span>Xác nhận đã chuyển khoản thành công</span>
                    </button>
                </div>

                <div class="relative flex py-1 items-center">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink mx-4 text-gray-400 text-[11px] font-bold uppercase">Hoặc thanh toán qua Cổng VNPAY</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <!-- Thanh toán qua Cổng VNPay Sandbox -->
                <form action="/Payment/CreateVnPayUrl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="w-full bg-[#005BAA] hover:bg-[#004885] text-white font-black py-3.5 px-6 rounded-2xl shadow-md transition flex items-center justify-center gap-2.5 group">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                            <path d="M21 4H3c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h18c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H3V8h18v10zm-10-7H5v2h6v-2z"/>
                        </svg>
                        <span class="text-sm tracking-wide">Cổng thanh toán VNPAY (Thẻ ATM / Visa)</span>
                        <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </form>
            </div>
        </div>
    }

    @if (Model.Status == BookingStatus.Confirmed)
    {
        <!-- Thẻ Biên nhận Cọc Thanh toán Thành công -->
        <div class="mt-8 bg-emerald-50/70 border border-emerald-200 rounded-3xl p-6 sm:p-7 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-emerald-200/70">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-emerald-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-600/30 text-2xl">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <span class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider block">Biên nhận đặt cọc thành công</span>
                        <h4 class="text-lg font-black text-emerald-950">Đã thanh toán 30% giữ chỗ</h4>
                    </div>
                </div>
                <div class="text-right sm:text-right">
                    <span class="text-xs text-emerald-700 block">Số tiền cọc đã thu</span>
                    <span class="text-2xl font-black text-emerald-800">@Model.DepositAmount.ToString("N0") đ</span>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 text-xs">
                <div>
                    <span class="text-gray-400 block text-[11px]">Cổng thanh toán</span>
                    <strong class="text-gray-800 font-bold">@(Model.PaymentMethod ?? "VNPAY")</strong>
                </div>
                <div>
                    <span class="text-gray-400 block text-[11px]">Mã giao dịch</span>
                    <strong class="text-gray-800 font-mono">@(Model.PaymentTransactionId ?? $"VNP-{Model.BookingCode}")</strong>
                </div>
                <div>
                    <span class="text-gray-400 block text-[11px]">Ngân hàng xử lý</span>
                    <strong class="text-gray-800 font-bold">@(Model.PaymentBankCode ?? "NCB/VietQR")</strong>
                </div>
                <div>
                    <span class="text-gray-400 block text-[11px]">Thời gian xác nhận</span>
                    <strong class="text-gray-800">@(Model.DepositPaidAt?.ToString("dd/MM/yyyy HH:mm") ?? Model.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</strong>
                </div>
            </div>
        </div>

        <div class="mt-6 bg-white rounded-3xl p-6 sm:p-8 border border-blue-100 shadow-md">
            <h3 class="text-xl font-black text-gray-900 mb-2 flex items-center gap-2">
                <i class="bi bi-clipboard2-check-fill text-blue-600"></i> Bàn giao xe máy điện & Củ sạc (Check-in)
            </h3>
            <p class="text-xs text-gray-500 mb-6">Đồng kiểm tra số km đồng hồ điện tử, dung lượng pin LFP và bàn giao 02 nón bảo hiểm.</p>

            <form action="/Bookings/Checkin" method="post" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Số ODO lúc nhận xe (km)</label>
                    <input type="number" name="odo" value="3200" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Dung lượng Pin LFP (%)</label>
                    <input type="number" name="fuelLevel" value="100" min="0" max="100" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div class="sm:col-span-2 pt-2">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-2xl shadow-md transition">
                        <i class="bi bi-key-fill mr-1"></i> Bàn giao xe máy điện & Bắt đầu hành trình
                    </button>
                </div>
            </form>
        </div>
    }

    @if (Model.Status == BookingStatus.InProgress)
    {
        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border border-amber-100 shadow-md">
            <h3 class="text-xl font-black text-gray-900 mb-2 flex items-center gap-2">
                <i class="bi bi-flag-fill text-amber-600"></i> Nghiệm thu trả xe máy điện (Check-out)
            </h3>
            <p class="text-xs text-gray-500 mb-6">
                ODO lúc nhận: <strong>@Model.CheckinOdo km</strong>. Định mức cho phép: <strong>@(Model.Vehicle.LimitKmPerDay * Model.TotalDays) km</strong>.
            </p>

            <form action="/Bookings/Checkout" method="post" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Số ODO lúc trả xe (km)</label>
                    <input type="number" name="odo" value="@((Model.CheckinOdo ?? 3200) + 120)" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Dung lượng Pin lúc trả (%)</label>
                    <input type="number" name="fuelLevel" value="45" min="0" max="100" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div class="sm:col-span-2 pt-2">
                    <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3.5 rounded-2xl shadow-md transition">
                        <i class="bi bi-check-circle mr-1"></i> Hoàn tất trả xe & Hoàn trả thế chấp
                    </button>
                </div>
            </form>
        </div>
    }

    @if (Model.Status == BookingStatus.Completed)
    {
        var finalGross = Model.TotalAmount + Model.ExtraKmFee + Model.ExtraOtherFee;
        var remainingDue = Math.Max(0, finalGross - Model.DepositAmount);
        var drivenKm = (Model.CheckoutOdo ?? 0) - (Model.CheckinOdo ?? 0);
        var allowedKm = Model.Vehicle.LimitKmPerDay * Model.TotalDays;
        var extraKm = Math.Max(0, drivenKm - allowedKm);
        var settleChannels = Sepay.GetAvailableChannels(remainingDue, $"TT-{Model.BookingCode}");
        var defaultSettle = settleChannels.FirstOrDefault() ?? new MiotoCarRental.Services.PaymentChannelInfo();

        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-500/30 shadow-xl space-y-6">
            <!-- Header Bảng Quyết Toán -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-gray-100">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-emerald-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-600/30 text-2xl">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Hóa đơn tất toán chuyến đi</span>
                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2 py-0.5 rounded-md">ĐÃ HOÀN TẤT</span>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 mt-0.5">Quyết toán Hợp đồng #@Model.BookingCode</h3>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                        <i class="bi bi-printer-fill"></i> In Hóa đơn / Lưu PDF
                    </button>
                </div>
            </div>

            <!-- 1. BIÊN BẢN BÀN GIAO & ĐỒNG KIỂM TRA ODO / PIN LFP -->
            <div class="bg-slate-50 rounded-2xl p-4 sm:p-5 border border-slate-200 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 uppercase flex items-center gap-1.5">
                        <i class="bi bi-speedometer2 text-emerald-600"></i> Biên bản nghiệm thu hành trình (ODO &amp; Pin LFP)
                    </span>
                    <span class="text-[11px] text-slate-500">Trả xe lúc: @(Model.CheckoutTime?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                        <span class="text-slate-400 block text-[11px]">ODO lúc nhận</span>
                        <strong class="text-slate-900 font-mono text-sm">@Model.CheckinOdo.GetValueOrDefault().ToString("N0") km</strong>
                        <div class="text-[10px] text-emerald-600 font-medium mt-0.5">Pin: @Model.CheckinBatteryPercent.GetValueOrDefault()%</div>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                        <span class="text-slate-400 block text-[11px]">ODO lúc trả</span>
                        <strong class="text-slate-900 font-mono text-sm">@Model.CheckoutOdo.GetValueOrDefault().ToString("N0") km</strong>
                        <div class="text-[10px] text-blue-600 font-medium mt-0.5">Pin: @Model.CheckoutBatteryPercent.GetValueOrDefault()%</div>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                        <span class="text-slate-400 block text-[11px]">Đã di chuyển</span>
                        <strong class="text-slate-900 font-mono text-sm">@drivenKm.ToString("N0") km</strong>
                        <div class="text-[10px] text-slate-500 font-medium mt-0.5">Thời gian: @Model.TotalDays ngày</div>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                        <span class="text-slate-400 block text-[11px]">Hạn mức cam kết</span>
                        <strong class="text-slate-900 font-mono text-sm">@allowedKm.ToString("N0") km</strong>
                        <div class="text-[10px] text-slate-500 font-medium mt-0.5">@Model.Vehicle.LimitKmPerDay km/ngày</div>
                    </div>
                </div>

                @if (extraKm > 0)
                {
                    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-xl text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-red-600 text-base"></i>
                            <div>
                                <span class="font-bold">Quãng đường di chuyển vượt định mức hợp đồng: <strong>+@extraKm km</strong></span>
                                <div class="text-[11px] text-red-600">Đơn giá phụ phí vượt quãng đường: @Model.Vehicle.OverKmFee.ToString("N0") đ/km (@extraKm x @Model.Vehicle.OverKmFee.ToString("N0") đ)</div>
                            </div>
                        </div>
                        <div class="text-right sm:text-right shrink-0">
                            <span class="text-sm font-black text-red-700">+ @Model.ExtraKmFee.ToString("N0") đ</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-xl text-xs flex items-center gap-2">
                        <i class="bi bi-check-circle-fill text-emerald-600"></i>
                        <span>Phương tiện di chuyển trong hạn mức cho phép (<strong>@drivenKm / @allowedKm km</strong>). Không phát sinh phụ phí quãng đường.</span>
                    </div>
                }
            </div>

            <!-- 2. BẢNG BÓC TÁCH TÀI CHÍNH TẤT TOÁN -->
            <div class="space-y-2.5 text-xs">
                <h4 class="font-bold text-gray-900 text-sm mb-2 flex items-center gap-1.5">
                    <i class="bi bi-cash-stack text-emerald-600"></i> Chi tiết các khoản quyết toán
                </h4>

                <div class="flex justify-between text-gray-600">
                    <span>1. Tiền thuê xe máy điện (@Model.TotalDays ngày x @Model.Vehicle.PricePerDay.ToString("N0") đ):</span>
                    <span class="font-bold text-gray-900">@Model.RentalFee.ToString("N0") đ</span>
                </div>

                <div class="flex justify-between text-gray-600">
                    <span>2. Phí bảo hiểm xe máy điện MIC (@Model.TotalDays ngày):</span>
                    <span class="font-bold text-gray-900">@Model.InsuranceFee.ToString("N0") đ</span>
                </div>

                @if (Model.DeliveryFee > 0)
                {
                    <div class="flex justify-between text-gray-600">
                        <span>3. Phí giao nhận xe tận nơi theo yêu cầu:</span>
                        <span class="font-bold text-gray-900">@Model.DeliveryFee.ToString("N0") đ</span>
                    </div>
                }

                @if (Model.ExtraKmFee > 0)
                {
                    <div class="flex justify-between text-red-600 font-bold">
                        <span>4. Phụ phí phát sinh vượt quãng đường (@extraKm km):</span>
                        <span>+ @Model.ExtraKmFee.ToString("N0") đ</span>
                    </div>
                }

                <div class="flex justify-between text-sm font-bold text-gray-900 pt-2 border-t border-gray-200">
                    <span>TỔNG GIÁ TRỊ TOÀN BỘ CHUYẾN ĐI (Gross Total):</span>
                    <span class="text-base font-black text-gray-900">@finalGross.ToString("N0") đ</span>
                </div>

                <div class="flex justify-between text-xs font-semibold text-emerald-700 bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                    <span class="flex items-center gap-1.5">
                        <i class="bi bi-check-circle-fill text-emerald-600"></i> Đã thanh toán đặt cọc 30% giữ xe trước đó (qua @(Model.PaymentMethod ?? "VNPAY")):
                    </span>
                    <span class="font-bold">- @Model.DepositAmount.ToString("N0") đ</span>
                </div>

                <!-- DÒNG QUYẾT TOÁN 70% CÒN LẠI -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-4 bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-2xl shadow-md mt-2">
                    <div>
                        <span class="text-[11px] text-emerald-100 uppercase font-semibold tracking-wider block">Số tiền còn lại cần thanh toán khi trả xe</span>
                        <h4 class="text-base sm:text-lg font-black text-white">70% Tiền thuê + Phụ phí phát sinh</h4>
                    </div>
                    <div class="text-right sm:text-right">
                        <span class="text-2xl sm:text-3xl font-black text-amber-300">@remainingDue.ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <!-- 3. MÃ VIETQR QUYẾT TOÁN 70% CÒN LẠI -->
            @if (remainingDue > 0)
            {
                <div class="p-5 bg-gradient-to-b from-gray-50 to-white rounded-3xl border-2 border-emerald-500/30 text-center space-y-4">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">
                        <i class="bi bi-qr-code-scan text-emerald-600"></i> Quét mã VietQR thanh toán @remainingDue.ToString("N0") đ khi giao xe
                    </div>

                    <!-- Thanh chọn kênh thanh toán -->
                    <div class="max-w-md mx-auto flex items-center justify-center gap-2 p-1.5 bg-gray-100 rounded-2xl">
                        @for (int i = 0; i < settleChannels.Count; i++)
                        {
                            var ch = settleChannels[i];
                            <button type="button" onclick="selectSettleChannel(@i)" id="settle-tab-btn-@i"
                                    class="settle-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 @(i == 0 ? "bg-white text-emerald-700 shadow-sm" : "text-gray-600 hover:text-gray-900")">
                                <i class="@ch.IconClass"></i>
                                <span class="truncate">@ch.Name.Split('(')[0].Trim()</span>
                            </button>
                        }
                    </div>

                    <div class="relative inline-block bg-white p-3 rounded-2xl border border-gray-200 shadow-sm">
                        <img id="settleQrImg" src="@defaultSettle.QrUrl"
                             alt="VietQR Tất toán" class="w-44 h-44 mx-auto rounded-xl object-contain" />
                    </div>

                    <div class="max-w-md mx-auto bg-gray-50 p-3.5 rounded-2xl border border-gray-200 text-left space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Ngân hàng thụ hưởng:</span>
                            <strong id="settleBankName" class="text-gray-900 font-bold">@defaultSettle.Name</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Số tài khoản:</span>
                            <div class="flex items-center gap-1.5 font-mono font-bold text-gray-900">
                                <span id="settleAccNumber">@defaultSettle.AccountNumber</span>
                                <button type="button" id="copySettleStkBtn" onclick="copySettleStk()" class="text-[10px] text-blue-600 hover:text-blue-800 bg-blue-50 px-1.5 py-0.5 rounded">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Người thụ hưởng:</span>
                            <strong id="settleAccName" class="text-gray-900 font-bold uppercase">@defaultSettle.AccountName</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Số tiền quyết toán:</span>
                            <strong class="text-emerald-700 font-black text-sm">@remainingDue.ToString("N0") đ</strong>
                        </div>
                        <div class="flex items-center justify-between pt-1 border-t border-gray-200">
                            <span class="text-gray-500">Nội dung CK:</span>
                            <div class="flex items-center gap-1.5 font-mono font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">
                                <span>TT-@Model.BookingCode</span>
                                <button type="button" id="copySettleContentBtn" onclick="copyText('TT-@Model.BookingCode', 'copySettleContentBtn')" class="text-[10px] text-emerald-700 hover:text-emerald-900">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- 4. XÁC NHẬN HOÀN TRẢ THẾ CHẤP -->
            <div class="p-4 bg-blue-50/70 border border-blue-200 rounded-2xl flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                    <i class="bi bi-shield-lock-fill text-blue-600 text-lg"></i>
                    <div>
                        <span class="font-bold text-blue-950 block">Tài sản thế chấp nhận xe:</span>
                        <span class="text-blue-700">@Model.CollateralType</span>
                    </div>
                </div>
                <div class="text-right shrink-0">
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                        <i class="bi bi-check-all"></i> Đã nghiệm thu &amp; hoàn trả thế chấp
                    </span>
                </div>
            </div>

            <!-- Đánh giá chuyến đi -->
            <div class="pt-4 border-t border-gray-100">
                @{
                    var existingReview = Model.Reviews.FirstOrDefault();
                }

                @if (existingReview != null)
                {
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Đánh giá của bạn về chuyến đi</span>
                            <div class="text-amber-400 text-sm">
                                @for (int i = 0; i < existingReview.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </div>
                        </div>
                        <p class="text-xs text-gray-800 italic bg-white p-3 rounded-xl border border-gray-200">
                            "@existingReview.Comment"
                        </p>
                    </div>
                }
                else
                {
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
                        <h4 class="text-sm font-black text-gray-900 mb-2 flex items-center gap-1.5">
                            <i class="bi bi-star-fill text-amber-400"></i> Đánh giá trải nghiệm phương tiện &amp; dịch vụ
                        </h4>
                        <form action="/Bookings/AddReview" method="post" class="space-y-3">
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <div>
                                <div class="flex items-center gap-3">
                                    @for (int star = 5; star >= 1; star--)
                                    {
                                        <label class="flex items-center gap-1.5 cursor-pointer bg-white hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-gray-200 transition text-xs">
                                            <input type="radio" name="rating" value="@star" @(star == 5 ? "checked" : "") class="text-emerald-600 focus:ring-emerald-500" />
                                            <span class="font-bold text-gray-800 flex items-center gap-1">
                                                @star <i class="bi bi-star-fill text-amber-400 text-xs"></i>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>
                            <div>
                                <textarea id="commentBox" name="comment" rows="2" placeholder="Chia sẻ cảm nhận về chuyến đi, độ êm của xe và thời lượng pin..." class="w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none transition" required></textarea>
                            </div>
                            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition text-xs flex items-center gap-1.5">
                                <i class="bi bi-send-fill"></i> Gửi đánh giá
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const channelsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Sepay.GetAvailableChannels(Model.DepositAmount, Model.BookingCode)));
        let selectedIndex = 0;

        function selectChannel(idx) {
            if (!channelsData || !channelsData[idx]) return;
            selectedIndex = idx;
            const ch = channelsData[idx];

            const qrImg = document.getElementById('channelQrImg');
            if (qrImg) qrImg.src = ch.QrUrl;

            const bankName = document.getElementById('channelBankName');
            if (bankName) bankName.innerText = ch.Name;

            const accNum = document.getElementById('channelAccNumber');
            if (accNum) accNum.innerText = ch.AccountNumber;

            const accName = document.getElementById('channelAccName');
            if (accName) accName.innerText = ch.AccountName;

            const listenText = document.getElementById('listeningChannelText');
            if (listenText) listenText.innerText = `Đang tự động lắng nghe biến động số dư ${ch.Name}...`;

            // Cập nhật giao diện tab được chọn
            for (let i = 0; i < channelsData.length; i++) {
                const btn = document.getElementById(`tab-btn-${i}`);
                if (btn) {
                    if (i === idx) {
                        btn.className = "channel-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm";
                    } else {
                        btn.className = "channel-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 text-gray-600 hover:text-gray-900";
                    }
                }
            }
        }

        function copyCurrentStk() {
            if (channelsData && channelsData[selectedIndex]) {
                copyText(channelsData[selectedIndex].AccountNumber, 'copyStkBtn');
            }
        }

        @if (Model.Status == BookingStatus.Completed)
        {
            var finalGross = Model.TotalAmount + Model.ExtraKmFee + Model.ExtraOtherFee;
            var remainingDue = Math.Max(0, finalGross - Model.DepositAmount);
            <text>
            const settleChannelsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Sepay.GetAvailableChannels(remainingDue, $"TT-{Model.BookingCode}")));
            let selectedSettleIdx = 0;

            function selectSettleChannel(idx) {
                if (!settleChannelsData || !settleChannelsData[idx]) return;
                selectedSettleIdx = idx;
                const ch = settleChannelsData[idx];

                const qrImg = document.getElementById('settleQrImg');
                if (qrImg) qrImg.src = ch.QrUrl;

                const bankName = document.getElementById('settleBankName');
                if (bankName) bankName.innerText = ch.Name;

                const accNum = document.getElementById('settleAccNumber');
                if (accNum) accNum.innerText = ch.AccountNumber;

                const accName = document.getElementById('settleAccName');
                if (accName) accName.innerText = ch.AccountName;

                settleChannelsData.forEach((chItem, i) => {
                    const btn = document.getElementById('settle-tab-btn-' + i);
                    if (btn) {
                        if (i === idx) {
                            btn.className = "settle-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm";
                        } else {
                            btn.className = "settle-tab-btn flex-1 py-2 px-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 text-gray-600 hover:text-gray-900";
                        }
                    }
                });
            }

            function copySettleStk() {
                if (settleChannelsData && settleChannelsData[selectedSettleIdx]) {
                    copyText(settleChannelsData[selectedSettleIdx].AccountNumber, 'copySettleStkBtn');
                }
            }
            </text>
        }

        function copyText(val, btnId) {
            navigator.clipboard.writeText(val);
            const btn = document.getElementById(btnId);
            if (btn) {
                const old = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2"></i> Đã chép!';
                setTimeout(() => btn.innerHTML = old, 2000);
            }
        }

        async function confirmInstantPayment(bookingId) {
            try {
                const ch = channelsData[selectedIndex] ? channelsData[selectedIndex].Key : "MBBank";
                const res = await fetch(`/api/sepay/test-webhook/${bookingId}?gateway=${ch}`, { method: 'POST' });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Không thể hoàn tất xác nhận, vui lòng thử lại.");
                }
            } catch (e) {
                alert("Lỗi kết nối máy chủ: " + e);
            }
        }

        @if (Model.Status == BookingStatus.AwaitingPayment || Model.Status == BookingStatus.Pending)
        {
            <text>
            // Tự động lắng nghe giao dịch thời gian thực (Real-time Polling mỗi 2.5s)
            let pollTimer = setInterval(async () => {
                try {
                    let res = await fetch('/api/bookings/@Model.Id/status');
                    if (res.ok) {
                        let data = await res.json();
                        if (data.isPaid || data.status === 'Confirmed') {
                            clearInterval(pollTimer);
                            // Tự động nạp lại trang ngay khi tiền ting ting vào tài khoản
                            window.location.reload();
                        }
                    }
                } catch (e) {
                    console.log("Polling payment status...", e);
                }
            }, 2500);
            </text>
        }
    </script>
}
