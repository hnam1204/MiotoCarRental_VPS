@page "/Host"
@model MiotoCarRental.ViewModels.HostDashboardViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Kênh Chủ Xe - Quản lý xe & Đơn đặt thuê";
    var netRevenue = Math.Round(Model.TotalRevenue * 0.85m, 0);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header & Host Functions -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-5 border-b border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Kênh Đối Tác Chủ Xe</h1>
            <p class="text-sm text-gray-500 mt-0.5">Quản lý đội xe máy điện, duyệt yêu cầu thuê, bàn giao xe (Check-in/Check-out) và theo dõi doanh thu</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <a href="#incoming-bookings" class="px-3.5 py-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-xs font-medium text-gray-700">
                <i class="bi bi-inbox mr-1 text-blue-600"></i> Đơn khách đặt (@Model.IncomingBookings.Count)
            </a>
            <a href="#my-vehicles" class="px-3.5 py-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-xs font-medium text-gray-700">
                <i class="bi bi-bicycle mr-1 text-emerald-600"></i> Đội xe của tôi (@Model.MyVehicles.Count)
            </a>
            <a href="/Host/Create" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg transition flex items-center gap-1.5">
                <i class="bi bi-plus-lg"></i> Đăng xe máy điện mới
            </a>
        </div>
    </div>

    <!-- 4 Host KPIs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="text-xs font-medium text-gray-500">Xe đang quản lý</div>
            <div class="text-2xl font-bold text-gray-900 mt-1">@Model.TotalVehicles <span class="text-sm font-normal text-gray-400">xe</span></div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="text-xs font-medium text-gray-500">Đơn đang phục vụ</div>
            <div class="text-2xl font-bold text-blue-600 mt-1">@Model.ActiveBookingsCount <span class="text-sm font-normal text-gray-400">chuyến</span></div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="text-xs font-medium text-gray-500">Tổng tiền thuê</div>
            <div class="text-2xl font-bold text-gray-900 mt-1">@Model.TotalRevenue.ToString("N0")đ</div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="text-xs font-medium text-gray-500">Thực nhận Chủ xe (85%)</div>
            <div class="text-2xl font-bold text-emerald-600 mt-1">@netRevenue.ToString("N0")đ</div>
        </div>
    </div>

    <!-- Chức năng 1 của Chủ xe: Duyệt đơn & Bàn giao xe -->
    <div id="incoming-bookings" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-200 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-gray-900">1. Quản lý Đơn khách đặt & Nghiệm thu Bàn giao xe (@Model.IncomingBookings.Count đơn)</h2>
                <p class="text-xs text-gray-500 mt-0.5">Xác nhận yêu cầu thuê, ghi nhận % Pin và ODO lúc giao/trả xe và xuất hợp đồng điện tử</p>
            </div>
        </div>

        @if (!Model.IncomingBookings.Any())
        {
            <div class="p-8 text-center text-xs text-gray-500">Chưa có yêu cầu đặt xe nào gửi tới các xe của bạn.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                        <tr>
                            <th class="py-3 px-5">Mã đơn</th>
                            <th class="py-3 px-4">Xe máy điện</th>
                            <th class="py-3 px-4">Khách thuê</th>
                            <th class="py-3 px-4">Thời gian thuê</th>
                            <th class="py-3 px-4">Tiền thuê</th>
                            <th class="py-3 px-4">Trạng thái</th>
                            <th class="py-3 px-5 text-right">Thao tác của Chủ xe</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-700">
                        @foreach (var b in Model.IncomingBookings)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-3.5 px-5 font-mono font-semibold text-gray-900">#@b.BookingCode</td>
                                <td class="py-3.5 px-4 font-semibold text-gray-900">@b.Vehicle.Brand @b.Vehicle.Model</td>
                                <td class="py-3.5 px-4">@b.Renter.FullName (@b.Renter.Phone)</td>
                                <td class="py-3.5 px-4">@b.StartTime.ToString("dd/MM") - @b.EndTime.ToString("dd/MM/yyyy") (@b.TotalDays ngày)</td>
                                <td class="py-3.5 px-4 font-semibold text-emerald-600">@b.RentalFee.ToString("N0")đ</td>
                                <td class="py-3.5 px-4">
                                    @switch (b.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="bg-amber-50 text-amber-700 border border-amber-200 text-[11px] font-medium px-2 py-0.5 rounded">Chờ Chủ xe duyệt</span>
                                            break;
                                        case BookingStatus.AwaitingPayment:
                                            <span class="bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-medium px-2 py-0.5 rounded">Chờ khách cọc</span>
                                            break;
                                        case BookingStatus.Confirmed:
                                            <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-medium px-2 py-0.5 rounded">Đã cọc - Chờ giao xe</span>
                                            break;
                                        case BookingStatus.InProgress:
                                            <span class="bg-purple-50 text-purple-700 border border-purple-200 text-[11px] font-medium px-2 py-0.5 rounded">Đang thuê (Đã giao)</span>
                                            break;
                                        case BookingStatus.Completed:
                                            <span class="bg-gray-100 text-gray-700 text-[11px] font-medium px-2 py-0.5 rounded">Hoàn tất</span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="bg-red-50 text-red-600 text-[11px] font-medium px-2 py-0.5 rounded">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-5 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (b.Status == BookingStatus.Pending)
                                        {
                                            <form action="/Host/ApproveBooking" method="post" class="inline">
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 rounded text-[11px] font-medium transition">
                                                    Duyệt đơn
                                                </button>
                                            </form>
                                        }
                                        <a href="/Bookings/Details/@b.Id" class="px-2.5 py-1 rounded bg-blue-50 hover:bg-blue-100 text-blue-700 text-[11px] font-medium">
                                            Giao / Nhận xe
                                        </a>
                                        <a href="/Bookings/Contract/@b.Id" class="px-2.5 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 text-[11px] font-medium">
                                            Hợp đồng
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Chức năng 2 của Chủ xe: Quản lý Đội xe cá nhân -->
    <div id="my-vehicles" class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="text-base font-bold text-gray-900">2. Đội xe máy điện của tôi (@Model.MyVehicles.Count xe)</h2>
                <p class="text-xs text-gray-500 mt-0.5">Bật/tắt trạng thái nhận khách hoặc thêm phương tiện mới lên sàn</p>
            </div>
            <a href="/Host/Create" class="text-xs font-semibold text-blue-600 hover:underline">+ Đăng thêm xe mới</a>
        </div>

        @if (!Model.MyVehicles.Any())
        {
            <div class="text-center py-8">
                <p class="text-xs text-gray-500">Bạn chưa đăng chiếc xe máy điện nào.</p>
                <a href="/Host/Create" class="mt-3 inline-block bg-blue-600 text-white font-medium text-xs px-4 py-2 rounded-lg">Đăng xe ngay</a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                @foreach (var v in Model.MyVehicles)
                {
                    <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-sm transition flex flex-col justify-between">
                        <div class="relative h-44 bg-gray-100">
                            <img src="@v.ThumbnailUrl" class="w-full h-full object-cover" />
                            <span class="absolute top-3 left-3 text-xs font-medium px-2.5 py-0.5 rounded @(v.Status == VehicleStatus.Active ? "bg-emerald-600 text-white" : "bg-gray-700 text-white")">
                                @(v.Status == VehicleStatus.Active ? "Đang mở cho thuê" : "Tạm ngưng")
                            </span>
                            <span class="absolute bottom-3 right-3 bg-black/70 text-white text-xs font-mono px-2 py-0.5 rounded">
                                @v.LicensePlate
                            </span>
                        </div>

                        <div class="p-4 flex flex-col flex-grow justify-between">
                            <div>
                                <span class="text-xs text-gray-500">@v.Brand • @v.BatteryType</span>
                                <h4 class="font-bold text-gray-900 text-base mt-0.5">@v.Brand @v.Model</h4>
                                <div class="text-xs text-gray-500 mt-2 space-y-1">
                                    <div>Quãng đường: <strong class="text-gray-800">@v.BatteryRangeKm km/sạc</strong></div>
                                    <div>Khu vực: @v.District, @v.City</div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-3 mt-4 border-t border-gray-100">
                                <div>
                                    <span class="text-base font-bold text-emerald-600">@v.PricePerDay.ToString("N0")đ</span>
                                    <span class="text-xs text-gray-400">/ngày</span>
                                </div>

                                <div class="flex items-center gap-2">
                                    <form action="/Host/ToggleStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button type="submit" class="text-xs font-medium px-3 py-1.5 rounded-lg border transition @(v.Status == VehicleStatus.Active ? "border-amber-200 text-amber-700 bg-amber-50 hover:bg-amber-100" : "border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100")">
                                            @(v.Status == VehicleStatus.Active ? "Tạm ngưng" : "Mở cho thuê")
                                        </button>
                                    </form>
                                    <a href="/Vehicles/Details/@v.Id" class="text-xs font-medium px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
