@page "/Host"
@model MiotoCarRental.ViewModels.HostDashboardViewModel
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Kênh Chủ Xe - Quản lý xe máy điện";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Kênh Đối Tác Chủ Xe</span>
            <h1 class="text-3xl font-black text-gray-900 mt-1">Quản lý xe máy điện & Đơn thuê</h1>
            <p class="text-xs text-gray-500 mt-1">Theo dõi các phương tiện đang cho thuê và yêu cầu từ khách hàng</p>
        </div>

        <a href="/Host/Create" class="bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs px-6 py-3.5 rounded-2xl shadow-lg shadow-emerald-600/30 transition flex items-center gap-2 transform hover:-translate-y-0.5">
            <i class="bi bi-plus-circle-fill text-base"></i> ĐĂNG XE MÁY ĐIỆN MỚI
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-gray-400 uppercase">Xe đang quản lý</span>
                <h3 class="text-3xl font-black text-gray-900 mt-1">@Model.TotalVehicles</h3>
            </div>
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="bi bi-bicycle"></i>
            </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-gray-400 uppercase">Chuyến đang phục vụ</span>
                <h3 class="text-3xl font-black text-blue-600 mt-1">@Model.ActiveBookingsCount</h3>
            </div>
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="bi bi-clock-history"></i>
            </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-gray-400 uppercase">Doanh thu tạm tính</span>
                <h3 class="text-3xl font-black text-emerald-600 mt-1">@Model.TotalRevenue.ToString("N0") đ</h3>
            </div>
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm mb-10">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-black text-gray-900 flex items-center gap-2">
                <i class="bi bi-collection-fill text-emerald-600"></i> Danh sách xe máy điện của tôi (@Model.MyVehicles.Count)
            </h2>
        </div>

        @if (!Model.MyVehicles.Any())
        {
            <div class="text-center py-10">
                <i class="bi bi-bicycle text-4xl text-gray-300"></i>
                <p class="text-xs text-gray-500 mt-2">Bạn chưa đăng chiếc xe máy điện nào.</p>
                <a href="/Host/Create" class="mt-3 inline-block bg-emerald-600 text-white font-bold text-xs px-4 py-2 rounded-xl">Đăng xe ngay</a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var v in Model.MyVehicles)
                {
                    <div class="border border-gray-100 rounded-3xl overflow-hidden hover:shadow-md transition flex flex-col justify-between">
                        <div class="relative h-44 bg-gray-100">
                            <img src="@v.ThumbnailUrl" class="w-full h-full object-cover" />
                            <span class="absolute top-3 left-3 text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full shadow @(v.Status == VehicleStatus.Active ? "bg-emerald-600 text-white" : "bg-gray-600 text-white")">
                                @(v.Status == VehicleStatus.Active ? "Đang cho thuê" : "Tạm dừng")
                            </span>
                            <span class="absolute bottom-3 right-3 bg-black/60 text-white text-[10px] font-mono px-2 py-0.5 rounded-lg">
                                @v.LicensePlate
                            </span>
                        </div>

                        <div class="p-5 flex flex-col flex-grow justify-between">
                            <div>
                                <span class="text-xs font-bold text-gray-400">@v.Brand • @v.BatteryType</span>
                                <h4 class="font-black text-gray-900 text-base mt-0.5">@v.Brand @v.Model</h4>
                                <div class="text-xs text-gray-500 mt-2 space-y-1">
                                    <div><i class="bi bi-battery-charging text-emerald-600"></i> Quãng đường: <strong>@v.BatteryRangeKm km/sạc</strong></div>
                                    <div><i class="bi bi-geo-alt text-gray-400"></i> Địa chỉ: @v.District, @v.City</div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
                                <div>
                                    <span class="text-base font-black text-emerald-600">@v.PricePerDay.ToString("N0") đ</span>
                                    <span class="text-[10px] text-gray-400">/ngày</span>
                                </div>

                                <div class="flex items-center gap-2">
                                    <form action="/Host/ToggleStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button type="submit" class="text-xs font-bold px-3 py-1.5 rounded-xl border transition @(v.Status == VehicleStatus.Active ? "border-amber-200 text-amber-700 bg-amber-50 hover:bg-amber-100" : "border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100")">
                                            @(v.Status == VehicleStatus.Active ? "Tạm ngưng" : "Kích hoạt")
                                        </button>
                                    </form>
                                    <a href="/Vehicles/Details/@v.Id" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition">
                                        Xem
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
        <h2 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-2">
            <i class="bi bi-inbox-fill text-emerald-600"></i> Yêu cầu thuê xe gửi tới (@Model.IncomingBookings.Count)
        </h2>

        @if (!Model.IncomingBookings.Any())
        {
            <p class="text-xs text-gray-400 italic text-center py-6">Chưa có yêu cầu đặt xe nào gửi tới các xe của bạn.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="bg-gray-50 text-gray-400 font-bold uppercase border-b border-gray-100">
                        <tr>
                            <th class="py-3 px-4">Mã đơn</th>
                            <th class="py-3 px-4">Xe máy điện</th>
                            <th class="py-3 px-4">Khách thuê</th>
                            <th class="py-3 px-4">Thời gian thuê</th>
                            <th class="py-3 px-4">Tiền thuê</th>
                            <th class="py-3 px-4">Trạng thái</th>
                            <th class="py-3 px-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 font-semibold text-gray-700">
                        @foreach (var b in Model.IncomingBookings)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-3 px-4 font-mono font-bold text-gray-900">#@b.BookingCode</td>
                                <td class="py-3 px-4 font-bold text-emerald-700">@b.Vehicle.Brand @b.Vehicle.Model</td>
                                <td class="py-3 px-4">@b.Renter.FullName (@b.Renter.Phone)</td>
                                <td class="py-3 px-4">@b.StartTime.ToString("dd/MM") - @b.EndTime.ToString("dd/MM/yyyy") (@b.TotalDays ngày)</td>
                                <td class="py-3 px-4 font-bold text-gray-900">@b.RentalFee.ToString("N0") đ</td>
                                <td class="py-3 px-4">
                                    @switch (b.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Chờ duyệt</span>
                                            break;
                                        case BookingStatus.AwaitingPayment:
                                            <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Chờ khách cọc</span>
                                            break;
                                        case BookingStatus.Confirmed:
                                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Đã cọc 30%</span>
                                            break;
                                        case BookingStatus.InProgress:
                                            <span class="bg-purple-100 text-purple-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Đang thuê</span>
                                            break;
                                        case BookingStatus.Completed:
                                            <span class="bg-gray-100 text-gray-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Hoàn tất</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (b.Status == BookingStatus.Pending)
                                        {
                                            <form action="/Host/ApproveBooking" method="post" class="inline">
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 rounded-lg text-[11px] font-bold transition">
                                                    Duyệt đơn
                                                </button>
                                            </form>
                                        }
                                        <a href="/Bookings/Details/@b.Id" class="text-emerald-600 hover:underline text-[11px] font-bold">
                                            Chi tiết
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
