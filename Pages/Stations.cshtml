@page "/Home/Stations"
@{
    ViewData["Title"] = "Bản đồ Trạm sạc & Tủ đổi pin - EcoBike";
}

<!-- Leaflet CSS for High-Performance Interactive Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
    .leaflet-popup-content-wrapper {
        border-radius: 1rem;
        padding: 0.25rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }
    .user-pulse-marker {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #059669;
        border: 3px solid #ffffff;
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.35);
        animation: pulseRadar 2s infinite;
    }
    @@keyframes pulseRadar {
        0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6); }
        70% { box-shadow: 0 0 0 14px rgba(5, 150, 105, 0); }
        100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
    }
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 space-y-6">
    <!-- Top Banner (Bright Emerald-Teal) -->
    <div class="bg-gradient-to-r from-emerald-600 via-teal-500 to-emerald-700 rounded-2xl p-6 text-white border border-emerald-500 shadow-md flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white/20 backdrop-blur-xs text-white border border-white/30 px-2.5 py-0.5 rounded-md mb-2">
                <i class="bi bi-ev-station-fill text-amber-200"></i> Mạng lưới hỗ trợ năng lượng 24/7
            </span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Hệ thống Trạm sạc nhanh &amp; Tủ đổi pin</h1>
            <p class="mt-1 text-xs sm:text-sm text-emerald-50 max-w-2xl font-medium">
                Bản đồ tương tác trực tiếp Leaflet tra cứu vị trí trạm sạc V-GREEN (VinFast), trạm siêu tốc Dat Bike Charge và tủ đổi pin tự động Selex Motors với tính năng định vị GPS tìm trạm gần nhất.
            </p>
        </div>
        <div class="grid grid-cols-3 gap-3 text-center shrink-0">
            <div class="bg-white/15 backdrop-blur-xs border border-white/25 rounded-xl px-4 py-2.5">
                <div class="text-lg font-extrabold text-amber-200">150+</div>
                <div class="text-[11px] text-white font-medium">Điểm sạc &amp; Đổi pin</div>
            </div>
            <div class="bg-white/15 backdrop-blur-xs border border-white/25 rounded-xl px-4 py-2.5">
                <div class="text-lg font-extrabold text-white">2 phút</div>
                <div class="text-[11px] text-white font-medium">Đổi pin đầy 100%</div>
            </div>
            <div class="bg-white/15 backdrop-blur-xs border border-white/25 rounded-xl px-4 py-2.5">
                <div class="text-lg font-extrabold text-amber-200">24/7</div>
                <div class="text-[11px] text-white font-medium">Hoạt động liên tục</div>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar & GPS Nearest Locator -->
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-semibold">
            <button type="button" onclick="filterStations('all', this)" class="station-filter-btn px-3.5 py-2 rounded-lg bg-emerald-600 text-white transition">
                Tất cả trạm (11)
            </button>
            <button type="button" onclick="filterStations('TP.HCM', this)" class="station-filter-btn px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                TP. Hồ Chí Minh (4)
            </button>
            <button type="button" onclick="filterStations('Hà Nội', this)" class="station-filter-btn px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Hà Nội (4)
            </button>
            <button type="button" onclick="filterStations('Đà Nẵng', this)" class="station-filter-btn px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Đà Nẵng (3)
            </button>
            <button type="button" onclick="filterStations('Đổi pin', this)" class="station-filter-btn px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Tủ đổi pin 2 phút (4)
            </button>

            <!-- Nút Định vị GPS tìm trạm gần nhất -->
            <button type="button" id="btnGpsFind" onclick="findNearestStations()"
                    class="ml-auto sm:ml-0 px-3.5 py-2 rounded-lg bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold transition flex items-center gap-1.5 shadow-sm">
                <i class="bi bi-crosshair text-amber-300"></i>
                <span id="btnGpsText">Tìm trạm gần tôi nhất</span>
            </button>
        </div>

        <div class="relative w-full lg:w-72">
            <i class="bi bi-search absolute left-3 top-2.5 text-slate-400 text-xs"></i>
            <input id="stationSearchInput" type="text" oninput="searchStations()"
                   placeholder="Tìm tên đường, quận, thương hiệu..."
                   class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-emerald-600 focus:bg-white" />
        </div>
    </div>

    <!-- Main Content: Station Cards + Interactive Leaflet Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left 7 Cols: Station Cards (Aligns to top, no stretching) -->
        <div id="stationsGrid" class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 items-start content-start">
            
            <!-- Card 1 (TP.HCM) -->
            <div data-id="1" data-lat="10.7950" data-lng="106.7218" data-name="VinFast Landmark 81 Central Park" data-city="TP.HCM" data-type="Sạc nhanh"
                 class="station-card bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 hover:border-emerald-500 hover:shadow-md transition flex flex-col justify-between h-auto gap-3.5 shadow-2xs">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold px-2.5 py-0.5 rounded-lg flex items-center gap-1">
                            <i class="bi bi-lightning-charge-fill text-emerald-600"></i> Trạm sạc V-GREEN
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="distance-badge hidden bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full"></span>
                            <span class="text-emerald-600 font-semibold text-xs flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> 24/7
                            </span>
                        </div>
                    </div>
                    <h3 class="font-bold text-slate-900 text-base">VinFast Landmark 81 Central Park</h3>
                    <p class="text-xs text-slate-500 mt-1">
                        <i class="bi bi-geo-alt-fill text-emerald-600 mr-1"></i> Hầm B2, Vinhomes Central Park, Bình Thạnh, TP.HCM
                    </p>
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 text-xs space-y-1.5 mt-3">
                        <div class="flex justify-between"><span class="text-slate-500">Trạng thái cổng:</span> <strong class="text-emerald-700 font-bold">Trống 8 / 12 cổng</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Dòng xe hỗ trợ:</span> <strong class="text-slate-800">Evo200, Feliz S, Theon S</strong></div>
                    </div>
                    <div class="flex flex-wrap gap-1.5 mt-2.5">
