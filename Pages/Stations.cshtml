@page "/Home/Stations"
@{
    ViewData["Title"] = "Trạm sạc & Đổi pin - EcoBike";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Danh sách trạm sạc & tủ đổi pin</h1>
        <p class="mt-1 text-sm text-gray-500">
            Hệ thống điểm sạc nhanh V-GREEN, Dat Bike Charge và tủ đổi pin tự động hỗ trợ khách thuê xe
        </p>
    </div>

    <!-- Station Cards Grid -->
    <div id="stationsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Trạm sạc V-GREEN
                    </span>
                    <span class="text-emerald-600 font-medium text-xs">Hoạt động 24/7</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Trạm sạc VinFast Landmark 81</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> Tầng hầm B2, Vinhomes Central Park, Bình Thạnh, TP.HCM
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Số cổng sạc:</span> <strong class="text-gray-800">12 cổng (Trống 8)</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Công suất:</span> <strong class="text-gray-800">1.2 kW</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=Landmark+81+Vinhomes+Central+Park" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>

        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-blue-50 text-blue-700 border border-blue-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Tủ đổi pin tự động
                    </span>
                    <span class="text-emerald-600 font-medium text-xs">Hoạt động 24/7</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Tủ đổi pin EcoBike Bến Thành</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> 45 Lê Lợi, Phường Bến Thành, Quận 1, TP.HCM
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Pin sạc đầy có sẵn:</span> <strong class="text-gray-800">6 viên pin</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Thời gian thao tác:</span> <strong class="text-gray-800">Khoảng 1 phút</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=45+Le+Loi+Quan+1" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>

        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-amber-50 text-amber-700 border border-amber-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Trạm sạc nhanh Dat Bike
                    </span>
                    <span class="text-gray-600 font-medium text-xs">08:00 - 21:00</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Dat Bike Hub Điện Biên Phủ</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> 234 Điện Biên Phủ, Phường 15, Bình Thạnh, TP.HCM
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Số trụ sạc nhanh:</span> <strong class="text-gray-800">4 trụ sạc</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Tốc độ sạc:</span> <strong class="text-gray-800">100 km / 20 phút</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=234+Dien+Bien+Phu+Binh+Thanh" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>

        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Trạm sạc V-GREEN
                    </span>
                    <span class="text-emerald-600 font-medium text-xs">Hoạt động 24/7</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Trạm sạc V-GREEN Royal City</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> 72A Nguyễn Trãi, Thượng Đình, Thanh Xuân, Hà Nội
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Số cổng sạc:</span> <strong class="text-gray-800">20 cổng (Trống 14)</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Công suất:</span> <strong class="text-gray-800">1.2 kW</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=Royal+City+72A+Nguyen+Trai+Ha+Noi" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>

        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-blue-50 text-blue-700 border border-blue-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Tủ đổi pin Selex
                    </span>
                    <span class="text-emerald-600 font-medium text-xs">Hoạt động 24/7</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Trạm đổi pin Selex Cầu Giấy</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> 144 Xuân Thủy, Dịch Vọng Hậu, Cầu Giấy, Hà Nội
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Pin sạc đầy có sẵn:</span> <strong class="text-gray-800">9 viên pin</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Hỗ trợ dòng xe:</span> <strong class="text-gray-800">Selex Camel, Yadea</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=144+Xuan+Thuy+Cau+Giay+Ha+Noi" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>

        <div class="bg-white rounded-xl p-5 border border-gray-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-medium px-2.5 py-0.5 rounded">
                        Trạm sạc V-GREEN
                    </span>
                    <span class="text-emerald-600 font-medium text-xs">Hoạt động 24/7</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base">Trạm sạc Vincom Plaza Ngô Quyền</h3>
                <p class="text-xs text-gray-500 mt-1">
                    <i class="bi bi-geo-alt text-gray-400 mr-1"></i> 910A Ngô Quyền, An Hải Bắc, Sơn Trà, Đà Nẵng
                </p>
                <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1.5 mt-3">
                    <div class="flex justify-between"><span class="text-gray-500">Số cổng sạc:</span> <strong class="text-gray-800">16 cổng (Trống 11)</strong></div>
                    <div class="flex justify-between"><span class="text-gray-500">Công suất:</span> <strong class="text-gray-800">1.2 kW</strong></div>
                </div>
            </div>
            <a href="https://maps.google.com/?q=Vincom+Plaza+Ngo+Quyen+Da+Nang" target="_blank" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-xs py-2.5 rounded-lg transition text-center">
                Xem chỉ đường Google Maps
            </a>
        </div>
    </div>
</div>
