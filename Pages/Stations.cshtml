        { id: 11, name: "Tủ đổi pin Selex Ngũ Hành Sơn", lat: 16.0465, lng: 108.2435, city: "Đà Nẵng", type: "Đổi pin", slots: "7 viên pin LFP", address: "284 Võ Nguyên Giáp, Ngũ Hành Sơn" }
    ];

    document.addEventListener("DOMContentLoaded", function () {
        initLeafletMap();
    });

    function initLeafletMap() {
        if (typeof L === 'undefined') return;

        // Khởi tạo bản đồ với vị trí mặc định tại Landmark 81 TP.HCM
        stationMap = L.map('leafletStationMap', {
            zoomControl: true,
            scrollWheelZoom: false
        }).setView([10.7950, 106.7218], 13);

        // Nạp lớp bản đồ OpenStreetMap mượt mà
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap &amp; EcoBike'
        }).addTo(stationMap);

        // Thêm markers cho toàn bộ 11 trạm sạc
        STATIONS_DATA.forEach(st => {
            const isSwap = st.type === "Đổi pin";
            const colorClass = isSwap ? "bg-blue-600" : (st.name.includes("Dat Bike") ? "bg-amber-600" : "bg-emerald-600");
            const iconSymbol = isSwap ? "bi-arrow-repeat" : "bi-lightning-charge-fill";

            const customIcon = L.divIcon({
                className: 'custom-pin',
                html: `<div class="${colorClass} text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg border-2 border-white transform hover:scale-110 transition cursor-pointer text-sm">
                           <i class="bi ${iconSymbol}"></i>
                       </div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32]
            });

            const marker = L.marker([st.lat, st.lng], { icon: customIcon }).addTo(stationMap);

            const popupContent = `
                <div class="p-1 space-y-1.5 text-xs text-slate-800">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold ${isSwap ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800'}">${st.type}</span>
                    <h4 class="font-bold text-sm text-slate-900 leading-snug">${st.name}</h4>
                    <p class="text-slate-500 text-[11px]"><i class="bi bi-geo-alt-fill text-emerald-600"></i> ${st.address}</p>
                    <div class="bg-slate-50 p-2 rounded-lg border border-slate-100 font-semibold text-emerald-700">${st.slots}</div>
                    <a href="https://maps.google.com/?q=${encodeURIComponent(st.name + ' ' + st.address)}" target="_blank" class="block text-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 rounded-lg transition text-[11px]">
                        <i class="bi bi-compass"></i> Chỉ đường Google Maps
                    </a>
                </div>
            `;
            marker.bindPopup(popupContent);
            markers[st.id] = marker;
        });
    }

    function focusStationLeaflet(id) {
        const st = STATIONS_DATA.find(s => s.id === id);
        if (!st || !stationMap) return;

        const label = document.getElementById('selectedStationLabel');
        if (label) label.textContent = st.name;

        stationMap.flyTo([st.lat, st.lng], 16, { duration: 1.2 });
        if (markers[id]) {
            setTimeout(() => markers[id].openPopup(), 600);
        }

        // Highlight thẻ trạm tương ứng
        document.querySelectorAll('.station-card').forEach(c => c.classList.remove('ring-2', 'ring-emerald-500'));
        const activeCard = document.querySelector(`.station-card[data-id="${id}"]`);
        if (activeCard) {
            activeCard.classList.add('ring-2', 'ring-emerald-500');
        }
    }

    function resetMapView() {
        if (!stationMap) return;
        const group = L.featureGroup(Object.values(markers));
        stationMap.fitBounds(group.getBounds().pad(0.1));
    }

    // =========================================================================
    // TÍNH NĂNG NÂNG CẤP: ĐỊNH VỊ GPS VÀ TÌM TRẠM SẠC GẦN NHẤT
    // =========================================================================
    function deg2rad(deg) {
        return deg * (Math.PI / 180);
    }

    function getDistanceKm(lat1, lon1, lat2, lon2) {
        const R = 6371; // Bán kính trái đất (km)
        const dLat = deg2rad(lat2 - lat1);
        const dLon = deg2rad(lon2 - lon1);
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                  Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) *
                  Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return Math.round((R * c) * 10) / 10;
    }

    function findNearestStations() {
        const btnText = document.getElementById('btnGpsText');
        if (btnText) btnText.textContent = "Đang định vị...";

        if (!navigator.geolocation) {
            alert("Trình duyệt của bạn không hỗ trợ định vị GPS.");
            if (btnText) btnText.textContent = "Tìm trạm gần tôi nhất";
            return;
        }

        navigator.geolocation.getCurrentPosition(
            function (position) {
                const userLat = position.coords.latitude;
                const userLng = position.coords.longitude;
                handleUserLocation(userLat, userLng);
            },
            function (err) {
                // Fallback mô phỏng vị trí trung tâm TP.HCM nếu người dùng chặn quyền định vị
                console.warn("Geolocation denied or error, using default center:", err);
                const fallbackLat = 10.7769;
                const fallbackLng = 106.7009;
                handleUserLocation(fallbackLat, fallbackLng, true);
            },
            { timeout: 7000, enableHighAccuracy: true }
        );
    }

    function handleUserLocation(userLat, userLng, isSimulated = false) {
        const btnText = document.getElementById('btnGpsText');
        if (btnText) btnText.textContent = isSimulated ? "Trạm gần vị trí của bạn" : "Đã xác định vị trí!";

        // Thêm hoặc cập nhật User Marker trên bản đồ Leaflet
        if (stationMap) {
            if (userMarker) stationMap.removeLayer(userMarker);

            const userIcon = L.divIcon({
                className: 'user-pulse-marker',
                iconSize: [18, 18],
                iconAnchor: [9, 9]
            });
            userMarker = L.marker([userLat, userLng], { icon: userIcon }).addTo(stationMap);
            userMarker.bindPopup(`<b><i class="bi bi-person-fill text-emerald-600"></i> Vị trí của bạn</b>${isSimulated ? ' (Mặc định)' : ''}`).openPopup();
        }

        // Tính khoảng cách cho từng trạm và gán badge
        const cards = Array.from(document.querySelectorAll('.station-card'));
        const distanceMap = [];

        cards.forEach(card => {
            const lat = parseFloat(card.getAttribute('data-lat'));
            const lng = parseFloat(card.getAttribute('data-lng'));
            const dist = getDistanceKm(userLat, userLng, lat, lng);
            const id = parseInt(card.getAttribute('data-id'));

            distanceMap.push({ card, dist, id, lat, lng });

            const badge = card.querySelector('.distance-badge');
            if (badge) {
                badge.innerHTML = `<i class="bi bi-geo-alt-fill"></i> Cách ${dist} km`;
                badge.classList.remove('hidden');
            }
        });

        // Sắp xếp các thẻ trạm từ gần nhất đến xa nhất
        distanceMap.sort((a, b) => a.dist - b.dist);
        const grid = document.getElementById('stationsGrid');
        if (grid) {
            distanceMap.forEach(item => grid.appendChild(item.card));
        }

        // Highlight trạm gần nhất và zoom bản đồ bao quát
        const nearest = distanceMap[0];
        if (nearest && stationMap) {
            focusStationLeaflet(nearest.id);
            if (typeof window.showToast === 'function') {
                window.showToast(`Trạm gần bạn nhất: ${STATIONS_DATA.find(s => s.id === nearest.id)?.name} (Cách ${nearest.dist} km)`, 'success');
            }
        }
    }

    // =========================================================================
    // LỌC VÀ TÌM KIẾM TRẠM
    // =========================================================================
    function filterStations(criteria, btn) {
        document.querySelectorAll('.station-filter-btn').forEach(b => {
            b.classList.remove('bg-emerald-600', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
        });
        if (btn) {
            btn.classList.remove('bg-slate-100', 'text-slate-700');
            btn.classList.add('bg-emerald-600', 'text-white');
        }

        const visibleBounds = [];

        document.querySelectorAll('.station-card').forEach(card => {
            const city = card.getAttribute('data-city') || '';
            const type = card.getAttribute('data-type') || '';
            const id = parseInt(card.getAttribute('data-id'));
            const isMatch = (criteria === 'all' || city === criteria || type === criteria);

            card.style.display = isMatch ? '' : 'none';

            if (markers[id]) {
                if (isMatch) {
                    markers[id].addTo(stationMap);
                    visibleBounds.push(markers[id].getLatLng());
                } else {
                    stationMap.removeLayer(markers[id]);
                }
            }
        });

        if (stationMap && visibleBounds.length > 0) {
            const group = L.featureGroup(visibleBounds.map(ll => L.marker(ll)));
            stationMap.fitBounds(group.getBounds().pad(0.15));
        }
    }

    function searchStations() {
        const q = (document.getElementById('stationSearchInput')?.value || '').toLowerCase().trim();
        document.querySelectorAll('.station-card').forEach(card => {
            const text = card.innerText.toLowerCase();
            const id = parseInt(card.getAttribute('data-id'));
            const isMatch = (!q || text.includes(q));

            card.style.display = isMatch ? '' : 'none';
            if (markers[id]) {
                if (isMatch) {
                    markers[id].addTo(stationMap);
                } else {
                    stationMap.removeLayer(markers[id]);
                }
            }
        });
    }
</script>
