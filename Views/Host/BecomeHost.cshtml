@{
    ViewData["Title"] = "Trở thành đối tác Chủ xe EcoBike";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Banner -->
    <div class="bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl space-y-4">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-xs font-black uppercase tracking-wider">
                <i class="bi bi-lightning-charge-fill text-amber-300"></i> Kinh tế chia sẻ xanh
            </span>
            <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
                Biến Chiếc Xe Máy Điện Của Bạn Thành Cỗ Máy Sinh Lời Bền Vững
            </h1>
            <p class="text-sm sm:text-base text-emerald-50 leading-relaxed font-medium">
                Gia nhập mạng lưới hơn 500+ chủ xe VinFast & Dat Bike trên EcoBike. Kiếm thêm từ <strong>4.000.000đ - 10.000.000đ/tháng</strong> từ xe máy điện nhàn rỗi trong khi vẫn chủ động lịch di chuyển.
            </p>

            <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
                <form asp-action="BecomeHostConfirmed" method="post" class="w-full sm:w-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" 
                            class="w-full sm:w-auto px-8 py-4 bg-white text-emerald-800 hover:bg-emerald-50 font-black text-sm rounded-2xl shadow-lg transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                        <i class="bi bi-check-circle-fill text-emerald-600 text-lg"></i> KÍCH HOẠT QUYỀN CHỦ XE NGAY (MIỄN PHÍ)
                    </button>
                </form>
                <a href="#benefits" class="text-xs font-bold text-white/90 hover:text-white underline py-2">
                    Tìm hiểu thêm quyền lợi
                </a>
            </div>
        </div>

        <div class="hidden lg:block absolute -right-10 -bottom-10 opacity-15 text-[280px]">
            <i class="bi bi-bicycle"></i>
        </div>
    </div>

    <!-- 3 Core Advantages -->
    <div id="benefits" class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl">
                <i class="bi bi-wallet2"></i>
            </div>
            <h3 class="font-black text-gray-900 text-base">Thu Nhập Thụ Động Cao</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
                EcoBike giữ phí sàn thấp nhất thị trường (chỉ 15%). Bạn nhận 85% doanh thu thuê xe được quyết toán minh bạch.
            </p>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl">
                <i class="bi bi-shield-check"></i>
            </div>
            <h3 class="font-black text-gray-900 text-base">Bảo Hiểm & An Toàn 100%</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
                Tất cả khách thuê đều bắt buộc eKYC xác thực CCCD & GPLX A1 hợp lệ. Hợp đồng điện tử pháp lý và tiền cọc rõ ràng.
            </p>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl">
                <i class="bi bi-sliders"></i>
            </div>
            <h3 class="font-black text-gray-900 text-base">Chủ Động Khóa Lịch Xe</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
                Dễ dàng khóa lịch xe khi bạn cần sử dụng, điều chỉnh giá thuê theo mùa cao điểm và kiểm soát ODO hành trình.
            </p>
        </div>
    </div>

    <!-- Workflow: 3 Bước Bắt Đầu -->
    <div class="mt-12 bg-white rounded-3xl border border-gray-100 shadow-sm p-8">
        <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-2">
            <i class="bi bi-signpost-split-fill text-emerald-600"></i> Quy trình 3 bước trở thành đối tác
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
            <div class="flex items-start gap-4">
                <span class="w-10 h-10 rounded-2xl bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">1</span>
                <div>
                    <h4 class="font-bold text-gray-900 text-sm">Kích hoạt tài khoản</h4>
                    <p class="text-xs text-gray-500 mt-1">Bấm nút kích hoạt để nâng cấp vai trò của bạn từ Khách thuê lên Chủ xe.</p>
                </div>
            </div>

            <div class="flex items-start gap-4">
                <span class="w-10 h-10 rounded-2xl bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">2</span>
                <div>
                    <h4 class="font-bold text-gray-900 text-sm">Đăng tải xe máy điện</h4>
                    <p class="text-xs text-gray-500 mt-1">Nhập biển số, loại pin (LFP/Lithium), giá thuê mong muốn và hình ảnh xe.</p>
                </div>
            </div>

            <div class="flex items-start gap-4">
                <span class="w-10 h-10 rounded-2xl bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">3</span>
                <div>
                    <h4 class="font-bold text-gray-900 text-sm">Nhận đơn & Giao xe</h4>
                    <p class="text-xs text-gray-500 mt-1">Nhận thông báo khi có khách đặt cọc, bàn giao xe và nhận thu nhập định kỳ.</p>
                </div>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 text-center">
            <form asp-action="BecomeHostConfirmed" method="post" class="inline-block">
                @Html.AntiForgeryToken()
                <button type="submit" 
                        class="px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-2xl shadow-lg shadow-emerald-600/30 transition flex items-center gap-2">
                    <i class="bi bi-rocket-takeoff-fill"></i> TÔI ĐÃ SẴN SÀNG - KÍCH HOẠT TÀI KHOẢN NGAY
                </button>
            </form>
        </div>
    </div>
</div>
