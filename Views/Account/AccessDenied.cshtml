@{
    ViewData["Title"] = "403 - Quyền truy cập bị từ chối";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "";
    var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Khách";
    var userName = User.Identity?.Name ?? "Người dùng chưa đăng nhập";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-16">
    <div class="bg-white rounded-3xl border border-gray-100 shadow-xl overflow-hidden">
        <!-- Banner Top -->
        <div class="bg-gradient-to-r from-rose-500 via-amber-500 to-orange-500 p-8 text-white text-center relative overflow-hidden">
            <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-3xl flex items-center justify-center mx-auto text-4xl shadow-inner mb-4">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            <span class="inline-block px-3 py-1 bg-white/25 backdrop-blur-sm rounded-full text-xs font-black tracking-wider uppercase mb-2">
                HTTP 403 Forbidden
            </span>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight">Khu Vực Giới Hạn Quyền Truy Cập</h1>
            <p class="text-white/90 text-xs sm:text-sm mt-1 max-w-md mx-auto">
                Tài khoản của bạn hiện không có đủ đặc quyền để thao tác hoặc xem nội dung tại trang này.
            </p>
        </div>

        <!-- Body Info -->
        <div class="p-8 space-y-6">
            <!-- Current User Status Card -->
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5">
                <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">
                    Thông tin phiên đăng nhập hiện tại
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 font-black flex items-center justify-center text-sm">
                            <i class="bi bi-person-circle text-2xl"></i>
                        </div>
                        <div>
                            <div class="font-bold text-gray-900 text-sm">@userName</div>
                            <div class="text-xs text-gray-500">Đang hoạt động trên hệ sinh thái EcoBike</div>
                        </div>
                    </div>
                    <div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black border
                            @(currentRole == "Admin" ? "bg-purple-50 text-purple-700 border-purple-200" :
                              currentRole == "Host" ? "bg-blue-50 text-blue-700 border-blue-200" :
                              "bg-emerald-50 text-emerald-700 border-emerald-200")">
                            <i class="bi bi-shield-check"></i> Vai trò: @currentRole
                        </span>
                    </div>
                </div>
            </div>

            <!-- Role Explanation -->
            <div class="space-y-3 text-xs text-gray-600 bg-amber-50/70 border border-amber-200 rounded-2xl p-5">
                <div class="font-bold text-amber-900 flex items-center gap-2 text-sm">
                    <i class="bi bi-info-circle-fill text-amber-600"></i> Cơ chế phân quyền hệ thống EcoBike:
                </div>
                <ul class="space-y-1.5 list-disc list-inside text-gray-700">
                    <li><strong>Quản Trị Viên (Admin):</strong> Toàn quyền kiểm duyệt xe, duyệt hồ sơ eKYC GPLX, quản lý người dùng và doanh thu sàn.</li>
                    <li><strong>Chủ Xe (Host):</strong> Quản lý danh sách xe máy điện, duyệt yêu cầu thuê xe, khóa lịch bận và nhận doanh thu.</li>
                    <li><strong>Khách Thuê (Renter):</strong> Tìm kiếm xe, đặt xe, ký hợp đồng điện tử và nghiệm thu nhận/trả xe.</li>
                </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
                <a asp-controller="Home" asp-action="Index" 
                   class="w-full sm:w-1/2 py-3 px-5 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs transition text-center flex items-center justify-center gap-2">
                    <i class="bi bi-house-door-fill"></i> Về Trang Chủ
                </a>

                @if (currentRole == "Renter")
                {
                    <form asp-controller="Account" asp-action="UpgradeToHost" method="post" class="w-full sm:w-1/2">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="w-full py-3 px-5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition text-center flex items-center justify-center gap-2">
                            <i class="bi bi-arrow-up-circle-fill"></i> Nâng Cấp Lên Chủ Xe (Host)
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" 
                       class="w-full sm:w-1/2 py-3 px-5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition text-center flex items-center justify-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập Tài Khoản Khác
                    </a>
                }
            </div>

            <!-- Quick Demo Role Switcher for Thesis Defense -->
            <div class="pt-4 border-t border-gray-100">
                <div class="text-[11px] font-black uppercase text-gray-400 tracking-wider text-center mb-3">
                    <i class="bi bi-mortarboard-fill text-purple-600 mr-1"></i> Dành Cho Hội Đồng Chấm Đồ Án (Chuyển vai trò 1 chạm để kiểm tra phân quyền)
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <!-- Admin -->
                    <form asp-controller="Account" asp-action="QuickLogin" method="post">
                        <input type="hidden" name="email" value="admin@mioto.vn" />
                        <input type="hidden" name="returnUrl" value="@(string.IsNullOrEmpty(returnUrl) ? "/Admin" : returnUrl)" />
                        <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs font-bold transition flex items-center justify-center gap-1.5">
                            <i class="bi bi-shield-lock-fill"></i> Vào vai Admin
                        </button>
                    </form>

                    <!-- Host -->
                    <form asp-controller="Account" asp-action="QuickLogin" method="post">
                        <input type="hidden" name="email" value="chuxe@gmail.com" />
                        <input type="hidden" name="returnUrl" value="@(string.IsNullOrEmpty(returnUrl) ? "/Host" : returnUrl)" />
                        <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 text-xs font-bold transition flex items-center justify-center gap-1.5">
                            <i class="bi bi-speedometer2"></i> Vào vai Chủ Xe
                        </button>
                    </form>

                    <!-- Renter -->
                    <form asp-controller="Account" asp-action="QuickLogin" method="post">
                        <input type="hidden" name="email" value="khachthue@gmail.com" />
                        <input type="hidden" name="returnUrl" value="/Home/Index" />
                        <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-xs font-bold transition flex items-center justify-center gap-1.5">
                            <i class="bi bi-person-fill"></i> Vào vai Khách Thuê
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
