@model MiotoCarRental.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tài khoản";
}

<div class="max-w-md mx-auto px-4 sm:px-6 py-10">
    <!-- Main Login Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-xl space-y-6">
        <!-- Logo & Title -->
        <div class="text-center space-y-2">
            <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto text-2xl shadow-sm">
                <i class="bi bi-person-fill-lock"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight">Đăng nhập EcoBike</h1>
            <p class="text-xs text-gray-500">Nền tảng chia sẻ & cho thuê xe máy điện thông minh</p>
        </div>

        <!-- Form Login -->
        <form asp-action="Login" method="post" id="loginForm" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 text-red-700 text-xs rounded-xl font-semibold"></div>

            <!-- Email Input -->
            <div>
                <label asp-for="Email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    <i class="bi bi-envelope text-emerald-600 mr-1"></i> Email
                </label>
                <input asp-for="Email" id="inputEmail" placeholder="vd: khachthue@gmail.com" 
                       class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Password Input with Show/Hide Toggle -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label asp-for="Password" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        <i class="bi bi-key text-emerald-600 mr-1"></i> Mật khẩu
                    </label>
                    <a href="#" class="text-[11px] font-bold text-emerald-600 hover:underline">Quên mật khẩu?</a>
                </div>
                <div class="relative">
                    <input asp-for="Password" id="inputPassword" type="password" placeholder="Nhập mật khẩu..." 
                           class="w-full bg-gray-50 border border-gray-200 rounded-2xl pl-4 pr-11 py-3 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" />
                    <button type="button" onclick="togglePasswordVisibility()" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-sm focus:outline-none" 
                            title="Hiện/Ẩn mật khẩu">
                        <i id="passwordToggleIcon" class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between">
                <label class="flex items-center text-xs font-semibold text-gray-600 cursor-pointer">
                    <input asp-for="RememberMe" class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500" />
                    <span class="ml-2">Ghi nhớ đăng nhập</span>
                </label>
            </div>

            <!-- Submit CTA -->
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3.5 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                <i class="bi bi-box-arrow-in-right"></i> ĐĂNG NHẬP NGAY
            </button>
        </form>

        <!-- Divider -->
        <div class="relative my-4 text-center">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
            <span class="relative bg-white px-3 text-[11px] font-bold uppercase text-gray-400">Hoặc thử nghiệm phân quyền</span>
        </div>

        <!-- Quick Login Demo Buttons (Phân quyền 3 vai trò) -->
        <div class="bg-gradient-to-b from-gray-50 to-gray-100/70 p-4 rounded-2xl border border-gray-200 space-y-3">
            <div class="text-center">
                <span class="text-[11px] font-black uppercase text-gray-600 flex items-center justify-center gap-1">
                    <i class="bi bi-mortarboard-fill text-purple-600"></i> Tài Khoản Kiểm Thử Đồ Án (3 Vai Trò)
                </span>
                <p class="text-[10px] text-gray-400 mt-0.5">Bấm <strong>1 chạm</strong> để đăng nhập ngay hoặc <strong>điền mẫu</strong> để kiểm tra form</p>
            </div>

            <div class="space-y-2">
                <!-- 1. Renter -->
                <div class="bg-white p-2.5 rounded-xl border border-emerald-100 shadow-sm flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <div class="text-xs font-bold text-gray-800 flex items-center gap-1 truncate">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            Khách thuê (Renter)
                        </div>
                        <div class="text-[10px] text-gray-400 font-mono truncate">khachthue@gmail.com • pass: renter123</div>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" onclick="fillCredentials('khachthue@gmail.com', 'renter123')" 
                                class="text-[10px] font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1.5 rounded-lg transition" title="Điền vào form phía trên">
                            Điền form
                        </button>
                        <form asp-action="QuickLogin" method="post" class="inline">
                            <input type="hidden" name="email" value="khachthue@gmail.com" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="text-[10px] font-bold bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 rounded-lg transition shadow-sm">
                                1 Chạm
                            </button>
                        </form>
                    </div>
                </div>

                <!-- 2. Host -->
                <div class="bg-white p-2.5 rounded-xl border border-blue-100 shadow-sm flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <div class="text-xs font-bold text-gray-800 flex items-center gap-1 truncate">
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                            Chủ xe (Host)
                        </div>
                        <div class="text-[10px] text-gray-400 font-mono truncate">chuxe@gmail.com • pass: host123</div>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" onclick="fillCredentials('chuxe@gmail.com', 'host123')" 
                                class="text-[10px] font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1.5 rounded-lg transition" title="Điền vào form phía trên">
                            Điền form
                        </button>
                        <form asp-action="QuickLogin" method="post" class="inline">
                            <input type="hidden" name="email" value="chuxe@gmail.com" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="text-[10px] font-bold bg-blue-600 hover:bg-blue-700 text-white px-2.5 py-1.5 rounded-lg transition shadow-sm">
                                1 Chạm
                            </button>
                        </form>
                    </div>
                </div>

                <!-- 3. Admin -->
                <div class="bg-white p-2.5 rounded-xl border border-purple-100 shadow-sm flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <div class="text-xs font-bold text-gray-800 flex items-center gap-1 truncate">
                            <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                            Quản trị viên (Admin)
                        </div>
                        <div class="text-[10px] text-gray-400 font-mono truncate">admin@mioto.vn • pass: admin123</div>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" onclick="fillCredentials('admin@mioto.vn', 'admin123')" 
                                class="text-[10px] font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1.5 rounded-lg transition" title="Điền vào form phía trên">
                            Điền form
                        </button>
                        <form asp-action="QuickLogin" method="post" class="inline">
                            <input type="hidden" name="email" value="admin@mioto.vn" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="text-[10px] font-bold bg-purple-600 hover:bg-purple-700 text-white px-2.5 py-1.5 rounded-lg transition shadow-sm">
                                1 Chạm
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Register Link -->
        <p class="text-center text-xs text-gray-500 font-semibold pt-1">
            Bạn chưa có tài khoản? 
            <a asp-action="Register" class="font-bold text-emerald-600 hover:underline">Đăng ký ngay</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("inputPassword");
            var icon = document.getElementById("passwordToggleIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }

        function fillCredentials(email, password) {
            var emailInput = document.getElementById("inputEmail");
            var passInput = document.getElementById("inputPassword");
            emailInput.value = email;
            passInput.value = password;

            // Hiệu ứng highlight form
            emailInput.classList.add("ring-2", "ring-emerald-500");
            passInput.classList.add("ring-2", "ring-emerald-500");
            setTimeout(function () {
                emailInput.classList.remove("ring-2", "ring-emerald-500");
                passInput.classList.remove("ring-2", "ring-emerald-500");
            }, 800);
        }
    </script>
}
