@model List<MiotoCarRental.Models.Entities.Booking>
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = "Chuyến đi của tôi";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900">Chuyến đi của tôi</h1>
            <p class="text-xs text-gray-500 mt-1">Lịch sử đặt thuê xe tự lái và trạng thái hành trình</p>
        </div>
        <a asp-controller="Vehicles" asp-action="Index" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-5 py-3 rounded-2xl shadow-md transition">
            <i class="bi bi-plus-lg mr-1"></i> Thuê thêm xe khác
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-gray-100 shadow-sm">
            <i class="bi bi-calendar-x text-5xl text-gray-300"></i>
            <h3 class="text-lg font-bold text-gray-800 mt-4">Bạn chưa có chuyến đi nào</h3>
            <p class="text-xs text-gray-500 mt-1">Hãy khám phá ngay các dòng xe đời mới đang có sẵn trên hệ thống.</p>
            <a asp-controller="Vehicles" asp-action="Index" class="mt-4 inline-block bg-emerald-600 text-white font-bold text-xs px-6 py-3 rounded-xl">
                Khám phá xe ngay
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var b in Model)
            {
                <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm hover:shadow-md transition flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div class="flex items-center gap-5">
                        <img src="@b.Vehicle.ThumbnailUrl" class="w-24 h-20 object-cover rounded-2xl" />
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-mono text-xs font-bold text-gray-400">#@b.BookingCode</span>
                                @switch (b.Status)
                                {
                                    case BookingStatus.AwaitingPayment:
                                    case BookingStatus.Pending:
                                        <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Chờ thanh toán cọc</span>
                                        break;
                                    case BookingStatus.Confirmed:
                                        <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Đã cọc (Chờ nhận xe)</span>
                                        break;
                                    case BookingStatus.InProgress:
                                        <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Đang đi</span>
                                        break;
                                    case BookingStatus.Completed:
                                        <span class="bg-gray-100 text-gray-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Hoàn thành</span>
                                        break;
                                }
                            </div>
                            <h3 class="text-lg font-black text-gray-900">@b.Vehicle.Brand @b.Vehicle.Model</h3>
                            <p class="text-xs text-gray-500 mt-0.5">
                                <i class="bi bi-calendar-event text-emerald-600"></i> @b.StartTime.ToString("dd/MM/yyyy") - @b.EndTime.ToString("dd/MM/yyyy") (@b.TotalDays ngày)
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center justify-between w-full md:w-auto md:gap-8 pt-4 md:pt-0 border-t md:border-t-0 border-gray-100">
                        <div class="text-left md:text-right">
                            <span class="text-xs text-gray-400 block font-semibold">Tổng tiền:</span>
                            <span class="text-lg font-black text-emerald-600">@((b.TotalAmount + b.ExtraKmFee).ToString("N0")) đ</span>
                        </div>
                        <a asp-action="Details" asp-route-id="@b.Id" class="bg-gray-900 hover:bg-emerald-600 text-white text-xs font-bold px-5 py-3 rounded-2xl transition">
                            Chi tiết chuyến
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
