@model MiotoCarRental.Models.Entities.Booking
@using MiotoCarRental.Models.Entities
@{
    ViewData["Title"] = $"Đơn đặt xe #{Model.BookingCode}";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Chi tiết đơn đặt xe</span>
            <h1 class="text-3xl font-black text-gray-900 mt-1">#@Model.BookingCode</h1>
            <p class="text-xs text-gray-400 mt-1">Tạo lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Contract" asp-route-id="@Model.Id" target="_blank" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs px-3.5 py-2 rounded-xl border border-indigo-200 transition flex items-center gap-1.5 shadow-sm">
                <i class="bi bi-file-earmark-text-fill text-indigo-600"></i> Xem Hợp đồng điện tử
            </a>
            @switch (Model.Status)
            {
                case BookingStatus.AwaitingPayment:
                case BookingStatus.Pending:
                    <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-300">
                        <i class="bi bi-clock-history"></i> Chờ thanh toán cọc
                    </span>
                    break;
                case BookingStatus.Confirmed:
                    <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-300">
                        <i class="bi bi-check-circle-fill"></i> Đã cọc giữ chỗ (Chờ nhận xe)
                    </span>
                    break;
                case BookingStatus.InProgress:
                    <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-300">
                        <i class="bi bi-car-front-fill"></i> Đang trong hành trình
                    </span>
                    break;
                case BookingStatus.Completed:
                    <span class="bg-gray-100 text-gray-800 text-xs font-bold px-3 py-1.5 rounded-full border border-gray-300">
                        <i class="bi bi-flag-fill"></i> Chuyến đi đã hoàn tất
                    </span>
                    break;
                default:
                    <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1.5 rounded-full">@Model.Status</span>
                    break;
            }
        </div>
    </div>

    <!-- Booking Summary Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
        <!-- Vehicle Card -->
        <div class="flex items-center gap-5 p-4 bg-gray-50 rounded-2xl">
            <img src="@Model.Vehicle.ThumbnailUrl" class="w-24 h-20 object-cover rounded-xl" />
            <div>
                <span class="text-xs font-bold text-gray-400 uppercase">@Model.Vehicle.Brand</span>
                <h3 class="text-lg font-black text-gray-900">@Model.Vehicle.Brand @Model.Vehicle.Model</h3>
                <span class="text-xs text-gray-500 block">Biển số: <strong class="text-gray-800">@Model.Vehicle.LicensePlate</strong></span>
                <span class="text-xs text-gray-500 block">Địa chỉ nhận xe: @Model.Vehicle.Address, @Model.Vehicle.City</span>
            </div>
        </div>

        <!-- Schedule details -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-y border-gray-100 py-4 text-xs">
            <div>
                <span class="text-gray-400 block mb-1">Thời gian nhận xe</span>
                <span class="font-bold text-gray-900 text-sm flex items-center gap-1.5">
                    <i class="bi bi-calendar-check text-emerald-600"></i> @Model.StartTime.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
            <div>
                <span class="text-gray-400 block mb-1">Thời gian trả xe</span>
                <span class="font-bold text-gray-900 text-sm flex items-center gap-1.5">
                    <i class="bi bi-calendar-x text-emerald-600"></i> @Model.EndTime.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
        </div>

        <!-- Cost breakdown -->
        <div class="space-y-2 text-xs">
            <h4 class="font-bold text-gray-900 text-sm mb-3">Chi tiết thanh toán</h4>
            <div class="flex justify-between text-gray-600">
                <span>Tiền thuê xe (@Model.TotalDays ngày):</span>
                <span class="font-bold text-gray-800">@Model.RentalFee.ToString("N0") đ</span>
            </div>
            <div class="flex justify-between text-gray-600">
                <span>Phí bảo hiểm chuyến đi (MIC):</span>
                <span class="font-bold text-gray-800">@Model.InsuranceFee.ToString("N0") đ</span>
            </div>
            @if (Model.DeliveryFee > 0)
            {
                <div class="flex justify-between text-gray-600">
                    <span>Phí giao xe tận nơi:</span>
                    <span class="font-bold text-gray-800">@Model.DeliveryFee.ToString("N0") đ</span>
                </div>
            }
            @if (Model.ExtraKmFee > 0)
            {
                <div class="flex justify-between text-red-600 font-bold">
                    <span>Phụ phí vượt số km:</span>
                    <span>+ @Model.ExtraKmFee.ToString("N0") đ</span>
                </div>
            }
            <div class="flex justify-between text-sm font-black text-gray-900 pt-2 border-t border-gray-100">
                <span>Tổng giá trị đơn:</span>
                <span class="text-emerald-600 text-base">@((Model.TotalAmount + Model.ExtraKmFee).ToString("N0")) đ</span>
            </div>
            <div class="flex justify-between text-xs font-bold text-emerald-700 bg-emerald-50 p-3 rounded-xl mt-2">
                <span>Tiền cọc giữ chỗ (30%):</span>
                <span>@Model.DepositAmount.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    <!-- ACTION SECTION BASED ON STATUS -->

    <!-- Case 1: Chờ thanh toán cọc 30% -->
    @if (Model.Status == BookingStatus.AwaitingPayment || Model.Status == BookingStatus.Pending)
    {
        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border border-emerald-100 shadow-xl text-center">
            <div class="max-w-md mx-auto space-y-4">
                <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">
                    <i class="bi bi-qr-code-scan"></i> Cổng thanh toán VietQR / PayOS
                </span>
                <h3 class="text-xl font-black text-gray-900">Quét mã QR để thanh toán cọc giữ chỗ</h3>
                <p class="text-xs text-gray-500">
                    Chuyển khoản <strong>@Model.DepositAmount.ToString("N0") đ</strong> (30% cọc) để hoàn tất giữ lịch xe.
                </p>

                <!-- Mock VietQR Code Image -->
                <div class="p-4 bg-gray-50 rounded-2xl border border-gray-200 inline-block shadow-inner">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=ECOBIKE-DEPOSIT-@Model.BookingCode" 
                         alt="QR Code" class="w-44 h-44 mx-auto rounded-lg" />
                    <span class="text-[10px] text-gray-400 block mt-2 font-mono">Nội dung CK: @Model.BookingCode</span>
                </div>

                <!-- Simulation Button for Course Defense / Testing -->
                <form asp-action="ConfirmPayment" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3.5 px-6 rounded-2xl shadow-lg shadow-emerald-600/30 transition">
                        <i class="bi bi-check2-circle mr-1"></i> [DEMO] Giả lập Xác nhận Đã Chuyển Khoản Thành Công
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Case 2: Đã cọc thành công -> Bàn giao nhận xe (Check-in) -->
    @if (Model.Status == BookingStatus.Confirmed)
    {
        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border border-blue-100 shadow-md">
            <h3 class="text-xl font-black text-gray-900 mb-2 flex items-center gap-2">
                <i class="bi bi-clipboard2-check-fill text-blue-600"></i> Bàn giao xe máy điện & Củ sạc (Check-in)
            </h3>
            <p class="text-xs text-gray-500 mb-6">Đồng kiểm tra số km đồng hồ điện tử, dung lượng pin LFP và bàn giao 02 nón bảo hiểm.</p>

            <form asp-action="Checkin" method="post" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Số ODO lúc nhận xe (km)</label>
                    <input type="number" name="odo" value="3200" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Dung lượng Pin LFP (%)</label>
                    <input type="number" name="fuelLevel" value="100" min="0" max="100" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div class="sm:col-span-2 pt-2">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-2xl shadow-md transition">
                        <i class="bi bi-key-fill mr-1"></i> Bàn giao xe máy điện & Bắt đầu hành trình
                    </button>
                </div>
            </form>
        </div>
    }

    <!-- Case 3: Đang trong chuyến đi -> Nghiệm thu trả xe (Check-out) -->
    @if (Model.Status == BookingStatus.InProgress)
    {
        <div class="mt-8 bg-white rounded-3xl p-6 sm:p-8 border border-amber-100 shadow-md">
            <h3 class="text-xl font-black text-gray-900 mb-2 flex items-center gap-2">
                <i class="bi bi-flag-fill text-amber-600"></i> Nghiệm thu trả xe máy điện (Check-out)
            </h3>
            <p class="text-xs text-gray-500 mb-6">
                ODO lúc nhận: <strong>@Model.CheckinOdo km</strong>. Định mức cho phép: <strong>@(Model.Vehicle.LimitKmPerDay * Model.TotalDays) km</strong>.
            </p>

            <form asp-action="Checkout" method="post" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Số ODO lúc trả xe (km)</label>
                    <input type="number" name="odo" value="@((Model.CheckinOdo ?? 3200) + 120)" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Dung lượng Pin lúc trả (%)</label>
                    <input type="number" name="fuelLevel" value="45" min="0" max="100" class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs font-bold" required />
                </div>
                <div class="sm:col-span-2 pt-2">
                    <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3.5 rounded-2xl shadow-md transition">
                        <i class="bi bi-check-circle mr-1"></i> Hoàn tất trả xe & Hoàn trả thế chấp
                    </button>
                </div>
            </form>
        </div>
    }

    <!-- Case 4: Hoàn tất chuyến đi & Đánh giá chuyến đi -->
    @if (Model.Status == BookingStatus.Completed)
    {
        <div class="mt-8 bg-emerald-50 rounded-3xl p-6 sm:p-8 border border-emerald-200">
            <div class="text-center mb-6">
                <i class="bi bi-patch-check-fill text-emerald-600 text-5xl"></i>
                <h3 class="text-2xl font-black text-emerald-950 mt-2">Chuyến đi đã hoàn thành xuất sắc!</h3>
                <p class="text-xs text-emerald-700 mt-1">Cảm ơn bạn đã lựa chọn di chuyển xanh cùng nền tảng EcoBike.</p>
            </div>

            @{
                var existingReview = Model.Reviews.FirstOrDefault();
            }

            @if (existingReview != null)
            {
                <div class="bg-white rounded-2xl p-6 border border-emerald-200 shadow-sm max-w-xl mx-auto">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Đánh giá của bạn</span>
                        <div class="text-amber-400 text-sm">
                            @for (int i = 0; i < existingReview.Rating; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-800 italic bg-gray-50 p-3 rounded-xl border border-gray-100">
                        "@existingReview.Comment"
                    </p>
                    <span class="text-[10px] text-gray-400 mt-2 block text-right">
                        Đã gửi lúc: @existingReview.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            }
            else
            {
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-lg max-w-xl mx-auto">
                    <h4 class="text-lg font-black text-gray-900 mb-2 flex items-center gap-2">
                        <i class="bi bi-star-fill text-amber-400"></i> Đánh giá trải nghiệm chuyến đi
                    </h4>
                    <p class="text-xs text-gray-500 mb-6">Đánh giá của bạn giúp cộng đồng EcoBike ngày càng hoàn thiện chất lượng dịch vụ.</p>

                    <form asp-action="AddReview" method="post" class="space-y-4">
                        <input type="hidden" name="bookingId" value="@Model.Id" />

                        <!-- Chọn số sao -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-2">Mức độ hài lòng của bạn:</label>
                            <div class="flex items-center gap-4">
                                @for (int star = 5; star >= 1; star--)
                                {
                                    <label class="flex items-center gap-1.5 cursor-pointer bg-gray-50 hover:bg-amber-50 px-3 py-2 rounded-xl border border-gray-200 transition">
                                        <input type="radio" name="rating" value="@star" @(star == 5 ? "checked" : "") class="text-emerald-600 focus:ring-emerald-500" />
                                        <span class="text-xs font-bold text-gray-800 flex items-center gap-1">
                                            @star <i class="bi bi-star-fill text-amber-400 text-xs"></i>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Gợi ý nhanh nhận xét -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1.5">Gợi ý nhận xét nhanh:</label>
                            <div class="flex flex-wrap gap-2 text-xs">
                                <button type="button" onclick="document.getElementById('commentBox').value += 'Xe pin rất trâu, chạy cực êm! '; " class="px-2.5 py-1 bg-gray-100 hover:bg-emerald-100 hover:text-emerald-800 text-gray-600 rounded-lg transition font-medium">
                                    ⚡ Xe pin trâu, chạy êm
                                </button>
                                <button type="button" onclick="document.getElementById('commentBox').value += 'Chủ xe nhiệt tình, giao xe đúng hẹn. '; " class="px-2.5 py-1 bg-gray-100 hover:bg-emerald-100 hover:text-emerald-800 text-gray-600 rounded-lg transition font-medium">
                                    🤝 Chủ xe nhiệt tình
                                </button>
                                <button type="button" onclick="document.getElementById('commentBox').value += 'Xe mới sạch sẽ, cốp rộng để đồ thoải mái. '; " class="px-2.5 py-1 bg-gray-100 hover:bg-emerald-100 hover:text-emerald-800 text-gray-600 rounded-lg transition font-medium">
                                    ✨ Xe mới, sạch đẹp
                                </button>
                            </div>
                        </div>

                        <!-- Nhận xét chi tiết -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Cảm nhận chi tiết:</label>
                            <textarea id="commentBox" name="comment" rows="3" placeholder="Chia sẻ thêm cảm nhận về khả năng vận hành của xe điện, thời lượng pin, củ sạc..." class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-3 text-xs focus:ring-2 focus:ring-emerald-500 focus:bg-white transition" required></textarea>
                        </div>

                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-2xl shadow-md transition flex items-center justify-center gap-2">
                            <i class="bi bi-send-fill"></i> GỬI ĐÁNH GIÁ CHUYẾN ĐI
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>
