@model MiotoCarRental.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Trung Tâm Quản Trị Hệ Thống EcoBike (Admin Portal)";
    var isAdmin = User.IsInRole("Admin");
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Admin -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between pb-6 border-b border-gray-200 gap-4">
        <div>
            <div class="flex items-center gap-3">
                <span class="p-2.5 bg-purple-600 text-white rounded-2xl shadow-md shadow-purple-200">
                    <i class="bi bi-shield-lock-fill text-2xl"></i>
                </span>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">EcoBike Admin Portal</h1>
                    <p class="text-xs sm:text-sm text-gray-500 font-medium">Bảng điều khiển quản trị, kiểm duyệt hồ sơ & giám sát hoạt động xe máy điện</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            @if (!isAdmin)
            {
                <form asp-controller="Account" asp-action="QuickLogin" method="post" class="inline">
                    <input type="hidden" name="email" value="admin@mioto.vn" />
                    <input type="hidden" name="returnUrl" value="/Admin" />
                    <button type="submit" class="bg-purple-100 hover:bg-purple-200 text-purple-800 text-xs font-bold py-2.5 px-4 rounded-xl transition border border-purple-300 flex items-center gap-2">
                        <i class="bi bi-person-check-fill"></i> Đổi sang tài khoản Admin gốc (admin@mioto.vn)
                    </button>
                </form>
            }
            <span class="bg-gray-100 text-gray-700 text-xs px-3 py-2 rounded-xl font-bold flex items-center gap-1.5 border border-gray-200">
                <i class="bi bi-clock-history"></i> Cập nhật: @DateTime.UtcNow.ToString("HH:mm:ss dd/MM/yyyy")
            </span>
        </div>
    </div>

    <!-- Alert Success / Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mt-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl flex items-center gap-3">
            <i class="bi bi-check-circle-fill text-emerald-600 text-lg"></i>
            <span class="text-sm font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mt-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-2xl flex items-center gap-3">
            <i class="bi bi-exclamation-triangle-fill text-red-600 text-lg"></i>
            <span class="text-sm font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- 4 KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
        <!-- Doanh thu sàn -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Doanh số toàn sàn</span>
                <span class="p-2 bg-emerald-50 text-emerald-600 rounded-xl text-lg">
                    <i class="bi bi-cash-stack"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-gray-900">@Model.TotalRevenue.ToString("N0") <span class="text-sm text-gray-400 font-semibold">đ</span></div>
            <span class="text-[11px] text-emerald-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-arrow-up-right"></i> Tổng giá trị giao dịch phát sinh
            </span>
        </div>

        <!-- Đội xe máy điện -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Đội xe máy điện</span>
                <span class="p-2 bg-blue-50 text-blue-600 rounded-xl text-lg">
                    <i class="bi bi-bicycle"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-gray-900">@Model.ActiveVehicles <span class="text-sm text-gray-400 font-semibold">/ @Model.TotalVehicles xe</span></div>
            <span class="text-[11px] text-blue-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-lightning-charge-fill"></i> Xe VinFast & Dat Bike sẵn sàng
            </span>
        </div>

        <!-- Đơn đặt xe -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Lượt thuê hoàn thành</span>
                <span class="p-2 bg-amber-50 text-amber-600 rounded-xl text-lg">
                    <i class="bi bi-check2-circle"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-gray-900">@Model.CompletedBookings <span class="text-sm text-gray-400 font-semibold">/ @Model.TotalBookings đơn</span></div>
            <span class="text-[11px] text-amber-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-calendar-check"></i> Chuyến đi đã nghiệm thu
            </span>
        </div>

        <!-- Hồ sơ GPLX chờ duyệt -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">GPLX A1 Chờ Duyệt</span>
                <span class="p-2 bg-purple-50 text-purple-600 rounded-xl text-lg">
                    <i class="bi bi-person-vcard-fill"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-gray-900">@Model.PendingLicenseCount <span class="text-sm text-gray-400 font-semibold">hồ sơ</span></div>
            <span class="text-[11px] text-purple-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-shield-check"></i> Cần kiểm duyệt eKYC
            </span>
        </div>
    </div>

    <!-- Section 1: Hồ sơ GPLX A1 Cần Duyệt -->
    <div class="mt-10 bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-black text-gray-900 flex items-center gap-2">
                    <i class="bi bi-person-vcard text-purple-600"></i> Phê Duyệt Hồ Sơ Giấy Phép Lái Xe (eKYC GPLX A1)
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">Xác minh bằng lái hợp lệ trước khi cho phép khách thuê nhận xe máy điện</p>
            </div>
            <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-bold">
                @Model.PendingLicenseUsers.Count hồ sơ cần xử lý
            </span>
        </div>

        @if (!Model.PendingLicenseUsers.Any())
        {
            <div class="p-8 text-center text-gray-400 text-sm">
                <i class="bi bi-check-circle text-3xl text-emerald-500 block mb-2"></i>
                Hiện tại không có hồ sơ GPLX nào đang chờ xử lý. Tất cả khách hàng đều đã được xác thực!
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-gray-50 text-gray-400 font-bold uppercase border-b border-gray-100">
                        <tr>
                            <th class="py-3.5 px-6">Khách hàng</th>
                            <th class="py-3.5 px-4">Số điện thoại</th>
                            <th class="py-3.5 px-4">Số GPLX A1</th>
                            <th class="py-3.5 px-4">Ảnh xác minh</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-6 text-right">Thao tác duyệt</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 font-medium">
                        @foreach (var u in Model.PendingLicenseUsers)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="py-4 px-6 flex items-center gap-3">
                                    <img src="@(u.AvatarUrl ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100")" class="w-8 h-8 rounded-full object-cover" />
                                    <div>
                                        <span class="font-bold text-gray-900 block">@u.FullName</span>
                                        <span class="text-[11px] text-gray-400">@u.Email</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4 font-bold text-gray-700">@u.Phone</td>
                                <td class="py-4 px-4 font-bold text-purple-700">@(string.IsNullOrEmpty(u.DriverLicenseNo) ? "Chưa điền số" : u.DriverLicenseNo)</td>
                                <td class="py-4 px-4">
                                    <a href="@(u.DriverLicenseImage ?? "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=600")" target="_blank" class="text-blue-600 hover:underline flex items-center gap-1 font-bold">
                                        <i class="bi bi-image"></i> Xem ảnh
                                    </a>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                        @u.DriverLicenseStatus
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right space-x-2">
                                    <form asp-action="ApproveLicense" method="post" class="inline">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-xl transition text-[11px] shadow-sm">
                                            <i class="bi bi-check-lg"></i> Duyệt
                                        </button>
                                    </form>
                                    <form asp-action="RejectLicense" method="post" class="inline">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <input type="hidden" name="reason" value="Ảnh chụp bị mờ, không rõ số hiệu GPLX A1" />
                                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 font-bold py-1.5 px-3 rounded-xl transition text-[11px] border border-red-200">
                                            <i class="bi bi-x-lg"></i> Từ chối
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Section 2: Quản lý Xe máy điện trên sàn -->
    <div class="mt-10 bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-black text-gray-900 flex items-center gap-2">
                    <i class="bi bi-bicycle text-emerald-600"></i> Quản Lý & Kiểm Duyệt Xe Máy Điện (@Model.Vehicles.Count xe)
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">Kiểm soát trạng thái hoạt động, thông số pin LFP và danh sách xe của các đối tác chủ xe</p>
            </div>
            <a asp-controller="Host" asp-action="Create" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2 px-3.5 rounded-xl transition flex items-center gap-1.5 shadow-sm">
                <i class="bi bi-plus-circle"></i> Thêm xe mới
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 text-gray-400 font-bold uppercase border-b border-gray-100">
                    <tr>
                        <th class="py-3.5 px-6">Mẫu xe điện</th>
                        <th class="py-3.5 px-4">Biển số</th>
                        <th class="py-3.5 px-4">Pin / Quãng đường</th>
                        <th class="py-3.5 px-4">Chủ xe</th>
                        <th class="py-3.5 px-4">Giá thuê / ngày</th>
                        <th class="py-3.5 px-4">Trạng thái</th>
                        <th class="py-3.5 px-6 text-right">Khóa / Mở khóa</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    @foreach (var v in Model.Vehicles)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <img src="@v.ThumbnailUrl" class="w-12 h-10 rounded-xl object-cover border border-gray-200" />
                                <div>
                                    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@v.Id" class="font-bold text-gray-900 hover:text-emerald-600 block">
                                        @v.Brand @v.Model
                                    </a>
                                    <span class="text-[11px] text-gray-400">@v.City - @v.District</span>
                                </div>
                            </td>
                            <td class="py-4 px-4 font-mono font-bold text-gray-800">@v.LicensePlate</td>
                            <td class="py-4 px-4">
                                <span class="font-bold text-emerald-700">@v.BatteryRangeKm km/sạc</span>
                                <span class="block text-[10px] text-gray-400">@v.BatteryType</span>
                            </td>
                            <td class="py-4 px-4 font-bold text-gray-700">@(v.Host?.FullName ?? "N/A")</td>
                            <td class="py-4 px-4 font-bold text-gray-900">@v.PricePerDay.ToString("N0") đ</td>
                            <td class="py-4 px-4">
                                @if (v.Status == MiotoCarRental.Models.Entities.VehicleStatus.Active)
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                        <i class="bi bi-check-circle-fill"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-100 text-red-800">
                                        <i class="bi bi-lock-fill"></i> Tạm khóa
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-6 text-right">
                                <form asp-action="ToggleVehicleStatus" method="post" class="inline">
                                    <input type="hidden" name="vehicleId" value="@v.Id" />
                                    @if (v.Status == MiotoCarRental.Models.Entities.VehicleStatus.Active)
                                    {
                                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 font-bold py-1.5 px-3 rounded-xl transition text-[11px] border border-red-200">
                                            <i class="bi bi-slash-circle"></i> Khóa xe
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold py-1.5 px-3 rounded-xl transition text-[11px] border border-emerald-200">
                                            <i class="bi bi-unlock"></i> Mở khóa
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 3: Giám sát toàn bộ Đơn đặt xe (Bookings) -->
    <div class="mt-10 bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-black text-gray-900 flex items-center gap-2">
                <i class="bi bi-journal-text text-blue-600"></i> Giám Sát Chuyến Thuê Xe Máy Điện (@Model.Bookings.Count đơn gần nhất)
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">Theo dõi dòng tiền cọc 30%, tiến độ nhận bàn giao ODO, pin LFP và trả xe trên toàn sàn</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 text-gray-400 font-bold uppercase border-b border-gray-100">
                    <tr>
                        <th class="py-3.5 px-6">Mã đơn</th>
                        <th class="py-3.5 px-4">Khách thuê</th>
                        <th class="py-3.5 px-4">Xe máy điện</th>
                        <th class="py-3.5 px-4">Thời gian thuê</th>
                        <th class="py-3.5 px-4">Tổng tiền (Cọc 30%)</th>
                        <th class="py-3.5 px-4">Trạng thái</th>
                        <th class="py-3.5 px-6 text-right">Chi tiết / Hủy</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    @foreach (var b in Model.Bookings)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="py-4 px-6 font-mono font-bold text-gray-900">#@b.BookingCode</td>
                            <td class="py-4 px-4 font-bold text-gray-700">@(b.Renter?.FullName ?? "N/A")</td>
                            <td class="py-4 px-4">
                                <span class="font-bold text-gray-900">@(b.Vehicle?.Model ?? "N/A")</span>
                                <span class="block text-[10px] text-gray-400 font-mono">@(b.Vehicle?.LicensePlate)</span>
                            </td>
                            <td class="py-4 px-4">
                                <div>@b.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="text-gray-400">@b.EndTime.ToString("dd/MM/yyyy HH:mm") (@b.TotalDays ngày)</div>
                            </td>
                            <td class="py-4 px-4">
                                <span class="font-bold text-gray-900">@b.TotalAmount.ToString("N0") đ</span>
                                <span class="block text-[10px] text-emerald-600 font-bold">Cọc: @b.DepositAmount.ToString("N0") đ</span>
                            </td>
                            <td class="py-4 px-4">
                                @switch (b.Status)
                                {
                                    case MiotoCarRental.Models.Entities.BookingStatus.Pending:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Chờ duyệt</span>
                                        break;
                                    case MiotoCarRental.Models.Entities.BookingStatus.AwaitingPayment:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">Chờ cọc 30%</span>
                                        break;
                                    case MiotoCarRental.Models.Entities.BookingStatus.Confirmed:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800">Đã cọc - Chờ nhận xe</span>
                                        break;
                                    case MiotoCarRental.Models.Entities.BookingStatus.InProgress:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Đang chạy</span>
                                        break;
                                    case MiotoCarRental.Models.Entities.BookingStatus.Completed:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-gray-100 text-gray-700">Đã hoàn thành</span>
                                        break;
                                    case MiotoCarRental.Models.Entities.BookingStatus.Cancelled:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-100 text-red-800">Đã hủy</span>
                                        break;
                                }
                            </td>
                            <td class="py-4 px-6 text-right space-x-2">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="text-emerald-600 hover:text-emerald-700 font-bold text-xs inline-flex items-center gap-1">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                @if (b.Status != MiotoCarRental.Models.Entities.BookingStatus.Completed && b.Status != MiotoCarRental.Models.Entities.BookingStatus.Cancelled)
                                {
                                    <form asp-action="CancelBooking" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn này và giải phóng lịch xe?');">
                                        <input type="hidden" name="bookingId" value="@b.Id" />
                                        <input type="hidden" name="reason" value="Quản trị viên hủy theo yêu cầu" />
                                        <button type="submit" class="text-red-500 hover:text-red-700 font-bold text-xs">
                                            Hủy
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 4: Quản Lý Người Dùng & Phân Quyền (RBAC Management) -->
    <div class="mt-10 bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-black text-gray-900 flex items-center gap-2">
                    <i class="bi bi-people-fill text-indigo-600"></i> Quản Lý Tài Khoản & Phân Quyền Vai Trò (@Model.AllUsers.Count tài khoản)
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">Phân quyền trực tiếp giữa Khách thuê (Renter), Chủ xe (Host) và Quản trị viên (Admin)</p>
            </div>
            <span class="text-xs font-bold px-3 py-1 bg-indigo-50 text-indigo-700 rounded-xl border border-indigo-200">
                <i class="bi bi-shield-lock"></i> RBAC Security Active
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 text-gray-400 font-bold uppercase border-b border-gray-100">
                    <tr>
                        <th class="py-3.5 px-6">ID & Người dùng</th>
                        <th class="py-3.5 px-4">Email</th>
                        <th class="py-3.5 px-4">Số điện thoại</th>
                        <th class="py-3.5 px-4">GPLX A1</th>
                        <th class="py-3.5 px-4">Vai trò hiện tại</th>
                        <th class="py-3.5 px-6 text-right">Điều chỉnh phân quyền</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                    @foreach (var u in Model.AllUsers)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <img src="@(u.AvatarUrl ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100")" 
                                     class="w-9 h-9 rounded-full object-cover border border-gray-200" />
                                <div>
                                    <span class="font-bold text-gray-900 block">@u.FullName</span>
                                    <span class="text-[10px] text-gray-400">ID: #@u.Id • Tham gia: @u.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </td>
                            <td class="py-4 px-4 font-mono text-gray-700">@u.Email</td>
                            <td class="py-4 px-4 font-mono text-gray-700">@u.Phone</td>
                            <td class="py-4 px-4">
                                @switch (u.DriverLicenseStatus)
                                {
                                    case MiotoCarRental.Models.Entities.DriverLicenseStatus.Approved:
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            <i class="bi bi-check-circle"></i> Đã duyệt
                                        </span>
                                        break;
                                    case MiotoCarRental.Models.Entities.DriverLicenseStatus.Pending:
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                            <i class="bi bi-clock"></i> Chờ duyệt
                                        </span>
                                        break;
                                    default:
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-600">
                                            Chưa nộp
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="py-4 px-4">
                                @switch (u.Role)
                                {
                                    case MiotoCarRental.Models.Entities.UserRole.Admin:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200 flex items-center gap-1 w-max">
                                            <i class="bi bi-shield-lock-fill"></i> Quản trị viên
                                        </span>
                                        break;
                                    case MiotoCarRental.Models.Entities.UserRole.Host:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200 flex items-center gap-1 w-max">
                                            <i class="bi bi-car-front-fill"></i> Đối tác chủ xe
                                        </span>
                                        break;
                                    case MiotoCarRental.Models.Entities.UserRole.Renter:
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1 w-max">
                                            <i class="bi bi-person-fill"></i> Khách thuê
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="py-4 px-6 text-right">
                                <form asp-action="UpdateUserRole" method="post" class="inline-flex items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <select name="newRole" class="text-xs bg-gray-50 border border-gray-300 rounded-xl px-2 py-1.5 font-semibold text-gray-700 focus:outline-none focus:ring-1 focus:ring-indigo-500">
                                        <!option value="Renter" @(u.Role == MiotoCarRental.Models.Entities.UserRole.Renter ? "selected" : "")>Renter</!option>
                                        <!option value="Host" @(u.Role == MiotoCarRental.Models.Entities.UserRole.Host ? "selected" : "")>Host</!option>
                                        <!option value="Admin" @(u.Role == MiotoCarRental.Models.Entities.UserRole.Admin ? "selected" : "")>Admin</!option>
                                    </select>
                                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-1.5 px-3 rounded-xl transition shadow-sm">
                                        Lưu
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
